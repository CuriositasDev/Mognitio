namespace Mgnc\WholeRoots;
use Std\Numeric\{Bits};
use Mgnc\Data\{Paged,Span,Diagnostic,empty,push,lookup};
use Mgnc\Syntax\{Parent};
use Mgnc\TypeData\{Store};
use Mgnc\WholeIR\{Body,Slot,Block,Operation};
use Mgnc\WholeConcrete\{Plan,Instance};
use Mgnc\WholeEffects\{allocating};
use Mgnc\WholeLayout\{managed};
use Mgnc\WholeChecks\{require};
use Mgnc\Facts\{words,combine,fromSlots};
use Mgnc\WholeFrameData\{Point,Frame};
use Mgnc\WholeRootFlow\{Flow,Instruction,incoming,outgoing,transfer,solveProjected};
use Mgnc\WholeRootProjection\{Projection,project,expand};
use Mgnc\Tables\{atList};
public let frame:Function(Store,Body):Result<Frame,Diagnostic>=function(store:Store,body:Body):Result<Frame,Diagnostic>{
 let span:Span=(try lookup<Block>(body->blocks,body->entry))->terminator->origin->span;try require(body->slots->count>=0&&body->slots->count<=268435440,span,"frame slot range");let projection:Projection=try project(store,body);let blank:List<Bits<64>>=words(projection->references->length(),false);
 var maximum:Int=8;
 loop over(body->blocks->pages->append(body->blocks->tail) as page:List<Block>){loop over(page as block:Block){loop over(block->operations as op:Operation){branch when{op->inputs->length()+4>maximum=>{maximum=op->inputs->length()+4;},else=>unit};};};};
 let flow:Flow=try solveProjected(body,projection->operations,projection->terms,blank,span);
 var points:Paged<Point>=empty<Point>();var id:Int=0;
 loop over(body->blocks->pages->append(body->blocks->tail) as page:List<Block>){loop over(page as block:Block){let table:Paged<Instruction>=try lookup<Paged<Instruction>>(projection->operations,id);var live:List<Bits<64>>=try outgoing(flow,try lookup<List<Int>>(projection->terms,id),block->terminator->targets,blank,span);var position:Int=table->count;
  loop while(position>0){position=position-1;let op:Operation=try atList<Operation>(block->operations,position);let instruction:Instruction=try lookup<Instruction>(table,position);var handoff:List<Bits<64>>=List<Bits<64>>[];
   branch when{op->code=="call"||op->code=="field-call"=>{handoff=try expand(projection->references,try transfer(live,Instruction{output:instruction->output,inputs:List<Int>[],span:instruction->span}),body->slots->count,span);},else=>unit};
   live=try transfer(live,instruction);branch when{try allocating(store,body,op)=>{points=push<Point>(points,Point{block:id,operation:position,roots:try expand(projection->references,live,body->slots->count,span),handoff:handoff});},else=>unit};};id=id+1;
 };};
 try require(maximum<=268435440-body->slots->count,span,"frame encoding range");Result<Frame,Diagnostic>::Ok(Frame{slots:body->slots->count,outgoing:maximum,extent:((64+body->slots->count*8+maximum*8+15)/16)*16,entry:try expand(projection->references,try incoming(flow,body->entry,blank),body->slots->count,span),points:points})
};
public let build:Function(Plan):Result<Paged<Frame>,Diagnostic>=function(plan:Plan):Result<Paged<Frame>,Diagnostic>{var frames:Paged<Frame>=empty<Frame>();loop over(plan->instances->pages->append(plan->instances->tail) as page:List<Instance>){loop over(page as item:Instance){frames=push<Frame>(frames,try frame(plan->types,item->body));};};Result<Paged<Frame>,Diagnostic>::Ok(frames)};
