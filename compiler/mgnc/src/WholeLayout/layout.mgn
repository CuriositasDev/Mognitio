namespace Mgnc\WholeLayout;
use Mgnc\RepresentationInfo\{describe};
use Mgnc\Data\{Paged,Diagnostic,Span,empty,push,lookup};
use Mgnc\Syntax\{Parent};
use Mgnc\TypeData\{Store,Type,Argument,Member,ValueTerm};
use Mgnc\TypeOps\{parentEqual};
use Mgnc\WholeIR\{Slot,Block,Operation};
use Mgnc\WholeConcrete\{Plan,Instance};
use Mgnc\WholeClosures\{Closures,Field};
use Mgnc\WholeChecks\{require,present};
use Mgnc\Tables\{atList};
use Mgnc\WholeStableKeys\{Entry,shape as stableShape,vector,sort as stableSort};
use Mgnc\IntMap\{Map,create,get,put};
// Offsets are bytes from the object base. Modes: fixed, variant, buffer, Bytes leaf.
public type Descriptor=product{mode:Int;size:Int;references:List<Int>;variants:List<List<Int>>;elementManaged:Bool;};
public type Layouts=product{descriptors:Paged<Descriptor>;types:Map;environments:Paged<Int>;buffers:Map;};
public let managed:Function(Store,Int):Result<Bool,Diagnostic>=function(store:Store,id:Int):Result<Bool,Diagnostic>{Result<Bool,Diagnostic>::Ok((try describe(store,id))->reference)};
public let argumentType:Function(Type,Int,Span):Result<Int,Diagnostic>=function(shape:Type,index:Int,span:Span):Result<Int,Diagnostic>{
 branch on try atList<Argument>(shape->arguments,index){Argument::Type(value:Int)=>Result<Int,Diagnostic>::Ok(value),Argument::Value(term:ValueTerm)=>{try require(false,span,"layout type argument");Result<Int,Diagnostic>::Ok(0)}}
};
public let fixed:Function(Int,List<Int>):Descriptor=function(bytes:Int,references:List<Int>):Descriptor{Descriptor{mode:0,size:branch when{bytes<32=>32,else=>bytes},references:references,variants:List<List<Int>>[],elementManaged:false}};
public let build:Function(Plan,Closures):Result<Layouts,Diagnostic>=function(plan:Plan,closures:Closures):Result<Layouts,Diagnostic>{
 let span:Span=Span{start:0,end:0,line:1,column:1};var pending:Paged<Int>=empty<Int>();var seen:Map=create();
 loop over(plan->instances->pages->append(plan->instances->tail) as page:List<Instance>){loop over(page as item:Instance){pending=push<Int>(pending,item->body->resultType);
  loop over(item->body->slots->pages->append(item->body->slots->tail) as slots:List<Slot>){loop over(slots as slot:Slot){pending=push<Int>(pending,slot->valueType);};};
  loop over(item->body->blocks->pages->append(item->body->blocks->tail) as blocks:List<Block>){loop over(blocks as block:Block){loop over(block->operations as op:Operation){loop over(op->arguments as arg:Argument){branch on arg{Argument::Type(id:Int)=>{pending=push<Int>(pending,id);},Argument::Value(term:ValueTerm)=>unit};};};};};
 };};
 var cursor:Int=0;loop while(cursor<pending->count){let id:Int=try lookup<Int>(pending,cursor);cursor=cursor+1;branch when{(try get(seen,id))>=0=>{continue;},else=>unit};seen=try put(seen,id,1);let shape:Type=try lookup<Type>(plan->types->types,id);try require(shape->kind<22||shape->kind==23||shape->kind==24||shape->kind==25||shape->kind==27||shape->kind==28,span,"layout symbolic or unsupported type");
  loop over(shape->arguments as argument:Argument){branch on argument{Argument::Type(child:Int)=>{pending=push<Int>(pending,child);},Argument::Value(term:ValueTerm)=>{try require(parentEqual(term->parameter,Parent::None),span,"layout symbolic value");}};};
  loop over(shape->members as member:Member){branch on member->value{Parent::Some(child:Int)=>{pending=push<Int>(pending,child);},Parent::None=>unit};};
 };
 // Descriptor order follows structural type identity, independent of interning order.
 var entries:Paged<Entry>=empty<Entry>();var typeCursor:Int=0;
 loop while(typeCursor<plan->types->types->count){
  branch when{(try get(seen,typeCursor))>=0&&(try managed(plan->types,typeCursor))=>{entries=push<Entry>(entries,Entry{id:typeCursor,tokens:vector(try stableShape(plan->types,typeCursor))});},else=>unit};typeCursor=typeCursor+1;
 };entries=try stableSort(entries);
 var descriptors:Paged<Descriptor>=empty<Descriptor>();var types:Map=create();var buffers:Map=create();
 loop over(entries->pages->append(entries->tail) as entriesPage:List<Entry>){loop over(entriesPage as entry:Entry){let id:Int=entry->id;
  let shape:Type=try lookup<Type>(plan->types->types,id);var descriptor:Descriptor=fixed(32,List<Int>[]);
  branch when{shape->kind==25=>{descriptor=Descriptor{mode:3,size:0,references:List<Int>[],variants:List<List<Int>>[],elementManaged:false};},shape->kind==3=>{descriptor=Descriptor{mode:0,size:0,references:List<Int>[],variants:List<List<Int>>[],elementManaged:false};},
   shape->kind==10=>{var references:List<Int>=List<Int>[32];branch when{try managed(plan->types,try argumentType(shape,0,span))=>{references=references->append(40);},else=>unit};descriptor=fixed(48,references);},
   shape->kind==12=>{descriptor=fixed(40,List<Int>[32]);},
   shape->kind==11||shape->kind==21=>{
    var variants:List<List<Int>>=List<List<Int>>[];
    branch when{shape->kind==11=>{var ordinal:Int=0;loop while(ordinal<2){variants=variants->append(branch when{try managed(plan->types,try argumentType(shape,ordinal,span))=>List<Int>[32],else=>List<Int>[]});ordinal=ordinal+1;};},else=>{
     loop over(shape->members as member:Member){variants=variants->append(branch on member->value{Parent::None=>List<Int>[],Parent::Some(typeId:Int)=>branch when{try managed(plan->types,typeId)=>List<Int>[32],else=>List<Int>[]}});};
    }};descriptor=Descriptor{mode:1,size:40,references:List<Int>[],variants:variants,elementManaged:false};
   },shape->kind==4||shape->kind==5||shape->kind==20||shape->kind==27||shape->kind==28=>{
    var references:List<Int>=List<Int>[];var ordinal:Int=0;loop over(shape->members as member:Member){let typeId:Int=try present(member->value,span,"product field type");branch when{try managed(plan->types,typeId)=>{references=references->append(24+ordinal*8);},else=>unit};ordinal=ordinal+1;};descriptor=fixed(24+ordinal*8,references);
   },else=>{try require(false,span,"unknown native layout kind");}};
  types=try put(types,id,descriptors->count);descriptors=push<Descriptor>(descriptors,descriptor);
 };};
 var environments:Paged<Int>=empty<Int>();loop over(closures->frames->pages->append(closures->frames->tail) as page:List<List<Field>>){loop over(page as fields:List<Field>){var references:List<Int>=List<Int>[];var ordinal:Int=0;
  loop over(fields as field:Field){branch when{try managed(plan->types,field->valueType)=>{references=references->append(24+ordinal*8);},else=>unit};ordinal=ordinal+1;};environments=push<Int>(environments,descriptors->count);descriptors=push<Descriptor>(descriptors,fixed(24+ordinal*8,references));
 };};
 loop over(entries->pages->append(entries->tail) as entriesPage:List<Entry>){loop over(entriesPage as entry:Entry){let id:Int=entry->id;let shape:Type=try lookup<Type>(plan->types->types,id);branch when{shape->kind==10=>{buffers=try put(buffers,id,descriptors->count);descriptors=push<Descriptor>(descriptors,Descriptor{mode:2,size:0,references:List<Int>[],variants:List<List<Int>>[],elementManaged:try managed(plan->types,try argumentType(shape,0,span))});},else=>unit};};};
 Result<Layouts,Diagnostic>::Ok(Layouts{descriptors:descriptors,types:types,environments:environments,buffers:buffers})
};
