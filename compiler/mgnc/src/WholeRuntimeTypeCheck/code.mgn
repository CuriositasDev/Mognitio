namespace Mgnc\WholeRuntimeTypeCheck;
use Mgnc\Data\{Paged,Diagnostic,Span,empty,push,lookup};
use Mgnc\Syntax\{Parent};
use Mgnc\TypeData\{Type,Argument,Member,ValueTerm};
use Mgnc\WholeConcrete\{Plan,Instance};
use Mgnc\WholeIR\{Slot,Block,Operation};
use Mgnc\WholeRuntimeTypes\{Info};
use Mgnc\WholeStableKeys\{Entry,vector,shape,compare,sort};
use Mgnc\WholeChecks\{require};
use Mgnc\IntMap\{Map,create,get,put};
// This walk starts from typed bodies independently of the emitter's closure builder.
public let verify:Function(Plan,Info):Result<Unit,Diagnostic>=function(plan:Plan,info:Info):Result<Unit,Diagnostic>{let span:Span=Span{start:0,end:0,line:1,column:1};try require(info->values->count==plan->types->types->count,span,"RuntimeTypeId compiler domain extent");var needed:Map=create();var pending:Paged<Int>=empty<Int>();loop over(plan->instances->pages->append(plan->instances->tail) as page:List<Instance>){loop over(page as instance:Instance){loop over(instance->body->blocks->pages->append(instance->body->blocks->tail) as blocks:List<Block>){loop over(blocks as block:Block){loop over(block->operations as op:Operation){loop over(op->arguments as argument:Argument){branch on argument{Argument::Type(id:Int)=>{pending=push<Int>(pending,id);},Argument::Value(term:ValueTerm)=>unit};};};};};loop over(instance->body->slots->pages->append(instance->body->slots->tail) as slots:List<Slot>){loop over(slots as slot:Slot){pending=push<Int>(pending,slot->valueType);};};pending=push<Int>(pending,instance->body->resultType);};};var cursor:Int=0;loop while(cursor<pending->count){let id:Int=try lookup<Int>(pending,cursor);cursor=cursor+1;branch when{(try get(needed,id))>=0=>{continue;},else=>unit};needed=try put(needed,id,1);let value:Type=try lookup<Type>(plan->types->types,id);try require(value->kind==0||value->kind==1||value->kind==2||value->kind==3||value->kind==4||value->kind==5||value->kind==10||value->kind==11||value->kind==12||value->kind==20||value->kind==21||value->kind==23||value->kind==24||value->kind==25||value->kind==26||value->kind==27||value->kind==28||value->kind==29,span,"RuntimeTypeId completed family");loop over(value->members as member:Member){branch on member->value{Parent::None=>unit,Parent::Some(child:Int)=>{pending=push<Int>(pending,child);}};};loop over(value->arguments as argument:Argument){branch on argument{Argument::Type(child:Int)=>{pending=push<Int>(pending,child);},Argument::Value(term:ValueTerm)=>{branch on term->parameter{Parent::None=>unit,Parent::Some(ordinal:Int)=>{try require(false,span,"RuntimeTypeId symbolic value");}};}};};};
 var identityOrdinal:Int=0;var previousIdentity:Paged<Int>=empty<Int>();loop while(identityOrdinal<info->types->count){let representative:Int=try lookup<Int>(info->types,identityOrdinal);let identityKey:Paged<Int>=vector(try shape(plan->types,representative));branch when{identityOrdinal>0=>{try require((try compare(previousIdentity,identityKey))<0,span,"RuntimeTypeId strictly increasing identity order");},else=>unit};previousIdentity=identityKey;identityOrdinal=identityOrdinal+1;};
 var entries:Paged<Entry>=empty<Entry>();var typeId:Int=0;loop while(typeId<plan->types->types->count){let actual:Int=try lookup<Int>(info->values,typeId);branch when{(try get(needed,typeId))<0=>{try require(actual== -1,span,"RuntimeTypeId non-emission type");},else=>{try require(actual>=0&&actual<info->types->count,span,"RuntimeTypeId dense membership");entries=push<Entry>(entries,Entry{id:typeId,tokens:vector(try shape(plan->types,typeId))});}};typeId=typeId+1;};entries=try sort(entries);var ordinal:Int= -1;var previous:Paged<Int>=empty<Int>();loop over(entries->pages->append(entries->tail) as page:List<Entry>){loop over(page as entry:Entry){branch when{ordinal<0||(try compare(previous,entry->tokens))!=0=>{ordinal=ordinal+1;previous=entry->tokens;let representative:Int=try lookup<Int>(info->types,ordinal);try require(representative>=0&&representative<plan->types->types->count&&(try get(needed,representative))>=0,span,"RuntimeTypeId representative domain");try require((try compare(vector(try shape(plan->types,representative)),entry->tokens))==0,span,"RuntimeTypeId canonical identity order");},else=>unit};try require((try lookup<Int>(info->values,entry->id))==ordinal,span,"RuntimeTypeId canonical assignment");};};try require(info->types->count==ordinal+1,span,"RuntimeTypeId exact identity closure");Result<Unit,Diagnostic>::Ok(unit)};
