let main:Function(List<String>):Int=function(args:List<String>):Int{let mode:String=branch on args->at(0){Result<String,IndexError>::Ok(value:String)=>value,Result<String,IndexError>::Err(error:IndexError)=>{return 2;}};var values:List<Int>=List<Int>[];var fill:Int=0;loop while(fill<65537){values=values->append(fill);fill=fill+1;};var pass:Int=0;loop while(pass<128){let first:List<Int>=branch when{mode=="old"=>oldRange(values,0,2),else=>range(values,0,2)};let last:List<Int>=branch when{mode=="old"=>oldRange(values,65530,65537),else=>range(values,65530,65537)};assert first->length()==2;assert last->length()==7;var ordinal:Int=0;loop over(first as value:Int){assert value==ordinal;ordinal=ordinal+1;};ordinal=65530;loop over(last as value:Int){assert value==ordinal;ordinal=ordinal+1;};pass=pass+1;};0};
