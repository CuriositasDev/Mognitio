namespace Mgnc\DeclarationKinds;
public let runtimeDeclaration:Function(Int):Bool=function(kind:Int):Bool{kind==4||kind==5};
public let typeDeclaration:Function(Int):Bool=function(kind:Int):Bool{kind<3||kind==6};
public let compileDeclaration:Function(Int):Bool=function(kind:Int):Bool{kind<4||kind==6||kind==7};
