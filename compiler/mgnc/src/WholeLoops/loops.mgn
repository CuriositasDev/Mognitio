namespace Mgnc\WholeLoops;
use Mgnc\Data\{Diagnostic,push,lookup,problem};
use Mgnc\Syntax\{Parent};
use Mgnc\SemanticValues\{Node,Symbol};
use Mgnc\TypeData\{Structure};
use Mgnc\VariantSupport\{memberType};
use Mgnc\WholeIR\{Slot,Operation,Origin,Terminator};
use Mgnc\WholeBuilder\{Builder,Plan,plan,output,term,operation,setBlock,reserveBlock,continueAt,withContinues,withSlots};
use Mgnc\WholeFlow\{child,jump,failure,finish};
use Mgnc\IntMap\{get,put};
public let lower:Function(Builder,Plan,Node,Origin):Result<Builder,Diagnostic>=function(initial:Builder,current:Plan,node:Node,site:Origin):Result<Builder,Diagnostic>{
 var builder:Builder=initial;
 let loopId:Int=branch on node->target{Parent::Some(value:Int)=>value,Parent::None=>{return Result<Builder,Diagnostic>::Err(problem("internal",node->span,"whole lowering: loop target"));}};
 let body:Plan=try child(builder,node,branch when{node->operation=="loop"=>0,else=>1});
 branch when{node->operation=="loop"=>{
  builder=withContinues(builder,try put(builder->continues,loopId,body->entry));
  builder=try setBlock(builder,current->entry,List<Operation>[],jump(body->entry,site));builder=try continueAt(builder,body->node,body->entry);
  return finish(builder,current,node,List<Operation>[],site);
 },else=>unit};
 let target:Plan=try child(builder,node,0);let decision:Int=builder->blockCount;builder=reserveBlock(builder,site);
 builder=try setBlock(builder,current->entry,List<Operation>[],jump(target->entry,site));
 branch when{node->operation=="while"=>{
  builder=withContinues(builder,try put(builder->continues,loopId,target->entry));
  builder=try continueAt(builder,target->node,decision);builder=try continueAt(builder,body->node,target->entry);
  builder=try setBlock(builder,decision,List<Operation>[],branch on target->output{Parent::Some(slot:Int)=>term("branch",List<Int>[slot],List<Int>[body->entry,current->exit],site),Parent::None=>failure(site)});
 },else=>{
  let targetNode:Node=try lookup<Node>(builder->context->state->nodes,target->node);
  let listType:Int=try memberType(node->arguments,0,node->span);
  let iterator:Int=builder->slots->count;builder=withSlots(builder,push<Slot>(builder->slots,Slot{valueType:listType,kind:4,symbol:Parent::None}));
  let more:Int=builder->slots->count;builder=withSlots(builder,push<Slot>(builder->slots,Slot{valueType:2,kind:0,symbol:Parent::None}));
  let prepare:Int=builder->blockCount;builder=reserveBlock(builder,site);let next:Int=builder->blockCount;builder=reserveBlock(builder,site);
  builder=withContinues(builder,try put(builder->continues,loopId,decision));builder=try continueAt(builder,target->node,prepare);builder=try continueAt(builder,body->node,decision);
  let base:Operation=operation("iterator-init",Parent::Some(iterator),List<Int>[],site);
  let inputs:List<Int>=branch on target->output{Parent::Some(slot:Int)=>List<Int>[slot],Parent::None=>List<Int>[]};
  let unavailable:List<Int>=branch on target->output{Parent::Some(slot:Int)=>List<Int>[],Parent::None=>List<Int>[0]};
  let setup:Operation=Operation{code:base->code,output:base->output,inputs:inputs,unavailable:unavailable,symbol:base->symbol,target:Parent::Some(listType),arguments:base->arguments,mapping:base->mapping,integer:base->integer,minimum:base->minimum,wide:base->wide,text:base->text,origin:site};
  builder=try setBlock(builder,prepare,List<Operation>[setup],jump(decision,site));
  builder=try setBlock(builder,decision,List<Operation>[operation("iterator-more",Parent::Some(more),List<Int>[iterator],site)],term("branch",List<Int>[more],List<Int>[next,current->exit],site));
  let binder:Int=branch on node->binder{Parent::Some(value:Int)=>value,Parent::None=>{return Result<Builder,Diagnostic>::Err(problem("internal",node->span,"whole lowering: over binder"));}};
  builder=try setBlock(builder,next,List<Operation>[operation("iterator-next",Parent::Some(try get(builder->symbols,binder)),List<Int>[iterator],site)],jump(body->entry,site));
 }};
 let operations:List<Operation>=branch when{node->normal=>List<Operation>[operation("unit",current->output,List<Int>[],site)],else=>List<Operation>[]};
 finish(builder,current,node,operations,site)
};
