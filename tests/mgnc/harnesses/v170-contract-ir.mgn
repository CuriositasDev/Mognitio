let descriptor:Function(Descriptor,Int,List<Int>):Descriptor=function(original:Descriptor,size:Int,references:List<Int>):Descriptor{Descriptor{mode:original->mode,size:size,references:references,variants:original->variants,elementManaged:original->elementManaged}};
type Mutation=product{offset:Int;kind:Int;mode:Int;change:Int;name:String;};type Coverage=product{count:Int;names:List<String>;};
let changedCode:Function(Code,Int,Record):Result<Code,Diagnostic>=function(code:Code,index:Int,record:Record):Result<Code,Diagnostic>{Result<Code,Diagnostic>::Ok(Code{records:try replaceItem<Record>(code->records,index,record),nextLabel:code->nextLabel,pending:code->pending})};
let mutationRegion:Function(Native,Code,Map,Int,Int,List<Mutation>):Result<Coverage,Diagnostic>=function(plan:Native,code:Code,labels:Map,start:Int,end:Int,specs:List<Mutation>):Result<Coverage,Diagnostic>{let span:Span=Span{start:0,end:0,line:1,column:1};var cursor:Int=(try get(labels,start))+1;let limit:Int=try get(labels,end);try require(cursor>0&&limit>=cursor,span,"contract mutation region bounds");var offset:Int=0;var count:Int=0;var names:List<String>=List<String>[];loop while(cursor<limit){let record:Record=try lookup<Record>(code->records,cursor);let operand:Int=offset+record->bytes->length();loop over(specs as spec:Mutation){branch when{operand==spec->offset&&record->kind==spec->kind=>{let replacement:Record=Record{kind:record->kind,bytes:record->bytes,value:branch when{spec->mode==0=>record->value+spec->change,spec->mode==2=>spec->change,else=>record->value},target:branch when{spec->mode==1=>spec->change,else=>record->target}};try require(replacement->value!=record->value||replacement->target!=record->target,span,"nontrivial contract code mutation");try reject(machineCheck(plan,try changedCode(code,cursor,replacement)),spec->name);count=count+1;names=names->append(spec->name);},else=>unit};};offset=operand+branch when{record->kind==2||record->kind==3=>4,record->kind==4||record->kind==5=>8,else=>0};cursor=cursor+1;};try require(count==specs->length(),span,"missing contract machine mutation operand");Result<Coverage,Diagnostic>::Ok(Coverage{count:count,names:names})};
