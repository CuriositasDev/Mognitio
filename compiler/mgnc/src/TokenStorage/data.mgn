lane==6=>Lexeme{kind:page->kind6,text:page->text6,start:page->start6,end:page->end6,line:page->line6,column:page->column6,scalarStart:page->scalarStart6,scalarEnd:page->scalarEnd6,endLine:page->endLine6,endColumn:page->endColumn6},
lane==7=>Lexeme{kind:page->kind7,text:page->text7,start:page->start7,end:page->end7,line:page->line7,column:page->column7,scalarStart:page->scalarStart7,scalarEnd:page->scalarEnd7,endLine:page->endLine7,endColumn:page->endColumn7},
lane==8=>Lexeme{kind:page->kind8,text:page->text8,start:page->start8,end:page->end8,line:page->line8,column:page->column8,scalarStart:page->scalarStart8,scalarEnd:page->scalarEnd8,endLine:page->endLine8,endColumn:page->endColumn8},
