namespace Mgnc\WholePubPrograms;
use Mgnc\Data\{Diagnostic};
use Mgnc\WholeChecks\{require};
use Mgnc\WholePubStep\{emit as emitRows};
use Mgnc\Machine\{Code,fresh};
use Mgnc\PubData\Profile0\{rows as rowsProfile0};
use Mgnc\PubData\Profile1\{rows as rowsProfile1};
use Mgnc\PubData\Profile2\{rows as rowsProfile2};
use Mgnc\PubData\Profile3\{rows as rowsProfile3};
use Mgnc\PubData\Profile4\{rows as rowsProfile4};
use Mgnc\PubData\Profile5\{rows as rowsProfile5};
use Mgnc\PubData\Profile6\{rows as rowsProfile6};
use Mgnc\PubData\Profile7\{rows as rowsProfile7};
use Mgnc\PubData\Profile8\{rows as rowsProfile8};
use Mgnc\PubData\Profile9\{rows as rowsProfile9};
use Mgnc\PubData\Profile10\{rows as rowsProfile10};
use Mgnc\PubData\Profile11\{rows as rowsProfile11};
use Mgnc\PubData\Cleanup0\{rows as rowsCleanup0};
use Mgnc\PubData\Cleanup1\{rows as rowsCleanup1};
use Mgnc\PubData\Cleanup2\{rows as rowsCleanup2};
use Mgnc\PubData\Cleanup3\{rows as rowsCleanup3};
use Mgnc\PubData\Cleanup4\{rows as rowsCleanup4};
use Mgnc\PubData\Cleanup5\{rows as rowsCleanup5};
use Mgnc\PubData\Cleanup6\{rows as rowsCleanup6};
use Mgnc\PubData\Errno0\{rows as rowsErrno0};
use Mgnc\PubData\Errno1\{rows as rowsErrno1};
use Mgnc\PubData\Publish0\{rows as rowsPublish0};
use Mgnc\PubData\Publish1\{rows as rowsPublish1};
use Mgnc\PubData\Publish2\{rows as rowsPublish2};
use Mgnc\PubData\Publish3\{rows as rowsPublish3};
use Mgnc\PubData\Publish4\{rows as rowsPublish4};
use Mgnc\PubData\Publish5\{rows as rowsPublish5};
use Mgnc\PubData\Publish6\{rows as rowsPublish6};
use Mgnc\PubData\Publish7\{rows as rowsPublish7};
use Mgnc\PubData\Publish8\{rows as rowsPublish8};
use Mgnc\PubData\Publish9\{rows as rowsPublish9};
use Mgnc\PubData\Publish10\{rows as rowsPublish10};
use Mgnc\PubData\Publish11\{rows as rowsPublish11};
use Mgnc\PubData\Publish12\{rows as rowsPublish12};
use Mgnc\PubData\Publish13\{rows as rowsPublish13};
use Mgnc\PubData\Publish14\{rows as rowsPublish14};
use Mgnc\PubData\Publish15\{rows as rowsPublish15};
use Mgnc\PubData\Publish16\{rows as rowsPublish16};

public let emit:Function(Code,Int,List<Int>):Result<Code,Diagnostic>=function(initial:Code,owner:Int,descriptors:List<Int>):Result<Code,Diagnostic>{
 var code:Code=initial;let base:Int=code->nextLabel;
 branch when{owner==75=>{code=fresh(code,83);
  code=try emitRows(code,rowsPublish0(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish1(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish2(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish3(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish4(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish5(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish6(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish7(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish8(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish9(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish10(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish11(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish12(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish13(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish14(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish15(),base,owner,descriptors,0);
  code=try emitRows(code,rowsPublish16(),base,owner,descriptors,0);
 },else=>unit};
 branch when{owner==80=>{code=fresh(code,33);
  code=try emitRows(code,rowsCleanup0(),base,owner,descriptors,512);
  code=try emitRows(code,rowsCleanup1(),base,owner,descriptors,512);
  code=try emitRows(code,rowsCleanup2(),base,owner,descriptors,512);
  code=try emitRows(code,rowsCleanup3(),base,owner,descriptors,512);
  code=try emitRows(code,rowsCleanup4(),base,owner,descriptors,512);
  code=try emitRows(code,rowsCleanup5(),base,owner,descriptors,512);
  code=try emitRows(code,rowsCleanup6(),base,owner,descriptors,512);
 },else=>unit};
 branch when{owner==81=>{code=fresh(code,29);
  code=try emitRows(code,rowsProfile0(),base,owner,descriptors,5120);
  code=try emitRows(code,rowsProfile1(),base,owner,descriptors,5120);
  code=try emitRows(code,rowsProfile2(),base,owner,descriptors,5120);
  code=try emitRows(code,rowsProfile3(),base,owner,descriptors,5120);
  code=try emitRows(code,rowsProfile4(),base,owner,descriptors,5120);
  code=try emitRows(code,rowsProfile5(),base,owner,descriptors,5120);
  code=try emitRows(code,rowsProfile6(),base,owner,descriptors,5120);
  code=try emitRows(code,rowsProfile7(),base,owner,descriptors,5120);
  code=try emitRows(code,rowsProfile8(),base,owner,descriptors,5120);
  code=try emitRows(code,rowsProfile9(),base,owner,descriptors,5120);
  code=try emitRows(code,rowsProfile10(),base,owner,descriptors,5120);
  code=try emitRows(code,rowsProfile11(),base,owner,descriptors,5120);
 },else=>unit};
 branch when{owner==82=>{code=fresh(code,5);
  code=try emitRows(code,rowsErrno0(),base,owner,descriptors,0);
  code=try emitRows(code,rowsErrno1(),base,owner,descriptors,0);
 },else=>unit};
 Result<Code,Diagnostic>::Ok(code)
};
