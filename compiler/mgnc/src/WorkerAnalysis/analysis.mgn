namespace Mgnc\WorkerAnalysis;
use Mgnc\Data\{Diagnostic,Related,Paged,Span,number};
use Mgnc\InputData\{ProjectInput,SourceUnit,InputError};
use Mgnc\Semantic\{checkProfile};
use Mgnc\SemanticValues\{State};
use Mgnc\AnalysisTokens\{Row,rows,forFile};
use Mgnc\Source\{Snapshot,Lexeme,Site};
use Mgnc\Lexical\{scan,Scan};
use Mgnc\AnalysisDepth\{bounded};
use Mgnc\Structural\{parseDocument};
use Mgnc\Forest\{SyntaxForest};
use Mgnc\IntMap\{create};
use Mgnc\WorkerWire\{send,header,record,rejected};
use Mgnc\TextUtil\{at,cut};
use Mgnc\TokenStorage\{TokenStore,getToken,addToken,emptyTokens};
let parse:Function(Snapshot):Result<SyntaxForest,Diagnostic>=function(source:Snapshot):Result<SyntaxForest,Diagnostic>{bounded(try parseDocument(source))};
let tokens:Function(String,Paged<Row>):Bool=function(path:String,result:Paged<Row>):Bool{
 loop over(result->pages->append(result->tail) as page:List<Row>){loop over(page as row:Row){
  branch when{!record(List<String>["T",path,number(row->start),number(row->end),number(row->role),number(row->modifiers)])=>{return false;},else=>unit};
 };};true
};
let errorRow:Function(String,Diagnostic,Bool):Bool=function(path:String,error:Diagnostic,known:Bool):Bool{
 let span:Span=error->span;
 branch when{!record(List<String>["D",path,error->phase,error->message,branch when{known=>"1",else=>"0"},number(span->start),number(span->end)])=>{return false;},else=>unit};
 loop over(error->related as note:Related){
  branch when{!record(List<String>["N",branch when{note->path==""=>path,else=>note->path},note->message,number(note->span->start),number(note->span->end)])=>{return false;},else=>unit};
 };true
};
let lexical:Function(String,Snapshot):Bool=function(path:String,source:Snapshot):Bool{
 branch on rows(source,create(),false){Result<Paged<Row>,Diagnostic>::Ok(value:Paged<Row>)=>tokens(path,value),Result<Paged<Row>,Diagnostic>::Err(error:Diagnostic)=>false}
};
// Resume at the next top-level declaration after a parse error. Reuse the
// original tokens, including byte ranges, and the same document grammar.
let recoverDeclarations:Function(String,Snapshot,Int):Bool=function(path:String,source:Snapshot,after:Int):Bool{
 var part:TokenStore=emptyTokens();var depth:Int=0;var skip:Bool=true;var emitted:Int=0;var i:Int=0;
 loop while(i<source->tokens->count){
  let token:Lexeme=branch on getToken(source->tokens,i){Result<Lexeme,Diagnostic>::Ok(value:Lexeme)=>value,Result<Lexeme,Diagnostic>::Err(error:Diagnostic)=>{return false;}};
  i=i+1;let text:String=token->text;
  branch when{part->count==0=>{skip=token->start<=after||text=="namespace"||text=="use";},else=>unit};
  branch when{text=="{"||text=="("||text=="["=>{depth=depth+1;},(text=="}"||text==")"||text=="]")&&depth>0=>{depth=depth-1;},else=>unit};
  branch when{token->kind!=0=>{part=addToken(part,token);},else=>unit};
  branch when{token->kind==0||text==";"&&depth==0=>{
   branch when{!skip&&part->count>0=>{
    let span:Span=Span{start:token->end,end:token->end,line:token->endLine,column:token->endColumn};
    let end:Site=Site{span:span,scalarStart:token->scalarEnd,scalarEnd:token->scalarEnd,endLine:token->endLine,endColumn:token->endColumn};
    let eof:Lexeme=Lexeme{kind:0,text:"",start:span->start,end:span->end,line:span->line,column:span->column,scalarStart:end->scalarStart,scalarEnd:end->scalarEnd,endLine:end->endLine,endColumn:end->endColumn};
    branch on parse(Snapshot{text:source->text,tokens:addToken(part,eof),end:end}){
     Result<SyntaxForest,Diagnostic>::Ok(tree:SyntaxForest)=>unit,
     Result<SyntaxForest,Diagnostic>::Err(error:Diagnostic)=>{
      branch when{error->phase=="internal"||!errorRow(path,error,true)=>{return false;},else=>unit};emitted=emitted+1;
     }
    };
   },else=>unit};part=emptyTokens();
   branch when{emitted>=200=>{break;},else=>unit};
  },else=>unit};
 };true
};
let syntax:Function(SourceUnit):Bool=function(source:SourceUnit):Bool{
 let path:String=source->displayPath;
 let scanned:Scan=branch on scan(source->text,true){Result<Scan,Diagnostic>::Ok(value:Scan)=>value,Result<Scan,Diagnostic>::Err(error:Diagnostic)=>{return false;}};
 loop over(scanned->issues as issue:Diagnostic){branch when{!errorRow(path,issue,true)=>{return false;},else=>unit};};
 let snapshot:Snapshot=scanned->snapshot;
 branch on parse(snapshot){Result<SyntaxForest,Diagnostic>::Ok(tree:SyntaxForest)=>unit,Result<SyntaxForest,Diagnostic>::Err(error:Diagnostic)=>{
  branch when{error->phase=="internal"||!errorRow(path,error,true)||!recoverDeclarations(path,snapshot,error->span->start)=>{return false;},else=>unit};
 }};
 lexical(path,snapshot)
};
public let analyze:Function(List<String>,ProjectInput):Int=function(fields:List<String>,input:ProjectInput):Int{
 let single:Bool=at(fields,3)=="syntax";
 branch when{single=>{
  branch when{!send(header(fields,"analysis"))||!record(List<String>["syntax"])=>{return 3;},else=>unit};
  loop over(input->sources as source:SourceUnit){branch when{!syntax(source)=>{return 3;},else=>unit};};return 0;
 },else=>unit};
 let state:State=branch on checkProfile(input,true){Result<State,InputError>::Ok(value:State)=>value,Result<State,InputError>::Err(error:InputError)=>{
  branch when{error->status!=1=>{return rejected(fields,error);},else=>unit};
  branch when{!send(header(fields,"analysis"))||!record(List<String>["partial"])||!errorRow(error->path,error->diagnostic,error->positionKnown)=>{return 3;},else=>unit};
  loop over(input->sources as source:SourceUnit){branch when{!syntax(source)=>{return 3;},else=>unit};};return 0;
 }};
 branch when{!send(header(fields,"analysis"))||!record(List<String>["checked"])=>{return 3;},else=>unit};
 var file:Int=0;loop over(input->sources as source:SourceUnit){
  let result:Paged<Row>=branch on forFile(state,file){Result<Paged<Row>,Diagnostic>::Ok(value:Paged<Row>)=>value,Result<Paged<Row>,Diagnostic>::Err(error:Diagnostic)=>{return 3;}};
  branch when{!tokens(source->displayPath,result)=>{return 3;},else=>unit};file=file+1;
 };0
};
