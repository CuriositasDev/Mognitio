let origin:Span=Span{start:3,end:8,line:4,column:5};
let word:Function(Int,Int):Bits<64>=function(pattern:Int,index:Int):Bits<64>{
 branch when{pattern==0=>Bits<64>{0},pattern==1=>Bits<64>{18446744073709551615},index%2==0=>Bits<64>{12297829382473034410},else=>Bits<64>{6148914691236517205}}
};
let vector:Function(Int,Int,Int,Bits<64>):List<Bits<64>>=function(n:Int,pattern:Int,replaced:Int,replacement:Bits<64>):List<Bits<64>>{
 var values:List<Bits<64>>=List<Bits<64>>[];var i:Int=0;
 loop while(i<n){values=values->append(branch when{i==replaced=>replacement,else=>word(pattern,i)});i=i+1;};values
};
let matches:Function(List<Bits<64>>,Int,Int,Int,Bits<64>):Bool=function(values:List<Bits<64>>,n:Int,pattern:Int,replaced:Int,replacement:Bits<64>):Bool{
 branch when{values->length()!=n=>{return false;},else=>unit};var i:Int=0;
 loop while(i<n){let expected:Bits<64>=branch when{i==replaced=>replacement,else=>word(pattern,i)};
 branch on values->at(i){Result<Bits<64>,IndexError>::Ok(actual:Bits<64>)=>{branch when{actual!=expected=>{return false;},else=>unit};},Result<Bits<64>,IndexError>::Err(error:IndexError)=>{return false;}};i=i+1;};true
};
let checkEqual:Function(Int,Int,Int,Int,Bits<64>,Int,Bits<64>,Bool):Bool=function(n:Int,m:Int,pattern:Int,li:Int,lw:Bits<64>,ri:Int,rw:Bits<64>,expected:Bool):Bool{
 let left:List<Bits<64>>=vector(n,pattern,li,lw);let right:List<Bits<64>>=vector(m,pattern,ri,rw);
 branch on equal(left,right,origin){Result<Bool,Diagnostic>::Ok(actual:Bool)=>actual==expected&&matches(left,n,pattern,li,lw)&&matches(right,m,pattern,ri,rw),Result<Bool,Diagnostic>::Err(error:Diagnostic)=>false}
};
let checkDefine:Function(Int,Int,Int,Int,Bits<64>,String):Bool=function(n:Int,pattern:Int,slot:Int,target:Int,expected:Bits<64>,message:String):Bool{
 let input:List<Bits<64>>=vector(n,pattern,-1,Bits<64>{0});
 branch on define(input,slot,origin){
 Result<List<Bits<64>>,Diagnostic>::Ok(actual:List<Bits<64>>)=>message==""&&matches(actual,n,pattern,target,expected)&&matches(input,n,pattern,-1,Bits<64>{0}),
 Result<List<Bits<64>>,Diagnostic>::Err(error:Diagnostic)=>message!=""&&error->phase=="internal"&&error->message==message&&error->span->start==3&&error->span->end==8&&error->span->line==4&&error->span->column==5&&matches(input,n,pattern,-1,Bits<64>{0})
 }
};
