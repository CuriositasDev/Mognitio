namespace Mgnc\Driver;
use Std\Io\{readTextFile,writeStderr,IoError,IoErrorKind,IoErrorPhase};
use Std\Binary\{Bytes,publishFile,BinaryFileMode,BinaryOutputError,BinaryOutputErrorKind,BinaryOutputPhase,BinaryPublicationState};
use Mgnc\Data\{Diagnostic,describe,contains};
use Mgnc\Pipeline\{compile};
use Mgnc\Project\{single,project};
use Mgnc\InputData\{ProjectInput,SourceUnit,InputError};
use Mgnc\InputDiagnostics\{message as inputMessage,escapePath};
use Mgnc\Semantic\{SemanticProject,analyze};
use Mgnc\Structural\{analyzeSyntax};
use Mgnc\Forest\{SyntaxForest};
public let report:Function(Int,String):Int=function(status:Int,message:String):Int{
 branch on writeStderr(message){
  Result<Unit,IoError>::Ok(value:Unit)=>status,
  Result<Unit,IoError>::Err(error:IoError)=>2,
 }
};
let argument:Function(List<String>,Int):String=function(args:List<String>,index:Int):String{
 branch on args->at(index){Result<String,IndexError>::Ok(value:String)=>value,Result<String,IndexError>::Err(error:IndexError)=>""}
};
let endsWith:Function(String,String):Bool=function(text:String,suffix:String):Bool{
 branch when{text->length()<suffix->length()=>false,else=>branch on text->slice(text->length()-suffix->length(),text->length()){
  Result<String,SliceError>::Ok(value:String)=>value==suffix,Result<String,SliceError>::Err(error:SliceError)=>false}}
};
let ioKind:Function(IoErrorKind):String=function(kind:IoErrorKind):String{
 branch on kind{
  IoErrorKind::InvalidPath=>"InvalidPath",IoErrorKind::InvalidEncoding=>"InvalidEncoding",
  IoErrorKind::NotFound=>"NotFound",IoErrorKind::PermissionDenied=>"PermissionDenied",
  IoErrorKind::UnsupportedTarget=>"UnsupportedTarget",IoErrorKind::BrokenPipe=>"BrokenPipe",
  IoErrorKind::ResourceExhausted=>"ResourceExhausted",IoErrorKind::Other=>"Other",
 }
};
let ioPhase:Function(IoErrorPhase):String=function(phase:IoErrorPhase):String{
 branch on phase{IoErrorPhase::Input=>"Input",IoErrorPhase::Target=>"Target",IoErrorPhase::Body=>"Body",IoErrorPhase::Cleanup=>"Cleanup"}
};
let outputKind:Function(BinaryOutputErrorKind):String=function(kind:BinaryOutputErrorKind):String{
 branch on kind{
  BinaryOutputErrorKind::InvalidPath=>"InvalidPath",BinaryOutputErrorKind::AlreadyExists=>"AlreadyExists",
  BinaryOutputErrorKind::NotFound=>"NotFound",BinaryOutputErrorKind::PermissionDenied=>"PermissionDenied",
  BinaryOutputErrorKind::UnsupportedTarget=>"UnsupportedTarget",BinaryOutputErrorKind::ResourceExhausted=>"ResourceExhausted",
  BinaryOutputErrorKind::Other=>"Other",
 }
};
let outputPhase:Function(BinaryOutputPhase):String=function(phase:BinaryOutputPhase):String{
 branch on phase{BinaryOutputPhase::Input=>"Input",BinaryOutputPhase::Target=>"Target",BinaryOutputPhase::Body=>"Body",BinaryOutputPhase::Publish=>"Publish",BinaryOutputPhase::Cleanup=>"Cleanup"}
};
let publicationState:Function(BinaryPublicationState):String=function(state:BinaryPublicationState):String{
 branch on state{BinaryPublicationState::NotPublished=>"NotPublished",BinaryPublicationState::Published=>"Published",BinaryPublicationState::Unknown=>"Unknown"}
};
public let publicationMessage:Function(BinaryOutputError):String=function(error:BinaryOutputError):String{
 "mgnc: publication: "+error->subject+": "+outputKind(error->kind)+" / "+outputPhase(error->phase)+" / "+publicationState(error->publication)+"\n"
};
public let run:Function(List<String>):Int=function(args:List<String>):Int{
 let command:String=argument(args,0);let sourcePath:String=argument(args,1);
 let parsing:Bool=command=="parse";let checking:Bool=command=="check";
 let option:String=argument(args,2);let outputPath:String=argument(args,3);
 branch when{!(((parsing||checking)&&args->length()==2)||(command=="build"&&args->length()==4&&option=="-o"))=>{
  return report(2,"mgnc: cli: expected parse source.mgn, check source.mgn or mognitio.toml, or build source.mgn -o new-artifact\n");
 },else=>unit};
 branch when{sourcePath=="" || contains(sourcePath,"\0") || (command=="build"&&(outputPath==""||contains(outputPath,"\0")))=>{
  return report(2,"mgnc: cli: InvalidPath: empty or NUL-containing path\n");
 },else=>unit};
 let manifest:Bool=sourcePath=="mognitio.toml"||endsWith(sourcePath,"/mognitio.toml");
 branch when{!endsWith(sourcePath,".mgn")&&!(checking&&manifest)=>{return report(2,"mgnc: cli: "+sourcePath+": source requires .mgn extension\n");},else=>unit};
 branch when{command=="build"&&endsWith(outputPath,"/")=>{return report(2,"mgnc: cli: "+outputPath+": InvalidPath: trailing slash\n");},else=>unit};
 let input:ProjectInput=branch on branch when{manifest=>project(sourcePath),else=>single(sourcePath)}{
  Result<ProjectInput,InputError>::Ok(value:ProjectInput)=>value,
  Result<ProjectInput,InputError>::Err(error:InputError)=>{return report(error->status,inputMessage(error));}
 };
 let source:SourceUnit=branch on input->sources->at(input->entry){Result<SourceUnit,IndexError>::Ok(value:SourceUnit)=>value,Result<SourceUnit,IndexError>::Err(error:IndexError)=>{return report(3,"mgnc: internal: input entry missing\n");}};
 branch when{parsing=>{
  return branch on analyzeSyntax(source->text){
   Result<SyntaxForest,Diagnostic>::Ok(tree:SyntaxForest)=>0,
   Result<SyntaxForest,Diagnostic>::Err(error:Diagnostic)=>report(branch when{error->phase=="internal"=>3,else=>1},describe(escapePath(sourcePath),error)),
  };
 },else=>unit};
 let semantic:SemanticProject=branch on analyze(input){
  Result<SemanticProject,InputError>::Ok(value:SemanticProject)=>value,
  Result<SemanticProject,InputError>::Err(error:InputError)=>{return report(error->status,inputMessage(error));}
 };
 branch when{checking=>{return 0;},else=>unit};
 let bytes:Bytes=branch on compile(semantic){
  Result<Bytes,Diagnostic>::Ok(value:Bytes)=>value,
  Result<Bytes,Diagnostic>::Err(error:Diagnostic)=>{
   return report(branch when{error->phase=="internal"=>3,else=>1},describe(escapePath(sourcePath),error));
  },
 };
 branch on publishFile(outputPath,bytes,BinaryFileMode::Executable){
  Result<Unit,BinaryOutputError>::Ok(value:Unit)=>0,
  Result<Unit,BinaryOutputError>::Err(error:BinaryOutputError)=>report(2,publicationMessage(error)),
 }
};
