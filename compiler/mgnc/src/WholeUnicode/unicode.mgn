public let number:Function(String):Int=function(scalar:String):Int{
 let ordinary:Int=ascii(scalar);branch when{ordinary>=0=>{return ordinary;},else=>unit};var value:Int=0;loop over(pages as page:String){loop over(page->scalars() as candidate:String){branch when{candidate==scalar=>{return value;},else=>unit};value=value+1;branch when{value==55296=>{value=57344;},else=>unit};};};-1
};
