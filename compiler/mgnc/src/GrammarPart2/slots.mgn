 Slot{lhs:20,rule:42,dot:1,next:21},
 Slot{lhs:20,rule:42,dot:2,next:0},
 Slot{lhs:21,rule:43,dot:0,next:0},
 Slot{lhs:21,rule:44,dot:0,next:-8},
 Slot{lhs:21,rule:44,dot:1,next:0},
 Slot{lhs:21,rule:45,dot:0,next:-8},
 Slot{lhs:21,rule:45,dot:1,next:19},
 Slot{lhs:21,rule:45,dot:2,next:21},
 Slot{lhs:21,rule:45,dot:3,next:0},
 Slot{lhs:22,rule:46,dot:0,next:-17},
 Slot{lhs:22,rule:46,dot:1,next:23},
 Slot{lhs:22,rule:46,dot:2,next:-18},
 Slot{lhs:22,rule:46,dot:3,next:0},
 Slot{lhs:23,rule:47,dot:0,next:25},
 Slot{lhs:23,rule:47,dot:1,next:24},
 Slot{lhs:23,rule:47,dot:2,next:0},
 Slot{lhs:24,rule:48,dot:0,next:0},
 Slot{lhs:24,rule:49,dot:0,next:-8},
 Slot{lhs:24,rule:49,dot:1,next:0},
 Slot{lhs:24,rule:50,dot:0,next:-8},
 Slot{lhs:24,rule:50,dot:1,next:25},
 Slot{lhs:24,rule:50,dot:2,next:24},
 Slot{lhs:24,rule:50,dot:3,next:0},
 Slot{lhs:25,rule:51,dot:0,next:19},
 Slot{lhs:25,rule:51,dot:1,next:0},
 Slot{lhs:25,rule:52,dot:0,next:26},
 Slot{lhs:25,rule:52,dot:1,next:0},
 Slot{lhs:26,rule:53,dot:0,next:-24},
