namespace Mgnc\WholePathMachine;
use Mgnc\Data\{Paged,Diagnostic,Span,empty,push,lookup};
use Mgnc\Machine\{Code,Record,flush};
use Mgnc\WholeNativeData\{Native,Global};
use Mgnc\WholeChecks\{require};
use Mgnc\Tables\{atList};
use Mgnc\IntMap\{Map,create as createMap,get,put};
let same:Function(List<Int>,List<Int>):Bool=function(left:List<Int>,right:List<Int>):Bool{branch when{left->length()!=right->length()=>{return false;},else=>unit};var i:Int=0;loop over(left as value:Int){let other:Int=branch on right->at(i){Result<Int,IndexError>::Ok(found:Int)=>found,Result<Int,IndexError>::Err(error:IndexError)=>{return false;}};branch when{value!=other=>{return false;},else=>unit};i=i+1;};true};
let tail:Function(List<Int>,List<Int>):Bool=function(data:List<Int>,suffix:List<Int>):Bool{branch when{data->length()<suffix->length()=>{return false;},else=>unit};var index:Int=0;loop over(suffix as value:Int){let other:Int=branch on data->at(data->length()-suffix->length()+index){Result<Int,IndexError>::Ok(found:Int)=>found,Result<Int,IndexError>::Err(error:IndexError)=>{return false;}};branch when{value!=other=>{return false;},else=>unit};index=index+1;};true};
let append:Function(List<Int>,List<Int>):List<Int>=function(left:List<Int>,right:List<Int>):List<Int>{var out:List<Int>=left;loop over(right as value:Int){out=out->append(value);};out};
let bytes:Function(Int,Int):List<Int>=function(value:Int,count:Int):List<Int>{var remaining:Int=value;var out:List<Int>=List<Int>[];var index:Int=0;loop while(index<count){let rem:Int=remaining%256;out=out->append(branch when{rem<0=>rem+256,else=>rem});remaining=remaining/256-branch when{rem<0=>1,else=>0};index=index+1;};out};
let pattern:Function(List<Int>,Int,Int):List<Int>=function(prefix:List<Int>,value:Int,size:Int):List<Int>{append(prefix,bytes(value,size))};
let occurrences:Function(List<Int>,List<Int>):Int=function(data:List<Int>,wanted:List<Int>):Int{var count:Int=0;var window:List<Int>=List<Int>[];loop over(data as value:Int){window=window->append(value);branch when{window->length()>wanted->length()=>{var out:List<Int>=List<Int>[];var ordinal:Int=0;loop over(window as octet:Int){branch when{ordinal>0=>{out=out->append(octet);},else=>unit};ordinal=ordinal+1;};window=out;},else=>unit};branch when{same(window,wanted)=>{count=count+1;},else=>unit};};count};

type State=product{pc:Int;ownership:Int;};
let ownership:Function(Code,Map,Int,Int,Bool,Span):Result<Unit,Diagnostic>=function(code:Code,labels:Map,start:Int,limit:Int,create:Bool,span:Span):Result<Unit,Diagnostic>{var queue:Paged<State>=push<State>(empty<State>(),State{pc:start,ownership:branch when{create=>0,else=>3}});var index:Int=0;var seen:Map=createMap();loop while(index<queue->count){let state:State=try lookup<State>(queue,index);index=index+1;try require(state->pc>=start&&state->pc<limit,span,"path control escapes helper");let key:Int=state->pc*4+state->ownership;branch when{(try get(seen,key))>=0=>{continue;},else=>unit};seen=try put(seen,key,1);let record:Record=try lookup<Record>(code->records,state->pc);var owned:Int=state->ownership;
 branch when{record->kind==3&&record->value==168&&(tail(record->bytes,List<Int>[73,137,159])||tail(record->bytes,List<Int>[73,137,135]))=>{try require(create,span,"lexical join acquires resources");let previous:Record=try lookup<Record>(code->records,state->pc-1);branch when{tail(record->bytes,List<Int>[73,137,159])=>{try require(owned==0&&previous->kind==3&&previous->value==0&&tail(previous->bytes,List<Int>[72,137,131]),span,"creation resource registration");owned=1;},else=>{try require(owned==2&&previous->kind==3&&previous->value==0&&tail(previous->bytes,List<Int>[72,139,131]),span,"creation cleanup before release");owned=3;}};
 },record->kind==2&&tail(record->bytes,List<Int>[232])=>{branch when{record->target==10=>{try require(owned==3,span,"path managed allocation while owning resources");},record->target==84=>{let following:Record=try lookup<Record>(code->records,state->pc+1);try require(create&&owned==1&&following->kind==3&&following->value==16&&tail(following->bytes,List<Int>[72,137,131]),span,"creation map registration");},record->target==61=>{try require(create&&owned==1,span,"creation cleanup ownership");owned=2;},record->target==83=>{try require(create&&owned==3,span,"creation classification before release");},else=>{try require(false,span,"path unexpected runtime call");}};
 },else=>unit};
 branch when{record->kind==0&&tail(record->bytes,List<Int>[65,95,65,94,65,93,65,92,91,93,195])=>{try require(owned==3,span,"path return retains resources");let restored:Record=try lookup<Record>(code->records,state->pc-1);try require(restored->kind==3&&restored->value==branch when{create=>584,else=>136}&&tail(restored->bytes,List<Int>[72,129,196]),span,"path frame restoration");let rootStore:Record=try lookup<Record>(code->records,state->pc-2);let rootLoad:Record=try lookup<Record>(code->records,state->pc-3);try require(rootStore->kind==3&&rootStore->value==0&&tail(rootStore->bytes,List<Int>[73,137,151])&&rootLoad->kind==3&&rootLoad->value== -64&&tail(rootLoad->bytes,List<Int>[72,139,149]),span,"path root frame restoration");continue;},else=>unit};var fallthrough:Bool=true;branch when{record->kind==2&&!tail(record->bytes,List<Int>[232])=>{let unconditional:Bool=tail(record->bytes,List<Int>[233]);try require(unconditional||record->bytes->length()>=2&&(try atList<Int>(record->bytes,record->bytes->length()-2))==15,span,"path branch opcode");branch when{record->target<128=>{try require(record->target==1||record->target==2||!create&&record->target==6,span,"path terminal target");},else=>{queue=push<State>(queue,State{pc:try get(labels,record->target),ownership:owned});}};fallthrough=!unconditional;},else=>unit};branch when{fallthrough=>{queue=push<State>(queue,State{pc:state->pc+1,ownership:owned});},else=>unit};
 };Result<Unit,Diagnostic>::Ok(unit)};
type Region=product{start:Int;end:Int;data:List<Int>;};
let region:Function(Code,Map,Int,Span):Result<Region,Diagnostic>=function(code:Code,labels:Map,id:Int,span:Span):Result<Region,Diagnostic>{let start:Int=(try get(labels,id))+1;try require(start>0,span,"path helper entry");var cursor:Int=start;var data:List<Int>=List<Int>[];loop while(cursor<code->records->count){let record:Record=try lookup<Record>(code->records,cursor);branch when{record->kind==1&&record->target<256=>{break;},else=>unit};data=append(data,record->bytes);branch when{record->kind==2||record->kind==3=>{data=append(data,bytes(branch when{record->kind==3=>record->value,else=>0},4));},record->kind==4||record->kind==5=>{data=append(data,bytes(branch when{record->kind==4=>record->value,else=>0},8));},else=>unit};cursor=cursor+1;};Result<Region,Diagnostic>::Ok(Region{start:start,end:cursor,data:data})};
let syscalls:Function(Code,Region,List<Int>,Span):Result<Unit,Diagnostic>=function(code:Code,part:Region,expected:List<Int>,span:Span):Result<Unit,Diagnostic>{var actual:List<Int>=List<Int>[];var cursor:Int=part->start;loop while(cursor<part->end){let record:Record=try lookup<Record>(code->records,cursor);branch when{record->kind==4&&same(record->bytes,List<Int>[72,184])=>{let following:Record=try lookup<Record>(code->records,cursor+1);branch when{following->bytes->length()>=2&&(try atList<Int>(following->bytes,0))==15&&(try atList<Int>(following->bytes,1))==5=>{actual=actual->append(record->value);},else=>unit};},else=>unit};cursor=cursor+1;};try require(same(actual,expected),span,"path syscall set");Result<Unit,Diagnostic>::Ok(unit)};
let stat:Function(Int):List<Int>=function(flags:Int):List<Int>{var result:List<Int>=pattern(List<Int>[72,191],-100,8);result=append(result,pattern(List<Int>[72,139,179],16,4));result=append(result,pattern(List<Int>[72,141,148,36],256,4));result=append(result,pattern(List<Int>[73,186],flags,8));result=append(result,pattern(List<Int>[72,184],262,8));append(result,List<Int>[15,5])};
public let verify:Function(Native,Code):Result<Unit,Diagnostic>=function(plan:Native,initial:Code):Result<Unit,Diagnostic>{let code:Code=flush(initial);let span:Span=Span{start:0,end:0,line:1,column:1};var labels:Map=createMap();var ordinal:Int=0;loop over(code->records->pages->append(code->records->tail) as page:List<Record>){loop over(page as record:Record){branch when{record->kind==1=>{labels=try put(labels,record->target,ordinal);},else=>unit};ordinal=ordinal+1;};};var mappingNeeded:Bool=false;
 loop over(plan->globals->pages->append(plan->globals->tail) as page:List<Global>){loop over(page as global:Global){mappingNeeded=mappingNeeded||global->standard=="readDirectory";branch when{global->standard=="joinPath"||global->standard=="createDirectory"=>{let create:Bool=global->standard=="createDirectory";let id:Int=branch when{create=>78,else=>77};mappingNeeded=mappingNeeded||create;let part:Region=try region(code,labels,id,span);let first:Record=try lookup<Record>(code->records,part->start);try require(first->kind==3&&first->value==branch when{create=>584,else=>136}&&same(first->bytes,List<Int>[85,72,137,229,83,65,84,65,85,65,86,65,87,72,129,236]),span,"path frame and callee saves");try syscalls(code,part,branch when{create=>List<Int>[262,258,262,262],else=>List<Int>[]},span);
 branch when{create=>{try require(occurrences(part->data,stat(0))==2&&occurrences(part->data,stat(256))==1,span,"creation stat ABI and follow policy");var mkdir:List<Int>=pattern(List<Int>[72,191],-100,8);mkdir=append(mkdir,pattern(List<Int>[72,139,179],16,4));mkdir=append(mkdir,pattern(List<Int>[72,186],511,8));mkdir=append(mkdir,pattern(List<Int>[72,184],258,8));mkdir=append(mkdir,List<Int>[15,5]);try require(occurrences(part->data,mkdir)==1,span,"creation mkdir ABI and requested mode");try require(occurrences(part->data,append(pattern(List<Int>[72,184],-1,8),pattern(List<Int>[72,137,131],8,4)))==1,span,"creation absent file descriptor");},else=>unit};try ownership(code,labels,part->start,part->end,create,span);
 },else=>unit};};};branch when{mappingNeeded=>{try syscalls(code,try region(code,labels,83,span),List<Int>[],span);let mapping:Region=try region(code,labels,84,span);try syscalls(code,mapping,List<Int>[9],span);var requested:List<Int>=List<Int>[72,137,254];requested=append(requested,pattern(List<Int>[72,191],0,8));requested=append(requested,pattern(List<Int>[72,186],3,8));requested=append(requested,pattern(List<Int>[73,186],34,8));requested=append(requested,pattern(List<Int>[73,184],-1,8));requested=append(requested,pattern(List<Int>[73,185],0,8));requested=append(requested,pattern(List<Int>[72,184],9,8));requested=append(requested,List<Int>[15,5]);try require(occurrences(mapping->data,requested)==1,span,"directory anonymous mapping ABI");},else=>unit};Result<Unit,Diagnostic>::Ok(unit)};
