namespace Mgnc;
use Mgnc\FlatChunks\{Buffered as FlatBuffered,buffered as flatBuffered,addBuffered as addFlat,finishBuffered as finishFlat};
use Mgnc\Data\{Diagnostic,Span};use Mgnc\EncodeChunks\{Buffered,buffered,addBuffered,finishBuffered,add,finish,pack};use Std\Binary\{Bytes};use Std\Numeric\{Bits};
let main:Function(List<String>):Int=function(args:List<String>):Int{
 let selected:String=branch on args->at(0){Result<String,IndexError>::Ok(value:String)=>value,Result<String,IndexError>::Err(error:IndexError)=>{return 2;}};
 let size:String=branch on args->at(1){Result<String,IndexError>::Ok(value:String)=>value,Result<String,IndexError>::Err(error:IndexError)=>{return 2;}};
 let count:Int=branch when{size=="small"=>257,size=="medium"=>4097,else=>65537};let span:Span=Span{start:0,end:0,line:1,column:1};
 let piece:Bytes=branch on pack(List<Int>[1,2,3,4,5,6,7,8],span){Result<Bytes,Diagnostic>::Ok(value:Bytes)=>value,Result<Bytes,Diagnostic>::Err(error:Diagnostic)=>panic{"piece"}};
 var state:Buffered=buffered();var flat:FlatBuffered=flatBuffered();var levels:List<Bytes>=List<Bytes>[];var index:Int=0;
 loop while(index<count){branch when{selected=="buffered"=>{state=branch on addBuffered(state,piece){Result<Buffered,Diagnostic>::Ok(value:Buffered)=>value,Result<Buffered,Diagnostic>::Err(error:Diagnostic)=>panic{"buffer"}};},selected=="flat"=>{flat=branch on addFlat(flat,piece){Result<FlatBuffered,Diagnostic>::Ok(value:FlatBuffered)=>value,Result<FlatBuffered,Diagnostic>::Err(error:Diagnostic)=>panic{"flat"}};},else=>{levels=branch on add(levels,piece){Result<List<Bytes>,Diagnostic>::Ok(value:List<Bytes>)=>value,Result<List<Bytes>,Diagnostic>::Err(error:Diagnostic)=>panic{"levels"}};}};index=index+1;};
 let value:Bytes=branch when{selected=="buffered"=>finishBuffered(state),selected=="flat"=>finishFlat(flat),else=>finish(levels)};assert value->length()==count*8;index=0;loop while(index<value->length()){branch on value->at(index){Result<Bits<8>,IndexError>::Ok(byte:Bits<8>)=>{assert byte==branch when{index%8==0=>Bits<8>{1},index%8==1=>Bits<8>{2},index%8==2=>Bits<8>{3},index%8==3=>Bits<8>{4},index%8==4=>Bits<8>{5},index%8==5=>Bits<8>{6},index%8==6=>Bits<8>{7},else=>Bits<8>{8}};},Result<Bits<8>,IndexError>::Err(error:IndexError)=>panic{"byte"}};index=index+1;};0
};
