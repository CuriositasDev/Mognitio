namespace Mgnc\BridgeShape;
use Mgnc\Data\{Span,Diagnostic};
use Mgnc\Syntax\{Node};
use Mgnc\Forest\{SyntaxForest};
use Mgnc\ForestData\{ForestNode};
use Mgnc\NodeStorage\{getNode};
use Mgnc\Projection\{parts,item,text,site,failure,concrete};
use Mgnc\NativeTypes\{typeCode};
use Mgnc\BridgeLists\{leftList,expressions,conditions};
use Mgnc\Grammar\{ruleInteger,ruleTrue,ruleFalse,ruleUnit,ruleName,ruleGroup,ruleUnaryNeg,ruleUnaryNot,ruleBinaryOr,ruleBinaryAnd,ruleBinaryLt,ruleBinaryLe,ruleBinaryGt,ruleBinaryGe,ruleBinaryEq,ruleBinaryNe,ruleBinaryAdd,ruleBinarySub,ruleBinaryMul,ruleBinaryDiv,ruleBinaryRem,ruleCall,ruleMethod,ruleBlock,ruleLetBinding,ruleVarBinding,ruleStatementAssign,ruleStatementReturn,ruleStatementBreak,ruleStatementContinue,ruleStatementDiscard,ruleStatementExpression,ruleBranchWhen,ruleLoopWhile,ruleGenericApply};
public type Binding=product{name:String;after:Int;until:Int;};
public let runtimeName:Function(List<Binding>,String,Int):Bool=function(bindings:List<Binding>,name:String,cursor:Int):Bool{
 loop over(bindings as binding:Binding){branch when{binding->name==name&&cursor>=binding->after&&cursor<binding->until=>{return true;},else=>unit};};false
};
// Node children are forest IDs here; BridgeBody replaces them with old AST IDs.
public let shape:Function(SyntaxForest,Int,Int,List<Binding>):Result<Node,Diagnostic>=function(tree:SyntaxForest,id:Int,block:Int,bindings:List<Binding>):Result<Node,Diagnostic>{
 let original:ForestNode=try getNode(tree->nodes,id);let rule:Int=original->rule;let source:List<Int>=try parts(tree,id);
 var kind:Int=0;var spelling:String="";var children:List<Int>=List<Int>[];var annotation:Int=0;var flag:Bool=false;var span:Span=try site(tree,id);
 branch when{
  rule==ruleInteger||rule==ruleTrue||rule==ruleFalse||rule==ruleUnit=>{kind=1;spelling=try text(tree,id);},
  rule==ruleName=>{kind=2;spelling=try text(tree,id);},
  rule==ruleGroup=>{kind=3;children=List<Int>[try item(source,1)];},
  rule==ruleUnaryNeg||rule==ruleUnaryNot=>{kind=4;spelling=try text(tree,id);children=List<Int>[try item(source,1)];},
  rule==ruleBinaryOr||rule==ruleBinaryAnd||(rule>=ruleBinaryLt&&rule<=ruleBinaryNe)||rule==ruleBinaryAdd||rule==ruleBinarySub||rule==ruleBinaryMul||rule==ruleBinaryDiv||rule==ruleBinaryRem=>{
   kind=5;spelling=try text(tree,try item(source,1));children=List<Int>[try item(source,0),try item(source,2)];
  },
  rule==ruleCall=>{
   kind=6;children=List<Int>[try item(source,0)];let arguments:List<Int>=try expressions(tree,try item(source,2));loop over(arguments as argument:Int){children=children->append(argument);};
  },
  rule==ruleMethod=>{
   let member:Int=try item(source,2);let arguments:List<Int>=try expressions(tree,try item(source,4));
   branch when{(try text(tree,member))!="length"||arguments->length()!=0=>{return Result<Node,Diagnostic>::Err(try failure(tree,member,"unsupported","method is outside the native profile"));},else=>unit};
   kind=7;spelling="length";children=List<Int>[try item(source,0)];
  },
  rule==ruleBlock=>{
   kind=8;children=try leftList(tree,try item(source,1));let tail:List<Int>=try parts(tree,try item(source,2));
   branch when{tail->length()>0=>{flag=true;children=children->append(try item(tail,0));},else=>unit};
  },
  rule==ruleLetBinding||rule==ruleVarBinding=>{
   kind=9;flag=rule==ruleVarBinding;let name:Int=try item(source,1);spelling=try text(tree,name);span=try site(tree,name);annotation=try typeCode(tree,try item(source,3));children=List<Int>[try item(source,5)];
  },
  rule==ruleStatementAssign=>{
   let target:Int=try concrete(tree,try item(source,0));let targetNode:ForestNode=try getNode(tree->nodes,target);
   branch when{targetNode->rule!=ruleName=>{return Result<Node,Diagnostic>::Err(try failure(tree,try item(source,1),"parse","expected statement terminator"));},else=>unit};
   kind=10;spelling=try text(tree,target);span=try site(tree,target);children=List<Int>[try item(source,2)];
  },
  rule==ruleStatementReturn=>{kind=11;children=List<Int>[try item(source,1)];},
  rule==ruleStatementBreak=>{kind=12;spelling="break";},
  rule==ruleStatementContinue=>{kind=13;spelling="continue";},
  rule==ruleStatementDiscard=>{kind=14;children=List<Int>[try item(source,1)];},
  rule==ruleStatementExpression=>{kind=15;children=List<Int>[try item(source,0)];span=try site(tree,block);},
  rule==ruleBranchWhen=>{kind=16;children=try conditions(tree,try item(source,3));children=children->append(try item(source,6));},
  rule==ruleLoopWhile=>{kind=17;children=List<Int>[try item(source,3),try item(source,5)];},
  rule==ruleGenericApply=>{
   let name:String=try text(tree,try item(source,0));
   branch when{runtimeName(bindings,name,original->start)=>{
    let arguments:List<Int>=try parts(tree,try item(source,1));return Result<Node,Diagnostic>::Err(try failure(tree,try item(arguments,2),"parse","comparison operators do not chain"));
   },else=>unit};
  },
  else=>unit,
 };
 branch when{kind==0=>{return Result<Node,Diagnostic>::Err(try failure(tree,id,"unsupported","expression is outside the native profile"));},else=>unit};
 Result<Node,Diagnostic>::Ok(Node{kind:kind,text:spelling,children:children,span:span,annotation:annotation,flag:flag})
};
