namespace Mgnc\WholeStableKeys;
use Mgnc\Data\{Paged,Diagnostic,empty,push,lookup};
use Mgnc\Syntax\{Parent};
use Mgnc\TypeData\{Store,Type,Argument,ValueTerm};
public type Entry=product{id:Int;tokens:Paged<Int>;};
public let vector:Function(List<Int>):Paged<Int>=function(values:List<Int>):Paged<Int>{var out:Paged<Int>=empty<Int>();loop over(values as value:Int){out=push<Int>(out,value);};out};
let value:Function(ValueTerm):List<Int>=function(term:ValueTerm):List<Int>{
 branch on term->parameter{Parent::None=>List<Int>[0,term->value],Parent::Some(ordinal:Int)=>List<Int>[1,term->owner,ordinal]}
};
// Interned TypeId is an allocation identity, not a stable layout key.
// Nominal identity uses the original declaration; members need not be unfolded.
public let shape:Function(Store,Int):Result<List<Int>,Diagnostic>=function(store:Store,id:Int):Result<List<Int>,Diagnostic>{
 var pending:Paged<Argument>=push<Argument>(empty<Argument>(),Argument::Type(id));
 var cursor:Int=0;var out:List<Int>=List<Int>[];
 loop while(cursor<pending->count){
  let argument:Argument=try lookup<Argument>(pending,cursor);cursor=cursor+1;
  branch on argument{
   Argument::Type(child:Int)=>{
    let item:Type=try lookup<Type>(store->types,child);
    out=out->append(0)->append(item->kind)->append(branch on item->owner{Parent::None=>-1,Parent::Some(owner:Int)=>owner})->append(item->arguments->length());
    loop over(item->arguments as nested:Argument){pending=push<Argument>(pending,nested);};
   },
   Argument::Value(term:ValueTerm)=>{out=out->append(1);loop over(value(term) as token:Int){out=out->append(token);};}
  };
 };Result<List<Int>,Diagnostic>::Ok(out)
};
public let arguments:Function(Store,List<Argument>):Result<List<Int>,Diagnostic>=function(store:Store,values:List<Argument>):Result<List<Int>,Diagnostic>{
 var out:List<Int>=List<Int>[values->length()];
 loop over(values as argument:Argument){branch on argument{
  Argument::Type(child:Int)=>{out=out->append(0);loop over((try shape(store,child)) as token:Int){out=out->append(token);};},
  Argument::Value(term:ValueTerm)=>{out=out->append(1);loop over(value(term) as token:Int){out=out->append(token);};}
 };};Result<List<Int>,Diagnostic>::Ok(out)
};
public let compare:Function(Paged<Int>,Paged<Int>):Result<Int,Diagnostic>=function(left:Paged<Int>,right:Paged<Int>):Result<Int,Diagnostic>{
 var index:Int=0;loop while(index<left->count&&index<right->count){
  let a:Int=try lookup<Int>(left,index);let b:Int=try lookup<Int>(right,index);
  branch when{a<b=>{return Result<Int,Diagnostic>::Ok(-1);},a>b=>{return Result<Int,Diagnostic>::Ok(1);},else=>unit};index=index+1;
 };Result<Int,Diagnostic>::Ok(branch when{left->count<right->count=>-1,left->count>right->count=>1,else=>0})
};
// Iterative merge sort avoids insertion-order cost for large specialization sets.
public let sort:Function(Paged<Entry>):Result<Paged<Entry>,Diagnostic>=function(initial:Paged<Entry>):Result<Paged<Entry>,Diagnostic>{
 var rows:Paged<Entry>=initial;var width:Int=1;
 loop while(width<rows->count){
  var out:Paged<Entry>=empty<Entry>();var start:Int=0;
  loop while(start<rows->count){
   let middle:Int=branch when{start+width<rows->count=>start+width,else=>rows->count};
   let end:Int=branch when{middle+width<rows->count=>middle+width,else=>rows->count};
   var left:Int=start;var right:Int=middle;
   loop while(left<middle||right<end){
    let takeLeft:Bool=left<middle&&(right>=end||(try compare((try lookup<Entry>(rows,left))->tokens,(try lookup<Entry>(rows,right))->tokens))<=0);
    branch when{takeLeft=>{out=push<Entry>(out,try lookup<Entry>(rows,left));left=left+1;},else=>{out=push<Entry>(out,try lookup<Entry>(rows,right));right=right+1;}};
   };start=end;
  };rows=out;width=width*2;
 };Result<Paged<Entry>,Diagnostic>::Ok(rows)
};
