namespace Mgnc\Pipeline;
use Std\Binary\{Bytes};
use Mgnc\Data\{Diagnostic};
use Mgnc\Semantic\{SemanticProject};
use Mgnc\Checked\{CheckedProgram};
use Mgnc\NativeProject\{Projected,project};
use Mgnc\NativeLayout\{validate};
use Mgnc\IR\{ModuleIR};
use Mgnc\Lower\{lower};
use Mgnc\Verify\{verify};
use Mgnc\Native\{generate};
use Mgnc\Encode\{encode};
public let prepare:Function(SemanticProject):Result<CheckedProgram,Diagnostic>=function(semantic:SemanticProject):Result<CheckedProgram,Diagnostic>{
 let projected:Projected=try project(semantic);try validate(semantic,projected);
 Result<CheckedProgram,Diagnostic>::Ok(projected->program)
};
public let compile:Function(CheckedProgram):Result<Bytes,Diagnostic>=function(program:CheckedProgram):Result<Bytes,Diagnostic>{
 let module:ModuleIR=try lower(program);try verify(module);
 encode(try generate(module))
};
