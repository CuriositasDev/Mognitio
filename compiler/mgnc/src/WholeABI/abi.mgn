// Internal scalar-only runtime helper frames preserve the language callee-save set.
// They take explicitly documented volatile register inputs; no managed GC occurs
// in these frame prologues/epilogues. Source-call adapters use the stack ABI.
public let enter:Function(Code):Code=function(initial:Code):Code{
 var code:Code=mov(push(initial,5),5,4);loop over(List<Int>[3,12,13,14,15] as reg:Int){code=push(code,reg);};constant(code,5,4,8)
};
public let leave:Function(Code):Code=function(initial:Code):Code{
 var code:Code=constant(initial,0,4,8);loop over(List<Int>[15,14,13,12,3,5] as reg:Int){code=pop(code,reg);};raw(code,List<Int>[195])
};
