let frame:Frame=Frame{slots:4,outgoing:64,extent:624,entry:List<Bits<64>>[Bits<64>{15}],points:empty<Point>()};
let descriptor:Function(Native,Int):Result<Int,Diagnostic>=function(plan:Native,id:Int):Result<Int,Diagnostic>{let found:Int=try get(plan->layouts->types,id);try require(found>=0,Span{start:0,end:0,line:1,column:1},"inspection descriptor");Result<Int,Diagnostic>::Ok(found)};
let allocate:Function(Code,Int,Int):Code=function(initial:Code,size:Int,desc:Int):Code{jump(immediate(immediate(initial,7,size),6,desc),List<Int>[232],10)};
let operation:Function(Code,Native,Global):Result<Code,Diagnostic>=function(initial:Code,plan:Native,global:Global):Result<Code,Diagnostic>{
 let span:Span=Span{start:0,end:0,line:1,column:1};let signature:Type=try lookup<Type>(plan->concrete->types->types,global->valueType);let resultId:Int=try argumentType(signature,1,span);let result:Type=try lookup<Type>(plan->concrete->types->types,resultId);let infoId:Int=try argumentType(result,0,span);let errorId:Int=try argumentType(result,1,span);let info:Type=try lookup<Type>(plan->concrete->types->types,infoId);let error:Type=try lookup<Type>(plan->concrete->types->types,errorId);
 let kindDesc:Int=try descriptor(plan,try present((try atList<Member>(info->members,0))->value,span,"inspection kind"));let identityDesc:Int=try descriptor(plan,try present((try atList<Member>(info->members,1))->value,span,"inspection identity"));let errorKindDesc:Int=try descriptor(plan,try present((try atList<Member>(error->members,0))->value,span,"inspection error kind"));let errorDesc:Int=try descriptor(plan,errorId);let infoDesc:Int=try descriptor(plan,infoId);let resultDesc:Int=try descriptor(plan,resultId);
 var code:Code=try begin(label(initial,76),frame,List<Int>[0],List<Int>[],172);code=acceptArguments(code,1);code=address(code,3,4,64);code=mov(code,7,3);code=immediate(code,0,0);code=immediate(code,1,24);code=raw(code,List<Int>[243,72,171]);code=load(code,0,15,resources);code=store(code,3,0,0);code=store(code,15,resources,3);code=immediate(code,0,-1);code=store(code,3,8,0);code=store(code,3,72,0);
 let invalid:Int=code->nextLabel;let validate:Int=invalid+1;let strip:Int=invalid+2;let terminate:Int=invalid+3;let observe:Int=invalid+4;let osError:Int=invalid+5;let cleanup:Int=invalid+6;let cleaned:Int=invalid+7;let success:Int=invalid+8;let classified:Int=invalid+9;let resultValue:Int=invalid+10;code=fresh(code,11);
 code=load(code,6,5,-72);code=load(code,1,6,24);code=alu(code,133,1,1);code=jump(code,List<Int>[15,132],invalid);code=mov(code,14,1);code=constant(code,0,6,40);code=label(code,validate);code=byteLoad(code,0,6,0);code=alu(code,133,0,0);code=jump(code,List<Int>[15,132],invalid);code=constant(code,0,6,1);code=constant(code,5,1,1);code=jump(code,List<Int>[15,133],validate);
 code=mov(code,7,14);code=constant(code,0,7,1);code=jump(code,List<Int>[15,128],1);code=store(code,3,24,7);code=jump(code,List<Int>[232],60);code=store(code,3,16,0);code=mov(code,7,0);code=load(code,6,5,-72);code=load(code,1,6,24);code=constant(code,0,6,40);code=raw(code,List<Int>[243,164]);
 code=label(code,strip);code=load(code,0,3,16);code=mov(code,1,7);code=alu(code,41,1,0);code=constant(code,7,1,1);code=jump(code,List<Int>[15,134],terminate);code=byteLoad(code,1,7,-1);code=constant(code,7,1,47);code=jump(code,List<Int>[15,133],terminate);code=constant(code,5,7,1);code=jump(code,List<Int>[233],strip);code=label(code,terminate);code=immediate(code,0,0);code=byteStore(code,7,0,0);
 code=label(code,observe);code=immediate(code,7,-100);code=load(code,6,3,16);code=address(code,2,4,256);code=immediate(code,10,256);code=immediate(code,0,262);code=raw(code,List<Int>[15,5]);code=constant(code,7,0,-4);code=jump(code,List<Int>[15,132],observe);code=alu(code,133,0,0);code=jump(code,List<Int>[15,140],osError);code=jump(code,List<Int>[15,133],2);
 code=load(code,0,4,280);code=constant(code,4,0,61440);code=immediate(code,14,3);let kindReady:Int=code->nextLabel;code=fresh(code,4);var ordinal:Int=0;loop over(List<Int>[32768,16384,40960] as mode:Int){code=constant(code,7,0,mode);code=jump(code,List<Int>[15,132],kindReady+ordinal+1);ordinal=ordinal+1;};code=jump(code,List<Int>[233],kindReady);ordinal=0;loop while(ordinal<3){code=label(code,kindReady+ordinal+1);code=immediate(code,14,ordinal);code=jump(code,List<Int>[233],kindReady);ordinal=ordinal+1;};code=label(code,kindReady);code=store(code,3,120,14);code=jump(code,List<Int>[233],cleanup);
 code=label(code,invalid);code=immediate(code,0,0);code=store(code,3,72,0);code=jump(code,List<Int>[233],cleanup);code=label(code,osError);code=constant(code,7,0,-4095);code=jump(code,List<Int>[15,140],2);loop over(List<Int>[9,14,22] as errno:Int){code=constant(code,7,0,-errno);code=jump(code,List<Int>[15,132],2);};code=store(code,3,64,0);
 code=label(code,cleanup);code=mov(code,7,3);code=jump(code,List<Int>[232],61);code=alu(code,133,2,2);code=jump(code,List<Int>[15,133],2);code=alu(code,133,0,0);code=jump(code,List<Int>[15,132],cleaned);code=load(code,1,3,64);code=alu(code,133,1,1);code=jump(code,List<Int>[15,133],cleaned);code=load(code,1,3,72);code=constant(code,7,1,-1);code=jump(code,List<Int>[15,133],cleaned);code=store(code,3,64,0);
 code=label(code,cleaned);code=load(code,0,3,0);code=store(code,15,resources,0);code=load(code,0,3,72);code=constant(code,7,0,-1);code=jump(code,List<Int>[15,133],classified);code=load(code,0,3,64);code=alu(code,133,0,0);code=jump(code,List<Int>[15,132],success);code=constant(code,7,0,-4095);code=jump(code,List<Int>[15,140],2);code=constant(code,7,0,-1);code=jump(code,List<Int>[15,143],2);loop over(List<Int>[9,14,22] as errno:Int){code=constant(code,7,0,-errno);code=jump(code,List<Int>[15,132],2);};
 let errorCases:Int=code->nextLabel;code=fresh(code,5);ordinal=0;loop over(List<List<Int>>[List<Int>[36],List<Int>[2],List<Int>[1,13],List<Int>[20,95],List<Int>[12,23,24,28,122]] as group:List<Int>){loop over(group as errno:Int){code=constant(code,7,0,-errno);code=jump(code,List<Int>[15,132],errorCases+ordinal);};ordinal=ordinal+1;};code=immediate(code,0,7);code=jump(code,List<Int>[233],classified);ordinal=0;loop over(List<Int>[0,2,3,4,6] as kind:Int){code=label(code,errorCases+ordinal);code=immediate(code,0,kind);code=jump(code,List<Int>[233],classified);ordinal=ordinal+1;};
 code=label(code,classified);code=mov(code,14,0);code=allocate(code,40,errorKindDesc);code=store(code,0,24,14);code=store(code,5,-88,0);code=allocate(code,40,errorDesc);code=load(code,2,5,-88);code=store(code,0,24,2);code=load(code,2,5,-72);code=store(code,0,32,2);code=store(code,5,-96,0);code=immediate(code,14,1);code=jump(code,List<Int>[233],resultValue);
 code=label(code,success);code=allocate(code,40,identityDesc);code=load(code,2,4,256);code=store(code,0,24,2);code=load(code,2,4,264);code=store(code,0,32,2);code=store(code,5,-80,0);code=allocate(code,40,kindDesc);code=load(code,2,3,120);code=store(code,0,24,2);code=store(code,5,-88,0);code=allocate(code,40,infoDesc);code=load(code,2,5,-88);code=store(code,0,24,2);code=load(code,2,5,-80);code=store(code,0,32,2);code=store(code,5,-96,0);code=immediate(code,14,0);
 code=label(code,resultValue);code=allocate(code,40,resultDesc);code=store(code,0,24,14);code=load(code,2,5,-96);code=store(code,0,32,2);Result<Code,Diagnostic>::Ok(end(code,frame))
};
public let emit:Function(Code,Native):Result<Code,Diagnostic>=function(initial:Code,plan:Native):Result<Code,Diagnostic>{var code:Code=initial;var selected:Bool=false;loop over(plan->globals->pages->append(plan->globals->tail) as page:List<Global>){loop over(page as global:Global){branch when{global->standard=="inspectPath"=>{try require(!selected,Span{start:0,end:0,line:1,column:1},"duplicate inspection wrapper");selected=true;code=try operation(code,plan,global);},else=>unit};};};code=label(code,172);code=field(code,4,4);code=field(code,4,15);Result<Code,Diagnostic>::Ok(code)};
