namespace Mgnc\WholeInspectionProof;
use Mgnc\Data\{Diagnostic,Span,lookup};
use Mgnc\Syntax\{Parent};
use Mgnc\TypeData\{Type,Member};
use Mgnc\SemanticData\{Declaration,Module};
use Mgnc\WholeNativeData\{Native,Global};
use Mgnc\WholeChecks\{require,present};
use Mgnc\WholeLayout\{argumentType};
use Mgnc\IntMap\{get};
use Mgnc\Tables\{atList};
let nominal:Function(Native,Int,String,Int,Int):Result<Type,Diagnostic>=function(plan:Native,id:Int,name:String,kind:Int,count:Int):Result<Type,Diagnostic>{let span:Span=Span{start:0,end:0,line:1,column:1};let value:Type=try lookup<Type>(plan->concrete->types->types,id);let declaration:Declaration=try lookup<Declaration>(plan->concrete->types->headers->declarations,try present(value->owner,span,"inspection nominal owner"));let module:Module=try lookup<Module>(plan->concrete->types->headers->modules,declaration->file);try require(value->kind==kind&&value->arguments->length()==0&&value->members->length()==count&&module->standard&&module->nameSpace=="Std\\Io"&&declaration->name==name,span,"inspection nominal identity: "+name);Result<Type,Diagnostic>::Ok(value)};
let member:Function(Type,Int,String,Span):Result<Int,Diagnostic>=function(value:Type,index:Int,name:String,span:Span):Result<Int,Diagnostic>{let field:Member=try atList<Member>(value->members,index);try require(field->name==name,span,"inspection field name");present(field->value,span,"inspection field type")};
let variants:Function(Type,List<String>,Span):Result<Unit,Diagnostic>=function(value:Type,names:List<String>,span:Span):Result<Unit,Diagnostic>{var index:Int=0;loop over(names as name:String){let field:Member=try atList<Member>(value->members,index);try require(field->name==name,span,"inspection variant name");branch on field->value{Parent::None=>unit,Parent::Some(id:Int)=>{try require(false,span,"inspection variant payload");}};index=index+1;};Result<Unit,Diagnostic>::Ok(unit)};
public let signature:Function(Native,Global):Result<Int,Diagnostic>=function(plan:Native,global:Global):Result<Int,Diagnostic>{
 let span:Span=Span{start:0,end:0,line:1,column:1};let value:Type=try lookup<Type>(plan->concrete->types->types,global->valueType);try require(value->kind==12&&value->arguments->length()==2&&(try argumentType(value,0,span))==3,span,"inspection Function signature");let result:Type=try lookup<Type>(plan->concrete->types->types,try argumentType(value,1,span));try require(result->kind==11&&result->arguments->length()==2,span,"inspection Result signature");let info:Type=try nominal(plan,try argumentType(result,0,span),"PathInfo",20,2);let kind:Type=try nominal(plan,try member(info,0,"kind",span),"DirectoryEntryKind",21,4);try variants(kind,List<String>["File","Directory","Symlink","Other"],span);discard try nominal(plan,try member(info,1,"identity",span),"FileIdentity",26,0);
 let error:Type=try nominal(plan,try argumentType(result,1,span),"PathInfoError",20,2);try require((try member(error,1,"subject",span))==3,span,"inspection original subject type");let errorKind:Type=try nominal(plan,try member(error,0,"kind",span),"IoErrorKind",21,8);try variants(errorKind,List<String>["InvalidPath","InvalidEncoding","NotFound","PermissionDenied","UnsupportedTarget","BrokenPipe","ResourceExhausted","Other"],span);Result<Int,Diagnostic>::Ok(76)
};
public let descriptors:Function(Native,Global):Result<List<Int>,Diagnostic>=function(plan:Native,global:Global):Result<List<Int>,Diagnostic>{discard try signature(plan,global);let span:Span=Span{start:0,end:0,line:1,column:1};let functionType:Type=try lookup<Type>(plan->concrete->types->types,global->valueType);let resultId:Int=try argumentType(functionType,1,span);let result:Type=try lookup<Type>(plan->concrete->types->types,resultId);let infoId:Int=try argumentType(result,0,span);let errorId:Int=try argumentType(result,1,span);let info:Type=try lookup<Type>(plan->concrete->types->types,infoId);let error:Type=try lookup<Type>(plan->concrete->types->types,errorId);var found:List<Int>=List<Int>[];loop over(List<Int>[try member(error,0,"kind",span),errorId,try member(info,1,"identity",span),try member(info,0,"kind",span),infoId,resultId] as id:Int){let descriptor:Int=try get(plan->layouts->types,id);try require(descriptor>=0,span,"inspection allocation descriptor");found=found->append(descriptor);};Result<List<Int>,Diagnostic>::Ok(found)};
