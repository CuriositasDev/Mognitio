namespace Mgnc;
use Mgnc\Data\{Paged,Span,Diagnostic,empty,push,lookup,number};
use Mgnc\InputData\{SourceUnit,ProjectInput,InputError};
use Mgnc\Semantic\{SemanticProject,analyze};
use Mgnc\WholeIR\{Project};
use Mgnc\WholeLower\{lower};
use Mgnc\WholePipeline\{prepare};
use Mgnc\WholeNativeData\{Native,Literal,Constructor,Procedure};
use Mgnc\WholeNativeCheck\{verify as verifyPlan};
use Mgnc\WholeNativeEmit\{emit};
use Mgnc\WholeMachineCheck\{verify as verifyMachine};
use Mgnc\WholeChecks\{require};
use Mgnc\Machine\{Code,Record,flush};
use Mgnc\Tables\{replaceItem,atList};
use Std\Io\{writeStdout};
let reject:Function(Result<Unit,Diagnostic>,String):Result<Unit,Diagnostic>=function(result:Result<Unit,Diagnostic>,expected:String):Result<Unit,Diagnostic>{
 let span:Span=Span{start:0,end:0,line:1,column:1};
 branch on result{Result<Unit,Diagnostic>::Ok(value:Unit)=>{try require(false,span,"mutant accepted");},Result<Unit,Diagnostic>::Err(error:Diagnostic)=>{try require(error->phase=="internal"&&error->message=="whole IR: "+expected,span,"wrong mutation detector: "+expected+" got "+error->message);discard writeStdout("MUTANT "+expected+"\n");}};
 Result<Unit,Diagnostic>::Ok(unit)
};
let test:Function():Result<Unit,Diagnostic>=function():Result<Unit,Diagnostic>{
 let span:Span=Span{start:0,end:0,line:1,column:1};
let input:SourceUnit=SourceUnit{path:"input.mgn",displayPath:"input.mgn",relativePath:"input.mgn",expectedNamespace:"",text:"namespace App;use Std\\Io\\{writeStdout};type Pair=product{s:String;f:Function(Int):Int;};let text:String=\"hi日\";let main:Function(List<String>):Int=function(args:List<String>):Int{let base:Int=3;let p:Pair=Pair{s:text,f:function(x:Int):Int{base+x}};let list:List<String>=List<String>[p->s];discard writeStdout(list->join(\"\"));p->f(list->length())};"};
let semantic:SemanticProject=branch on analyze(ProjectInput{manifestPath:"",manifestText:"",rootNamespace:"",entry:0,sources:List<SourceUnit>[input]}){Result<SemanticProject,InputError>::Ok(value:SemanticProject)=>value,Result<SemanticProject,InputError>::Err(error:InputError)=>{return Result<Unit,Diagnostic>::Err(error->diagnostic);}};
let source:Project=try lower(semantic);let plan:Native=try prepare(semantic);try verifyPlan(semantic,source,plan);
let code:Code=flush(try emit(plan));try verifyMachine(plan,code);
let literal:Literal=try lookup<Literal>(plan->literals,0);
try reject(verifyPlan(semantic,source,Native{concrete:plan->concrete,closures:plan->closures,layouts:plan->layouts,procedures:plan->procedures,literals:plan->literals,constructors:empty<Constructor>(),globals:plan->globals,globalSymbols:plan->globalSymbols,globalDeclarations:plan->globalDeclarations,globalRoots:plan->globalRoots,initializers:plan->initializers,modules:plan->modules,moduleCount:plan->moduleCount,descriptors:plan->descriptors,variants:plan->variants,entryGlobal:plan->entryGlobal,nextLabel:plan->nextLabel}),"constructor source membership");
try reject(verifyPlan(semantic,source,Native{concrete:plan->concrete,closures:plan->closures,layouts:plan->layouts,procedures:plan->procedures,literals:plan->literals,constructors:plan->constructors,globals:plan->globals,globalSymbols:plan->globalSymbols,globalDeclarations:plan->globalDeclarations,globalRoots:plan->globalRoots,initializers:plan->initializers,modules:List<Int>[],moduleCount:plan->moduleCount,descriptors:plan->descriptors,variants:plan->variants,entryGlobal:plan->entryGlobal,nextLabel:plan->nextLabel}),"runtime module initialization order");
try reject(verifyPlan(semantic,source,Native{concrete:plan->concrete,closures:plan->closures,layouts:plan->layouts,procedures:plan->procedures,literals:plan->literals,constructors:plan->constructors,globals:plan->globals,globalSymbols:plan->globalSymbols,globalDeclarations:plan->globalDeclarations,globalRoots:plan->globalRoots,initializers:plan->initializers,modules:plan->modules,moduleCount:plan->moduleCount,descriptors:plan->descriptors,variants:plan->variants,entryGlobal:-1,nextLabel:plan->nextLabel}),"native main identity");
try reject(verifyPlan(semantic,source,Native{concrete:plan->concrete,closures:plan->closures,layouts:plan->layouts,procedures:plan->procedures,literals:plan->literals,constructors:plan->constructors,globals:plan->globals,globalSymbols:plan->globalSymbols,globalDeclarations:plan->globalDeclarations,globalRoots:plan->globalRoots,initializers:plan->initializers,modules:plan->modules,moduleCount:plan->moduleCount,descriptors:plan->descriptors,variants:push<List<Int>>(plan->variants,List<Int>[]),entryGlobal:plan->entryGlobal,nextLabel:plan->nextLabel}),"descriptor label membership");
try reject(verifyPlan(semantic,source,Native{concrete:plan->concrete,closures:plan->closures,layouts:plan->layouts,procedures:plan->procedures,literals:plan->literals,constructors:plan->constructors,globals:plan->globals,globalSymbols:plan->globalSymbols,globalDeclarations:plan->globalDeclarations,globalRoots:plan->globalRoots,initializers:plan->initializers,modules:plan->modules,moduleCount:plan->moduleCount,descriptors:empty<Int>(),variants:plan->variants,entryGlobal:plan->entryGlobal,nextLabel:plan->nextLabel}),"descriptor label membership");
try reject(verifyPlan(semantic,source,Native{concrete:plan->concrete,closures:plan->closures,layouts:plan->layouts,procedures:plan->procedures,literals:try replaceItem<Literal>(plan->literals,0,Literal{instance:literal->instance,block:literal->block,operation:literal->operation,label:literal->label,bytes:List<Int>[255],scalars:1}),constructors:plan->constructors,globals:plan->globals,globalSymbols:plan->globalSymbols,globalDeclarations:plan->globalDeclarations,globalRoots:plan->globalRoots,initializers:plan->initializers,modules:plan->modules,moduleCount:plan->moduleCount,descriptors:plan->descriptors,variants:plan->variants,entryGlobal:plan->entryGlobal,nextLabel:plan->nextLabel}),"literal UTF-8 leading byte");
try reject(verifyPlan(semantic,source,Native{concrete:plan->concrete,closures:plan->closures,layouts:plan->layouts,procedures:plan->procedures,literals:try replaceItem<Literal>(plan->literals,0,Literal{instance:literal->instance,block:literal->block,operation:literal->operation,label:literal->label,bytes:literal->bytes,scalars:literal->scalars+1}),constructors:plan->constructors,globals:plan->globals,globalSymbols:plan->globalSymbols,globalDeclarations:plan->globalDeclarations,globalRoots:plan->globalRoots,initializers:plan->initializers,modules:plan->modules,moduleCount:plan->moduleCount,descriptors:plan->descriptors,variants:plan->variants,entryGlobal:plan->entryGlobal,nextLabel:plan->nextLabel}),"literal UTF-8 count");
try reject(verifyPlan(semantic,source,Native{concrete:plan->concrete,closures:plan->closures,layouts:plan->layouts,procedures:plan->procedures,literals:try replaceItem<Literal>(plan->literals,0,Literal{instance:literal->instance,block:literal->block,operation:literal->operation,label:literal->label,bytes:List<Int>[120,120,120],scalars:3}),constructors:plan->constructors,globals:plan->globals,globalSymbols:plan->globalSymbols,globalDeclarations:plan->globalDeclarations,globalRoots:plan->globalRoots,initializers:plan->initializers,modules:plan->modules,moduleCount:plan->moduleCount,descriptors:plan->descriptors,variants:plan->variants,entryGlobal:plan->entryGlobal,nextLabel:plan->nextLabel}),"literal source scalar");
let procedure:Procedure=try lookup<Procedure>(plan->procedures,0);
var index:Int=0;var entry:Int= -1;var reference:Int= -1;var rootReference:Int= -1;
loop over(code->records->pages->append(code->records->tail) as page:List<Record>){loop over(page as record:Record){
 branch when{record->kind==1&&record->target==procedure->entry=>{entry=index+1;},record->kind==2&&reference<0=>{reference=index;},else=>unit};
 branch when{record->kind==5&&record->bytes->length()>=2&&rootReference<0=>{loop over(plan->procedures->pages->append(plan->procedures->tail) as ps:List<Procedure>){loop over(ps as proc:Procedure){loop over(proc->pointLabels->pages->append(proc->pointLabels->tail) as labels:List<Int>){loop over(labels as label:Int){branch when{record->target==label=>{rootReference=index;},else=>unit};};};};};},else=>unit};
 index=index+1;
};};
try require(entry>=0&&reference>=0&&rootReference>=0,span,"machine mutation targets");
let first:Record=try lookup<Record>(code->records,entry);
let broken:Record=Record{kind:first->kind,bytes:List<Int>[0],value:first->value,target:first->target};
try reject(verifyMachine(plan,Code{records:try replaceItem<Record>(code->records,entry,broken),nextLabel:code->nextLabel,pending:code->pending}),"source callee-save prologue");
let linked:Record=try lookup<Record>(code->records,reference);
let unresolved:Record=Record{kind:linked->kind,bytes:linked->bytes,value:linked->value,target:code->nextLabel+10};
try reject(verifyMachine(plan,Code{records:try replaceItem<Record>(code->records,reference,unresolved),nextLabel:code->nextLabel,pending:code->pending}),"unlinked machine reference");
let rooted:Record=try lookup<Record>(code->records,rootReference);
let wrong:Record=Record{kind:rooted->kind,bytes:rooted->bytes,value:rooted->value,target:procedure->entryRoots};
try reject(verifyMachine(plan,Code{records:try replaceItem<Record>(code->records,rootReference,wrong),nextLabel:code->nextLabel,pending:code->pending}),"allocation root descriptor handoff");
discard writeStdout("V160_NATIVE_VERIFIERS_OK valid=2 rejected=11\n");Result<Unit,Diagnostic>::Ok(unit)
};
let main:Function(List<String>):Int=function(args:List<String>):Int{branch on test(){Result<Unit,Diagnostic>::Ok(value:Unit)=>0,Result<Unit,Diagnostic>::Err(error:Diagnostic)=>{discard writeStdout(error->phase+": "+error->message+"\n");1}}};
