namespace Mgnc\WholeNativeEmit;
use Mgnc\WholeDirectory\{emit as directory};
use Mgnc\WholePathFunctions\{emit as paths};
use Mgnc\WholeInspection\{emit as inspection};
use Mgnc\WholePublication\{emit as publication};
use Mgnc\WholeBinaryFrom\{emit as binaryFrom};
use Mgnc\WholeBinaryEncoding\{emit as binaryEncoding};
use Mgnc\WholeBytesSlice\{emit as bytesSlice};
use Mgnc\WholeNumericResult\{emit as numericResult};
use Mgnc\Data\{Diagnostic,empty};
use Mgnc\Machine\{Code,Record};
use Mgnc\WholeNativeData\{Native};
use Mgnc\SuitePlan\{Mode,Suite};
use Mgnc\SuiteStartup\{emit as testStartup};
use Mgnc\SuiteMachine\{offset as suiteOffset};
use Mgnc\WholeNativeStartup\{emit as startup};
use Mgnc\WholeNativeBodies\{emit as bodies};
use Mgnc\WholeNativeConstruct\{emit as constructors};
use Mgnc\WholeNativeTables\{emit as tables};
use Mgnc\WholeArena\{emit as arena};
use Mgnc\WholeMark\{emit as mark};
use Mgnc\WholeSweep\{emit as sweep};
use Mgnc\WholeCollect\{emit as collect};
use Mgnc\WholeText\{emit as text};
use Mgnc\WholeBounds\{emit as bounds};
use Mgnc\WholeUtf8\{emit as utf8};
use Mgnc\WholeUtf8Feed\{emit as feed};
use Mgnc\WholeIoResource\{emit as resources};
use Mgnc\WholeIo\{emit as io};
use Mgnc\WholeTerminal\{emit as terminal};
// Terminal handlers are supplied by the runtime linker.
public let emitMode:Function(Native,Mode):Result<Code,Diagnostic>=function(plan:Native,mode:Mode):Result<Code,Diagnostic>{
 var code:Code=Code{records:empty<Record>(),nextLabel:plan->nextLabel,pending:List<Int>[]};
 var testBase:Int= -1;
 branch on mode{Mode::Ordinary=>{code=try startup(code,plan,false);},Mode::Application=>{code=try startup(code,plan,true);},Mode::Testing(suite:Suite)=>{testBase=suiteOffset(plan);code=try testStartup(code,plan,suite);}};
 code=try bodies(code,plan,mode);code=try constructors(code,plan);code=try numericResult(try text(try bounds(code)));code=try bytesSlice(try binaryEncoding(code));code=try paths(code,plan);code=try directory(code,plan);code=try inspection(code,plan);code=try publication(code,plan);code=try binaryFrom(code,plan);code=try io(code,plan);code=feed(resources(code));code=utf8(collect(sweep(mark(arena(code)))));tables(terminal(code,testBase),plan)
};
public let emit:Function(Native):Result<Code,Diagnostic>=function(plan:Native):Result<Code,Diagnostic>{emitMode(plan,Mode::Ordinary)};
