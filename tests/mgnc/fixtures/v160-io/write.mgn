namespace App;
use Std\Io\{readTextFile,writeTextFile,readStdin,writeStdout,writeStderr,IoError,IoOperation,IoErrorKind,IoErrorPhase};
let code:Function(IoError):Int=function(error:IoError):Int{
 let k:Int=branch on error->kind{IoErrorKind::InvalidPath=>0,IoErrorKind::InvalidEncoding=>1,IoErrorKind::NotFound=>2,IoErrorKind::PermissionDenied=>3,IoErrorKind::UnsupportedTarget=>4,IoErrorKind::BrokenPipe=>5,IoErrorKind::ResourceExhausted=>6,IoErrorKind::Other=>7};
 let p:Int=branch on error->phase{IoErrorPhase::Input=>0,IoErrorPhase::Target=>1,IoErrorPhase::Body=>2,IoErrorPhase::Cleanup=>3};k+p*16+64
};
let main:Function(List<String>):Int=function(args:List<String>):Int{let path:String=branch on args->at(0){Result<String,IndexError>::Ok(value:String)=>value,Result<String,IndexError>::Err(error:IndexError)=>panic{"path"}};branch on writeTextFile(path,"new 日本😀\u{0}\r\n"){Result<Unit,IoError>::Ok(value:Unit)=>0,Result<Unit,IoError>::Err(error:IoError)=>branch when{error->subject==path=>code(error),else=>12}}};
