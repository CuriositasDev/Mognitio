lane==10=>Lexeme{kind:page->kind10,text:page->text10,start:page->start10,end:page->end10,line:page->line10,column:page->column10,scalarStart:page->scalarStart10,scalarEnd:page->scalarEnd10,endLine:page->endLine10,endColumn:page->endColumn10},
lane==11=>Lexeme{kind:page->kind11,text:page->text11,start:page->start11,end:page->end11,line:page->line11,column:page->column11,scalarStart:page->scalarStart11,scalarEnd:page->scalarEnd11,endLine:page->endLine11,endColumn:page->endColumn11},
