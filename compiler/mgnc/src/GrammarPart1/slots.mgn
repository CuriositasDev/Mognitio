 Slot{lhs:11,rule:22,dot:6,next:0},
 Slot{lhs:11,rule:23,dot:0,next:-16},
 Slot{lhs:11,rule:23,dot:1,next:-3},
 Slot{lhs:11,rule:23,dot:2,next:13},
 Slot{lhs:11,rule:23,dot:3,next:-12},
 Slot{lhs:11,rule:23,dot:4,next:31},
 Slot{lhs:11,rule:23,dot:5,next:-2},
 Slot{lhs:11,rule:23,dot:6,next:0},
 Slot{lhs:12,rule:24,dot:0,next:0},
 Slot{lhs:12,rule:25,dot:0,next:13},
 Slot{lhs:12,rule:25,dot:1,next:0},
 Slot{lhs:13,rule:26,dot:0,next:-17},
 Slot{lhs:13,rule:26,dot:1,next:14},
 Slot{lhs:13,rule:26,dot:2,next:-18},
 Slot{lhs:13,rule:26,dot:3,next:0},
 Slot{lhs:14,rule:27,dot:0,next:16},
