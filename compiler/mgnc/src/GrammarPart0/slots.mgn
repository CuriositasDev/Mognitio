namespace Mgnc\GrammarPart0;
use Mgnc\Data\{Paged,push};
use Mgnc\GrammarData\{Slot};
// Generated fixed grammar slots; every part is included in the C1 inventory.
public let extend:Function(Paged<Slot>):Paged<Slot>=function(initial:Paged<Slot>):Paged<Slot>{
 var result:Paged<Slot>=initial;
 loop over(List<Slot>[
 Slot{lhs:1,rule:0,dot:0,next:2},
 Slot{lhs:1,rule:0,dot:1,next:4},
 Slot{lhs:1,rule:0,dot:2,next:9},
 Slot{lhs:1,rule:0,dot:3,next:0},
 Slot{lhs:2,rule:1,dot:0,next:-1},
 Slot{lhs:2,rule:1,dot:1,next:3},
 Slot{lhs:2,rule:1,dot:2,next:-2},
 Slot{lhs:2,rule:1,dot:3,next:0},
 Slot{lhs:3,rule:2,dot:0,next:-3},
 Slot{lhs:3,rule:2,dot:1,next:0},
 Slot{lhs:3,rule:3,dot:0,next:3},
 Slot{lhs:3,rule:3,dot:1,next:-4},
 Slot{lhs:3,rule:3,dot:2,next:-3},
 Slot{lhs:3,rule:3,dot:3,next:0},
 Slot{lhs:4,rule:4,dot:0,next:0},
 Slot{lhs:4,rule:5,dot:0,next:4},
 Slot{lhs:4,rule:5,dot:1,next:5},
 Slot{lhs:4,rule:5,dot:2,next:0},
 Slot{lhs:5,rule:6,dot:0,next:-5},
 Slot{lhs:5,rule:6,dot:1,next:3},
 Slot{lhs:5,rule:6,dot:2,next:-4},
 Slot{lhs:5,rule:6,dot:3,next:-6},
 Slot{lhs:5,rule:6,dot:4,next:6},
 Slot{lhs:5,rule:6,dot:5,next:-7},
 Slot{lhs:5,rule:6,dot:6,next:-2},
 Slot{lhs:5,rule:6,dot:7,next:0},
 Slot{lhs:6,rule:7,dot:0,next:8},
 Slot{lhs:6,rule:7,dot:1,next:7},
 Slot{lhs:6,rule:7,dot:2,next:0},
 Slot{lhs:7,rule:8,dot:0,next:0},
 Slot{lhs:7,rule:9,dot:0,next:-8},
 Slot{lhs:7,rule:9,dot:1,next:0},
 Slot{lhs:7,rule:10,dot:0,next:-8},
 Slot{lhs:7,rule:10,dot:1,next:8},
 Slot{lhs:7,rule:10,dot:2,next:7},
 Slot{lhs:7,rule:10,dot:3,next:0},
 Slot{lhs:8,rule:11,dot:0,next:-3},
 Slot{lhs:8,rule:11,dot:1,next:0},
 Slot{lhs:8,rule:12,dot:0,next:-3},
 Slot{lhs:8,rule:12,dot:1,next:-9},
 Slot{lhs:8,rule:12,dot:2,next:-3},
 Slot{lhs:8,rule:12,dot:3,next:0},
 Slot{lhs:9,rule:13,dot:0,next:0},
 Slot{lhs:9,rule:14,dot:0,next:9},
 Slot{lhs:9,rule:14,dot:1,next:10},
 Slot{lhs:9,rule:14,dot:2,next:0},
 Slot{lhs:10,rule:15,dot:0,next:11},
 Slot{lhs:10,rule:15,dot:1,next:0},
 Slot{lhs:10,rule:16,dot:0,next:29},
 Slot{lhs:10,rule:16,dot:1,next:0},
 Slot{lhs:10,rule:17,dot:0,next:30},
 Slot{lhs:10,rule:17,dot:1,next:0},
 Slot{lhs:10,rule:18,dot:0,next:-10},
 Slot{lhs:10,rule:18,dot:1,next:11},
 Slot{lhs:10,rule:18,dot:2,next:0},
 Slot{lhs:10,rule:19,dot:0,next:-10},
 Slot{lhs:10,rule:19,dot:1,next:29},
 Slot{lhs:10,rule:19,dot:2,next:0},
 Slot{lhs:11,rule:20,dot:0,next:-11},
 Slot{lhs:11,rule:20,dot:1,next:-3},
 Slot{lhs:11,rule:20,dot:2,next:12},
 Slot{lhs:11,rule:20,dot:3,next:-12},
 Slot{lhs:11,rule:20,dot:4,next:-13},
 Slot{lhs:11,rule:20,dot:5,next:-6},
 ] as value:Slot){result=push<Slot>(result,value);};
 result
};
