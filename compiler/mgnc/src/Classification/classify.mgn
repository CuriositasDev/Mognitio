namespace Mgnc\Classification;
use Mgnc\PruneMemo\{Map as IntMap,create as createMap,get as mapGet,put as mapPut};
use Mgnc\Data\{Paged,empty,push,lookup,Diagnostic,Span,problem};
use Mgnc\Tables\{replaceItem,atList};
use Mgnc\Forest\{SyntaxForest};
use Mgnc\ForestData\{ForestNode};
use Mgnc\NodeStorage\{NodeStore,emptyNodes,addNode,getNode};
use Mgnc\Projection\{parts,item,text,failure};
use Mgnc\BridgeShape\{Binding,runtimeName};
use Mgnc\Grammar\{ruleBlock,ruleLetBinding,ruleVarBinding,ruleGenericApply};
// The parse forest is immutable. Only build evaluates declaration guards.
public let genericGuards:Function(SyntaxForest):Result<List<Int>,Diagnostic>=function(tree:SyntaxForest):Result<List<Int>,Diagnostic>{
 var index:Int=0;var starts:List<Int>=List<Int>[];
 loop while(index<tree->nodes->count){let node:ForestNode=try getNode(tree->nodes,index);branch when{node->symbol>0&&node->rule==ruleGenericApply=>{starts=starts->append(node->start);},else=>unit};index=index+1;};
 Result<List<Int>,Diagnostic>::Ok(starts)
};
type Visit=product{id:Int;block:Int;};
// Compact append-only traversal frames. Sealed pages contain only scalar IDs.
type PruneFrame=product{id:Int;parent:Int;};
type PrunePage=product{id0:Int;parent0:Int;id1:Int;parent1:Int;id2:Int;parent2:Int;id3:Int;parent3:Int;id4:Int;parent4:Int;id5:Int;parent5:Int;id6:Int;parent6:Int;id7:Int;parent7:Int;};
type PruneStack=product{pages:Paged<PrunePage>;tail:List<PruneFrame>;count:Int;};
let emptyPruneStack:Function():PruneStack=function():PruneStack{
 PruneStack{pages:empty<PrunePage>(),tail:List<PruneFrame>[],count:0}
};
let packPrunePage:Function(List<PruneFrame>):PrunePage=function(values:List<PruneFrame>):PrunePage{
 let frame0:PruneFrame=branch on values->at(0){Result<PruneFrame,IndexError>::Ok(value:PruneFrame)=>value,Result<PruneFrame,IndexError>::Err(error:IndexError)=>panic{"incomplete prune page"}};
 let frame1:PruneFrame=branch on values->at(1){Result<PruneFrame,IndexError>::Ok(value:PruneFrame)=>value,Result<PruneFrame,IndexError>::Err(error:IndexError)=>panic{"incomplete prune page"}};
 let frame2:PruneFrame=branch on values->at(2){Result<PruneFrame,IndexError>::Ok(value:PruneFrame)=>value,Result<PruneFrame,IndexError>::Err(error:IndexError)=>panic{"incomplete prune page"}};
 let frame3:PruneFrame=branch on values->at(3){Result<PruneFrame,IndexError>::Ok(value:PruneFrame)=>value,Result<PruneFrame,IndexError>::Err(error:IndexError)=>panic{"incomplete prune page"}};
 let frame4:PruneFrame=branch on values->at(4){Result<PruneFrame,IndexError>::Ok(value:PruneFrame)=>value,Result<PruneFrame,IndexError>::Err(error:IndexError)=>panic{"incomplete prune page"}};
 let frame5:PruneFrame=branch on values->at(5){Result<PruneFrame,IndexError>::Ok(value:PruneFrame)=>value,Result<PruneFrame,IndexError>::Err(error:IndexError)=>panic{"incomplete prune page"}};
 let frame6:PruneFrame=branch on values->at(6){Result<PruneFrame,IndexError>::Ok(value:PruneFrame)=>value,Result<PruneFrame,IndexError>::Err(error:IndexError)=>panic{"incomplete prune page"}};
 let frame7:PruneFrame=branch on values->at(7){Result<PruneFrame,IndexError>::Ok(value:PruneFrame)=>value,Result<PruneFrame,IndexError>::Err(error:IndexError)=>panic{"incomplete prune page"}};
 PrunePage{id0:frame0->id,parent0:frame0->parent,id1:frame1->id,parent1:frame1->parent,id2:frame2->id,parent2:frame2->parent,id3:frame3->id,parent3:frame3->parent,id4:frame4->id,parent4:frame4->parent,id5:frame5->id,parent5:frame5->parent,id6:frame6->id,parent6:frame6->parent,id7:frame7->id,parent7:frame7->parent}
};
let pushPruneFrame:Function(PruneStack,PruneFrame):PruneStack=function(stack:PruneStack,frame:PruneFrame):PruneStack{
 var pages:Paged<PrunePage>=stack->pages;var tail:List<PruneFrame>=stack->tail;
 branch when{tail->length()==8=>{pages=push<PrunePage>(pages,packPrunePage(tail));tail=List<PruneFrame>[];},else=>unit};
 PruneStack{pages:pages,tail:tail->append(frame),count:stack->count+1}
};
let pruneFrameAt:Function(PruneStack,Int):Result<PruneFrame,Diagnostic>=function(stack:PruneStack,index:Int):Result<PruneFrame,Diagnostic>{
 branch when{index<0||index>=stack->count=>{return Result<PruneFrame,Diagnostic>::Err(problem("internal",Span{start:0,end:0,line:1,column:1},"invalid prune frame index"));},else=>unit};
 branch when{index/8==stack->pages->count=>{return atList<PruneFrame>(stack->tail,index%8);},else=>unit};
 let page:PrunePage=try lookup<PrunePage>(stack->pages,index/8);let lane:Int=index%8;
 Result<PruneFrame,Diagnostic>::Ok(branch when{
  lane==0=>PruneFrame{id:page->id0,parent:page->parent0},
  lane==1=>PruneFrame{id:page->id1,parent:page->parent1},
  lane==2=>PruneFrame{id:page->id2,parent:page->parent2},
  lane==3=>PruneFrame{id:page->id3,parent:page->parent3},
  lane==4=>PruneFrame{id:page->id4,parent:page->parent4},
  lane==5=>PruneFrame{id:page->id5,parent:page->parent5},
  lane==6=>PruneFrame{id:page->id6,parent:page->parent6},
  else=>PruneFrame{id:page->id7,parent:page->parent7},
 })
};
public let prune:Function(SyntaxForest,Int,List<Int>):Result<SyntaxForest,Diagnostic>=function(tree:SyntaxForest,root:Int,rejected:List<Int>):Result<SyntaxForest,Diagnostic>{
 var memo:IntMap=createMap();var excluded:IntMap=createMap();let hasRejected:Bool=rejected->length()>0;
 loop over(rejected as id:Int){excluded=try mapPut(excluded,id,1);};
 var nodes:NodeStore=emptyNodes();var stack:PruneStack=pushPruneFrame(emptyPruneStack(),PruneFrame{id:root,parent:-1});var active:Int=0;
 // Memoized postorder over the shared DAG; a dead child invalidates its parent family,
 // while a surviving alternative remains available to every parent referencing it.
 loop while(active>=0){
  let frame:PruneFrame=try pruneFrameAt(stack,active);let workId:Int=frame->id;let workParent:Int=frame->parent;let node:ForestNode=try getNode(tree->nodes,workId);var missing:Int=-1;
  branch when{
   node->left>=0&&(try mapGet(memo,node->left))== -2=>{missing=node->left;},
   node->right>=0&&(try mapGet(memo,node->right))== -2=>{missing=node->right;},
   node->alternatives>=0&&(try mapGet(memo,node->alternatives))== -2=>{missing=node->alternatives;},
   else=>unit
  };
  branch when{missing>=0=>{stack=pushPruneFrame(stack,PruneFrame{id:missing,parent:active});active=stack->count-1;continue;},else=>unit};
  let left:Int=branch when{node->left>=0=>try mapGet(memo,node->left),else=> -1};
  let right:Int=branch when{node->right>=0=>try mapGet(memo,node->right),else=> -1};
  let alternative:Int=branch when{node->alternatives>=0=>try mapGet(memo,node->alternatives),else=> -1};
  var live:Bool=(node->left<0||left>=0)&&(node->right<0||right>=0);
  branch when{hasRejected&&(try mapGet(excluded,workId))==1=>{live=false;},else=>unit};
  var result:Int=alternative;
  branch when{live=>{result=nodes->count;nodes=addNode(nodes,ForestNode{symbol:node->symbol,slot:node->slot,start:node->start,end:node->end,rule:node->rule,left:left,right:right,split:node->split,alternatives:alternative});},else=>unit};
  // Alternative records carry only a family (symbol -1000); promotion retains
  // the owning symbol/prefix span, rather than treating that record as a terminal.
  branch when{!live&&alternative>=0&&node->symbol!= -1000=>{
   let choice:ForestNode=try getNode(nodes,alternative);result=nodes->count;
   nodes=addNode(nodes,ForestNode{symbol:node->symbol,slot:node->slot,start:node->start,end:node->end,rule:choice->rule,left:choice->left,right:choice->right,split:choice->split,alternatives:choice->alternatives});
  },else=>unit};
  memo=try mapPut(memo,workId,result);active=workParent;
 };
 Result<SyntaxForest,Diagnostic>::Ok(SyntaxForest{source:tree->source,nodes:nodes,root:try mapGet(memo,root),itemCount:tree->itemCount,comparisons:tree->comparisons})
};
public let classify:Function(SyntaxForest,Int,List<Binding>):Result<SyntaxForest,Diagnostic>=function(tree:SyntaxForest,root:Int,visible:List<Binding>):Result<SyntaxForest,Diagnostic>{
 var seen:Paged<Bool>=empty<Bool>();var index:Int=0;
 loop while(index<tree->nodes->count){seen=push<Bool>(seen,false);index=index+1;};
 var visits:Paged<Visit>=push<Visit>(empty<Visit>(),Visit{id:root,block:root});var bindings:List<Binding>=visible;var generic:List<Int>=List<Int>[];index=0;
 // Declaration visibility is a source interval: after the initializer, before its block ends.
 // Traverse retained families without selecting an expression interpretation first.
 loop while(index<visits->count){
  let visit:Visit=try lookup<Visit>(visits,index);index=index+1;
  branch when{try lookup<Bool>(seen,visit->id)=>{continue;},else=>unit};seen=try replaceItem<Bool>(seen,visit->id,true);
  let node:ForestNode=try getNode(tree->nodes,visit->id);
  let block:Int=branch when{node->symbol>0&&node->rule==ruleBlock=>visit->id,else=>visit->block};
  branch when{node->symbol>0&&(node->rule==ruleLetBinding||node->rule==ruleVarBinding)=>{
   let children:List<Int>=try parts(tree,visit->id);let scope:ForestNode=try getNode(tree->nodes,block);
   bindings=bindings->append(Binding{name:try text(tree,try item(children,1)),after:node->end,until:scope->end});
  },else=>unit};
  branch when{node->symbol>0&&node->rule==ruleGenericApply=>{generic=generic->append(visit->id);},else=>unit};
  loop over(List<Int>[node->left,node->right,node->alternatives] as child:Int){branch when{child>=0=>{visits=push<Visit>(visits,Visit{id:child,block:block});},else=>unit};};
 };
 var rejected:List<Int>=List<Int>[];var unresolved:List<Int>=List<Int>[];
 loop over(generic as id:Int){let node:ForestNode=try getNode(tree->nodes,id);branch when{runtimeName(bindings,try text(tree,id),node->start)=>{rejected=rejected->append(id);},else=>{unresolved=unresolved->append(id);}};};
 let classified:SyntaxForest=branch when{rejected->length()>0=>try prune(tree,root,rejected),else=>SyntaxForest{source:tree->source,nodes:tree->nodes,root:root,itemCount:tree->itemCount,comparisons:tree->comparisons}};
 let selected:Int=classified->root;
 branch when{selected<0=>{
  let id:Int=try item(rejected,0);let application:List<Int>=try parts(tree,id);let arguments:List<Int>=try parts(tree,try item(application,1));
  return Result<SyntaxForest,Diagnostic>::Err(try failure(tree,try item(arguments,2),"parse","comparison operators do not chain"));
 },else=>unit};
 // An unresolved guard must not become a new runtime/template classification.
 // If removing generic candidates exposes a complete native derivation, choosing
 // between those interpretations requires the missing declaration: report its name.
 branch when{unresolved->length()>0=>{
  var excluded:List<Int>=rejected;loop over(unresolved as id:Int){excluded=excluded->append(id);};
  let native:SyntaxForest=try prune(tree,root,excluded);
  branch when{native->root>=0=>{return Result<SyntaxForest,Diagnostic>::Err(try failure(tree,try item(unresolved,0),"semantic","name is not visible for syntax classification"));},else=>unit};
 },else=>unit};
 Result<SyntaxForest,Diagnostic>::Ok(classified)
};
