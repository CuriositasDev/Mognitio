(in-package #:mognitio.native.runtime)

(defun inspection-proof-forms (unit)
  (let* ((entry (mognitio.object:code-unit-entry unit))
         (prefix (format nil "~A/~A/" (first entry) (second entry))))
    (mapcar (lambda (i)
              (cons (mognitio.machine:instruction-opcode i)
                (mapcar (lambda (arg)
                          (if (and (symbolp arg) (uiop:string-prefix-p prefix (symbol-name arg)))
                              (intern (subseq (symbol-name arg) (length prefix)) :keyword) arg))
                        (mognitio.machine:instruction-operands i))))
            (mognitio.object:code-unit-instructions unit))))

(defun verify-path-inspection-unit (unit)
  ;; Generic I/O proof separately checks frame bounds, roots and ownership CFG.
  ;; Pin the metadata ABI and snapshot transport without rerunning the emitter.
  (let* ((forms (inspection-proof-forms unit))
         (released (position '(:load-frame :rax -128) forms :test #'equal)))
    (flet ((has (sequence)
             (unless (search sequence forms :test #'equal)
               (internal-error "Invalid native path inspection proof"))))
      (has '((:label :observe) (:imm-reg :rdi -100) (:load-frame :rsi -80)
             (:lea-base :rdx :rbp -320) (:mov-r10d 256) (:mov-eax 262) (:syscall)))
      (has '((:load-frame :rax -320) (:store-word :rdx 32 :rax)
             (:load-frame :rax -312) (:store-word :rdx 40 :rax) (:store-frame -16 :rdx)))
      (has '((:load-frame :rax -24) (:store-word :rdx 32 :rax)
             (:load-frame :rax -16) (:store-word :rdx 40 :rax) (:store-frame -32 :rdx)))
      (has '((:load-frame :rax -24) (:store-word :rdx 32 :rax)
             (:load-frame :rax -8) (:store-word :rdx 40 :rax) (:store-frame -32 :rdx)))
      (unless (and released (= 1 (count '(:syscall) forms :test #'equal)))
        (internal-error "Invalid inspection syscall or cleanup boundary"))
      (loop for form in forms for pc from 0 do
        (when (and (equal form '(:call (:runtime :allocate-block))) (< pc released))
          (internal-error "Inspection allocates result while owning resources"))
        (when (and (eq (first form) :store-frame)
                   (member (second form) '(-320 -312)))
          (internal-error "Inspection overwrites observed identity")))))
  unit)

(defun verify-file-identity-equality-unit (unit)
  (let* ((name (second (mognitio.object:code-unit-entry unit))) (op (first name))
         (yes (if (eq op :file-identity.equal) 1 0)) (no (- 1 yes))
         (forms (inspection-proof-forms unit)))
    (unless (equal (rest forms)
              (append '((:push-rbp) (:mov-reg :rbp :rsp) (:push-zero) (:push-zero)
                        (:load-frame :rsi 16) (:load-frame :rdi 24)
                        (:load-word :rax :rsi 32) (:load-word :rcx :rdi 32) (:cmp) (:jnz :different)
                        (:load-word :rax :rsi 40) (:load-word :rcx :rdi 40) (:cmp) (:jnz :different))
                      (list (list :imm-rax yes) '(:jmp :done) '(:label :different) (list :imm-rax no))
                      '((:label :done) (:mov-reg :rsp :rbp) (:pop-rbp) (:ret))))
      (internal-error "Invalid FileIdentity equality helper")))
  unit)
