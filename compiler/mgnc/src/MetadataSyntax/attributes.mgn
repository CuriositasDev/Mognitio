namespace Mgnc\MetadataSyntax;
use Mgnc\Data\{Span,Diagnostic,Related,problem};
use Mgnc\SemanticData\{Attribute};
use Mgnc\Forest\{SyntaxForest};
use Mgnc\Projection\{parts,item,text,site};
public let read:Function(SyntaxForest,List<Int>):Result<List<Attribute>,Diagnostic>=function(tree:SyntaxForest,fields:List<Int>):Result<List<Attribute>,Diagnostic>{
 var result:List<Attribute>=List<Attribute>[];var values:List<Int>=fields;
 loop while(true){
  let at:Span=try site(tree,try item(values,0));let name:Span=try site(tree,try item(values,1));
  result=result->append(Attribute{name:try text(tree,try item(values,1)),span:Span{start:at->start,end:name->end,line:at->line,column:at->column},nameSpan:name});
  values=try parts(tree,try item(values,2));branch when{values->length()==0=>{break;},else=>unit};
 };Result<List<Attribute>,Diagnostic>::Ok(result)
};
let withNote:Function(Span,String,Span,String):Diagnostic=function(span:Span,message:String,other:Span,note:String):Diagnostic{
 Diagnostic{phase:"semantic",span:span,message:message,related:List<Related>[Related{path:"",span:other,message:note}]}
};
public let targets:Function(List<Attribute>,Bool,Span):Result<Unit,Diagnostic>=function(attributes:List<Attribute>,valid:Bool,target:Span):Result<Unit,Diagnostic>{
 var seen:Bool=false;var first:Span=target;
 loop over(attributes as attribute:Attribute){
  branch when{
   attribute->name!="test"=>{return Result<Unit,Diagnostic>::Err(problem("semantic",attribute->nameSpan,"Unknown compiler attribute "+attribute->name+" (unsupported in this version)"));},
   seen=>{return Result<Unit,Diagnostic>::Err(withNote(attribute->span,"Duplicate attribute",first,"First attribute"));},
   !valid=>{return Result<Unit,Diagnostic>::Err(withNote(attribute->span,"test requires a module-level let declaration",target,"Invalid attribute target"));},
   else=>unit
  };
  seen=true;first=attribute->span;
 };Result<Unit,Diagnostic>::Ok(unit)
};
