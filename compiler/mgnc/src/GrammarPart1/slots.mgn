 Slot{lhs:15,rule:28,dot:0,next:0},
 Slot{lhs:15,rule:29,dot:0,next:-8},
 Slot{lhs:15,rule:29,dot:1,next:0},
 Slot{lhs:15,rule:30,dot:0,next:-8},
 Slot{lhs:15,rule:30,dot:1,next:16},
 Slot{lhs:15,rule:30,dot:2,next:15},
 Slot{lhs:15,rule:30,dot:3,next:0},
 Slot{lhs:16,rule:31,dot:0,next:-3},
 Slot{lhs:16,rule:31,dot:1,next:0},
