use Mgnc\IntMap\{Map,create as createMap,get,put};
let same:Function(List<Int>,List<Int>):Bool=function(left:List<Int>,right:List<Int>):Bool{branch when{left->length()!=right->length()=>{return false;},else=>unit};var i:Int=0;loop over(left as value:Int){let other:Int=branch on right->at(i){Result<Int,IndexError>::Ok(found:Int)=>found,Result<Int,IndexError>::Err(error:IndexError)=>{return false;}};branch when{value!=other=>{return false;},else=>unit};i=i+1;};true};
let tail:Function(List<Int>,List<Int>):Bool=function(data:List<Int>,suffix:List<Int>):Bool{branch when{data->length()<suffix->length()=>{return false;},else=>unit};var index:Int=0;loop over(suffix as value:Int){let other:Int=branch on data->at(data->length()-suffix->length()+index){Result<Int,IndexError>::Ok(found:Int)=>found,Result<Int,IndexError>::Err(error:IndexError)=>{return false;}};branch when{value!=other=>{return false;},else=>unit};index=index+1;};true};
let append:Function(List<Int>,List<Int>):List<Int>=function(left:List<Int>,right:List<Int>):List<Int>{var out:List<Int>=left;loop over(right as value:Int){out=out->append(value);};out};
let bytes:Function(Int,Int):List<Int>=function(value:Int,count:Int):List<Int>{var remaining:Int=value;var out:List<Int>=List<Int>[];var index:Int=0;loop while(index<count){let rem:Int=remaining%256;out=out->append(branch when{rem<0=>rem+256,else=>rem});remaining=remaining/256-branch when{rem<0=>1,else=>0};index=index+1;};out};
let pattern:Function(List<Int>,Int,Int):List<Int>=function(prefix:List<Int>,value:Int,size:Int):List<Int>{append(prefix,bytes(value,size))};
let occurrences:Function(List<Int>,List<Int>):Int=function(data:List<Int>,wanted:List<Int>):Int{var count:Int=0;var window:List<Int>=List<Int>[];loop over(data as value:Int){window=window->append(value);branch when{window->length()>wanted->length()=>{var out:List<Int>=List<Int>[];var ordinal:Int=0;loop over(window as octet:Int){branch when{ordinal>0=>{out=out->append(octet);},else=>unit};ordinal=ordinal+1;};window=out;},else=>unit};branch when{same(window,wanted)=>{count=count+1;},else=>unit};};count};

type Region=product{start:Int;end:Int;data:List<Int>;};
let region:Function(Code,Map,Int,Span):Result<Region,Diagnostic>=function(code:Code,labels:Map,id:Int,span:Span):Result<Region,Diagnostic>{let start:Int=(try get(labels,id))+1;try require(start>0,span,"path helper entry");var cursor:Int=start;var data:List<Int>=List<Int>[];loop while(cursor<code->records->count){let record:Record=try lookup<Record>(code->records,cursor);branch when{record->kind==1&&record->target<256=>{break;},else=>unit};data=append(data,record->bytes);branch when{record->kind==2||record->kind==3=>{data=append(data,bytes(branch when{record->kind==3=>record->value,else=>0},4));},record->kind==4||record->kind==5=>{data=append(data,bytes(branch when{record->kind==4=>record->value,else=>0},8));},else=>unit};cursor=cursor+1;};Result<Region,Diagnostic>::Ok(Region{start:start,end:cursor,data:data})};
let syscalls:Function(Code,Region,List<Int>,Span):Result<Unit,Diagnostic>=function(code:Code,part:Region,expected:List<Int>,span:Span):Result<Unit,Diagnostic>{var actual:List<Int>=List<Int>[];var cursor:Int=part->start;loop while(cursor<part->end){let record:Record=try lookup<Record>(code->records,cursor);branch when{record->kind==4&&same(record->bytes,List<Int>[72,184])=>{let following:Record=try lookup<Record>(code->records,cursor+1);branch when{following->bytes->length()>=2&&(try atList<Int>(following->bytes,0))==15&&(try atList<Int>(following->bytes,1))==5=>{actual=actual->append(record->value);},else=>unit};},else=>unit};cursor=cursor+1;};try require(same(actual,expected),span,"path syscall set");Result<Unit,Diagnostic>::Ok(unit)};

type State=product{pc:Int;depth:Int;closed:Bool;cleaned:Bool;decoded:Bool;};
let recordHome:Function(Int):Int=function(depth:Int):Int{-320-depth*192};
let ownership:Function(Code,Map,Region,Span):Result<Unit,Diagnostic>=function(code:Code,labels:Map,part:Region,span:Span):Result<Unit,Diagnostic>{var queue:Paged<State>=push<State>(empty<State>(),State{pc:part->start,depth:0,closed:true,cleaned:false,decoded:false});var cursor:Int=0;var seen:Map=createMap();loop while(cursor<queue->count){let state:State=try lookup<State>(queue,cursor);cursor=cursor+1;try require(state->pc>=part->start&&state->pc<part->end,span,"directory control escapes wrapper");let key:Int=(state->pc-part->start)*32+state->depth*8+branch when{state->closed=>4,else=>0}+branch when{state->cleaned=>2,else=>0}+branch when{state->decoded=>1,else=>0};branch when{(try get(seen,key))>=0=>{continue;},else=>unit};seen=try put(seen,key,1);let item:Record=try lookup<Record>(code->records,state->pc);let previous:Record=try lookup<Record>(code->records,state->pc-1);var depth:Int=state->depth;var closed:Bool=state->closed;var cleaned:Bool=state->cleaned;var decoded:Bool=state->decoded;
 branch when{item->kind==3&&item->value==168&&tail(item->bytes,List<Int>[73,137,135])=>{branch when{previous->kind==3&&tail(previous->bytes,List<Int>[72,141,133])=>{try require(depth<3&&previous->value==recordHome(depth+1),span,"directory record registration order");depth=depth+1;cleaned=false;},else=>{try require(depth>0&&cleaned,span,"directory record release before cleanup");branch when{depth==1=>{try require(previous->kind==3&&tail(previous->bytes,List<Int>[72,139,133])&&previous->value==recordHome(depth),span,"directory prior record transport");},else=>{let loaded:Record=try lookup<Record>(code->records,state->pc-3);let expected:Record=try lookup<Record>(code->records,state->pc-2);try require(loaded->kind==3&&loaded->value==recordHome(depth)&&tail(loaded->bytes,List<Int>[72,139,133])&&expected->kind==3&&expected->value==recordHome(depth-1)&&tail(expected->bytes,List<Int>[72,141,141])&&previous->kind==2&&previous->target==2&&tail(previous->bytes,List<Int>[72,57,200,15,133]),span,"directory guarded record release");}};depth=depth-1;cleaned=false;}};
 },item->kind==3&&item->value== -504&&tail(item->bytes,List<Int>[72,137,133])=>{closed=previous->kind==4&&previous->value== -1&&tail(previous->bytes,List<Int>[72,184]);},item->kind==3&&item->value==17&&tail(item->bytes,List<Int>[72,15,182,134])=>{decoded=false;},else=>unit};
 branch when{previous->kind==4&&same(previous->bytes,List<Int>[72,184])&&item->bytes->length()>=2&&(try atList<Int>(item->bytes,0))==15&&(try atList<Int>(item->bytes,1))==5=>{branch when{previous->value==262=>{try require(decoded&&!closed&&depth==3,span,"directory child stat before decode or without fd");},previous->value==217=>{try require(!closed&&depth==3,span,"directory scan without owned fd");decoded=false;},else=>unit};},else=>unit};
 branch when{item->kind==2&&tail(item->bytes,List<Int>[232])=>{branch when{item->target==10=>{try require(closed&&(depth==0||depth==3),span,"directory managed allocation before close");},item->target==62=>{try require(depth==3&&previous->kind==3&&previous->value== -512&&tail(previous->bytes,List<Int>[72,141,189]),span,"directory close record");closed=true;},item->target==61=>{try require(closed&&depth>0&&previous->kind==3&&previous->value==recordHome(depth)&&tail(previous->bytes,List<Int>[72,141,189]),span,"directory cleanup head and fd state");cleaned=true;},item->target==84=>{let following:Record=try lookup<Record>(code->records,state->pc+1);try require(depth==3&&following->kind==3&&tail(following->bytes,List<Int>[72,137,133])&&(following->value== -496||following->value== -480||following->value== -880||following->value== -688),span,"directory immediate map publication");},item->target==40=>{try require(depth==3&&!closed,span,"directory decode ownership");decoded=true;},item->target==86||item->target==88=>{try require(depth==3&&closed,span,"directory ordering before close");},else=>{try require(item->target==83,span,"directory unexpected runtime helper");}};},else=>unit};
 branch when{item->kind==0&&tail(item->bytes,List<Int>[65,95,65,94,65,93,65,92,91,93,195])=>{try require(depth==0&&closed,span,"directory return retains resources");try require(previous->kind==3&&previous->value==1304&&tail(previous->bytes,List<Int>[72,129,196]),span,"directory frame restoration");let storeRoot:Record=try lookup<Record>(code->records,state->pc-2);let loadRoot:Record=try lookup<Record>(code->records,state->pc-3);try require(storeRoot->kind==3&&storeRoot->value==0&&tail(storeRoot->bytes,List<Int>[73,137,151])&&loadRoot->kind==3&&loadRoot->value== -64&&tail(loadRoot->bytes,List<Int>[72,139,149]),span,"directory root restoration");continue;},else=>unit};
 var fallthrough:Bool=true;branch when{item->kind==2&&!tail(item->bytes,List<Int>[232])=>{let unconditional:Bool=tail(item->bytes,List<Int>[233]);try require(unconditional||item->bytes->length()>=2&&(try atList<Int>(item->bytes,item->bytes->length()-2))==15,span,"directory branch opcode");branch when{item->target<128=>{try require(item->target==1||item->target==2||item->target==6||item->target==9,span,"directory terminal helper");},else=>{queue=push<State>(queue,State{pc:try get(labels,item->target),depth:depth,closed:closed,cleaned:cleaned,decoded:decoded});}};fallthrough=!unconditional;},else=>unit};branch when{fallthrough=>{queue=push<State>(queue,State{pc:state->pc+1,depth:depth,closed:closed,cleaned:cleaned,decoded:decoded});},else=>unit};
 };Result<Unit,Diagnostic>::Ok(unit)};
public let verify:Function(Native,Code):Result<Unit,Diagnostic>=function(plan:Native,initial:Code):Result<Unit,Diagnostic>{let code:Code=flush(initial);let span:Span=Span{start:0,end:0,line:1,column:1};var selected:Bool=false;loop over(plan->globals->pages->append(plan->globals->tail) as page:List<Global>){loop over(page as value:Global){selected=selected||value->standard=="readDirectory";};};branch when{!selected=>{return Result<Unit,Diagnostic>::Ok(unit);},else=>unit};// Collect every actual relocation queried by these helper regions, including
 // a forged target outside its region, so rejection priority remains unchanged.
 var queriedLabels:Map=createMap();var indexingRegion:Bool=false;
 loop over(code->records->pages->append(code->records->tail) as records:List<Record>){var recordCursor0:Int=0;loop while(recordCursor0<records->length()){let record:Record=try atList<Record>(records,recordCursor0);recordCursor0=recordCursor0+1;branch when{record->kind==1&&record->target<256=>{indexingRegion=record->target==79||record->target==85||record->target==86||record->target==87||record->target==88;},else=>unit};branch when{indexingRegion&&(record->kind==2||record->kind==5)&&record->target>=256=>{queriedLabels=try put(queriedLabels,record->target,1);},else=>unit};};};
 var labels:Map=createMap();var ordinal:Int=0;loop over(code->records->pages->append(code->records->tail) as page:List<Record>){var recordCursor1:Int=0;loop while(recordCursor1<page->length()){let item:Record=try atList<Record>(page,recordCursor1);recordCursor1=recordCursor1+1;branch when{item->kind==1&&(item->target<256||(try get(queriedLabels,item->target))>=0)=>{labels=try put(labels,item->target,ordinal);},else=>unit};ordinal=ordinal+1;};};let part:Region=try region(code,labels,79,span);let first:Record=try lookup<Record>(code->records,part->start);try require(first->kind==3&&first->value==1304&&same(first->bytes,List<Int>[85,72,137,229,83,65,84,65,85,65,86,65,87,72,129,236]),span,"directory frame and callee saves");try syscalls(code,part,List<Int>[257,217,11,262,11],span);
 var open:List<Int>=pattern(List<Int>[72,191],-100,8);open=append(open,pattern(List<Int>[72,139,181],-496,4));open=append(open,pattern(List<Int>[72,186],589824,8));open=append(open,pattern(List<Int>[73,186],0,8));open=append(open,pattern(List<Int>[72,184],257,8));open=append(open,List<Int>[15,5]);try require(occurrences(part->data,open)==1,span,"directory open ABI and flags");var scan:List<Int>=pattern(List<Int>[72,139,189],-504,4);scan=append(scan,pattern(List<Int>[72,139,181],-480,4));scan=append(scan,pattern(List<Int>[72,186],65536,8));scan=append(scan,pattern(List<Int>[72,184],217,8));scan=append(scan,List<Int>[15,5]);try require(occurrences(part->data,scan)==1,span,"directory scan buffer ABI");var child:List<Int>=pattern(List<Int>[72,139,189],-504,4);child=append(child,pattern(List<Int>[72,139,181],-880,4));child=append(child,pattern(List<Int>[72,139,133],-184,4));child=append(child,List<Int>[72,1,198]);child=append(child,pattern(List<Int>[72,141,149],-1040,4));child=append(child,pattern(List<Int>[73,186],256,8));child=append(child,pattern(List<Int>[72,184],262,8));child=append(child,List<Int>[15,5]);try require(occurrences(part->data,child)==1,span,"directory child stat ABI and nofollow");try require(occurrences(part->data,pattern(List<Int>[72,139,133],-1016,4))==1,span,"directory stat mode snapshot");try require(occurrences(part->data,pattern(List<Int>[72,129,198],19,4))==1,span,"directory record name offset");try require(occurrences(part->data,pattern(List<Int>[72,129,248],24,4))==1&&occurrences(part->data,pattern(List<Int>[72,129,226],7,4))==1&&occurrences(part->data,pattern(List<Int>[72,129,248],65536,4))==1,span,"directory raw record bounds and alignment");try ownership(code,labels,part,span);
 loop over(List<Int>[85,86,87,88] as helper:Int){let rawPart:Region=try region(code,labels,helper,span);try syscalls(code,rawPart,List<Int>[],span);branch when{helper>=87=>{let entry:Record=try lookup<Record>(code->records,rawPart->start);let scratch:Record=try lookup<Record>(code->records,rawPart->start+1);let release:Record=try lookup<Record>(code->records,rawPart->end-3);let restored:Record=try lookup<Record>(code->records,rawPart->end-2);let returned:Record=try lookup<Record>(code->records,rawPart->end-1);try require(entry->kind==3&&entry->value==8&&same(entry->bytes,List<Int>[85,72,137,229,83,65,84,65,85,65,86,65,87,72,129,236])&&scratch->kind==3&&scratch->value==128&&same(scratch->bytes,List<Int>[72,129,236])&&release->kind==3&&release->value==128&&same(release->bytes,List<Int>[72,129,196])&&restored->kind==3&&restored->value==8&&same(restored->bytes,List<Int>[72,129,196])&&returned->kind==0&&tail(returned->bytes,List<Int>[65,95,65,94,65,93,65,92,91,93,195]),span,"directory sort helper frames");},else=>unit};var index:Int=rawPart->start;loop while(index<rawPart->end){let item:Record=try lookup<Record>(code->records,index);branch when{item->kind==2&&tail(item->bytes,List<Int>[232])=>{try require(helper==87&&item->target==85||helper==88&&item->target==87,span,"directory sort helper closure");},item->kind==2&&helper<=86=>{try require(tail(item->bytes,List<Int>[233])||tail(item->bytes,List<Int>[15,130])||tail(item->bytes,List<Int>[15,132])||tail(item->bytes,List<Int>[15,134])||tail(item->bytes,List<Int>[15,135]),span,"directory unsigned byte comparison");},else=>unit};branch when{helper<=86&&item->kind==3&&item->bytes->length()>=3=>{let size:Int=item->bytes->length();let rex:Int=try atList<Int>(item->bytes,size-3);let opcode:Int=try atList<Int>(item->bytes,size-2);let operand:Int=try atList<Int>(item->bytes,size-1);branch when{rex==73&&opcode==139&&operand>=128&&operand<192&&(operand%8==0||operand%8==1)=>{try require(item->value==0||item->value==8||helper==85&&item->value==32,span,"directory comparator row fields");},else=>unit};},else=>unit};index=index+1;};branch when{helper<=86=>{try require(occurrences(rawPart->data,pattern(List<Int>[73,139,128],32,4))==branch when{helper==85=>1,else=>0}&&occurrences(rawPart->data,pattern(List<Int>[73,139,137],32,4))==branch when{helper==85=>1,else=>0},span,"directory first successful ordinal tie");try require(occurrences(rawPart->data,pattern(List<Int>[73,139,128],24,4))==0&&occurrences(rawPart->data,pattern(List<Int>[73,139,137],24,4))==0,span,"directory kind must not order names");},else=>unit};};Result<Unit,Diagnostic>::Ok(unit)};
