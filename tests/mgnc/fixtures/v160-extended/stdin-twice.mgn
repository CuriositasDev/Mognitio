namespace App;
use Std\Io\{readStdin,writeStdout,IoError,IoErrorKind};
let main:Function(List<String>):Int=function(args:List<String>):Int{branch on readStdin(){Result<String,IoError>::Ok(value:String)=>{discard writeStdout(value);},Result<String,IoError>::Err(error:IoError)=>{branch on error->kind{IoErrorKind::InvalidEncoding=>unit,IoErrorKind::InvalidPath=>{return 1;},IoErrorKind::NotFound=>{return 1;},IoErrorKind::PermissionDenied=>{return 1;},IoErrorKind::UnsupportedTarget=>{return 1;},IoErrorKind::BrokenPipe=>{return 1;},IoErrorKind::ResourceExhausted=>{return 1;},IoErrorKind::Other=>{return 1;}};}};branch on readStdin(){Result<String,IoError>::Ok(value:String)=>{discard writeStdout(value);},Result<String,IoError>::Err(error:IoError)=>{return 2;}};0};
