namespace Mgnc\WholeContractMachine;
use Std\Numeric\{Bits,Unsigned,IntegerConversionError};
use Std\Binary\{Bytes,ByteOrder,BitWidthError};
use Mgnc\Data\{Paged,Diagnostic,Span,empty,push,lookup};use Mgnc\Syntax\{Parent};
use Mgnc\Machine\{Code,Record,flush};use Mgnc\WholeConcrete\{Instance};use Mgnc\WholeDispatchData\{Pair};
use Mgnc\WholeIR\{Block,Operation};use Mgnc\WholeNativeData\{Native,Procedure,Constructor,Literal,staticTableLabel,globalRootsLabel};
use Mgnc\WholeFrameData\{Point};use Mgnc\TypeData\{Type,Member};
use Mgnc\WholeChecks\{require,present};use Mgnc\Tables\{atList};use Mgnc\IntMap\{Map,create,get,put};
type Reference=product{offset:Int;kind:Int;target:Int;};type Part=product{bytes:List<Int>;references:List<Reference>;};
let append:Function(List<Int>,List<Int>):List<Int>=function(left:List<Int>,right:List<Int>):List<Int>{var out:List<Int>=left;loop over(right as value:Int){out=out->append(value);};out};
let bytes:Function(Int,Int):List<Int>=function(value:Int,count:Int):List<Int>{var remaining:Int=value;var out:List<Int>=List<Int>[];var index:Int=0;loop while(index<count){let remainder:Int=remaining%256;out=out->append(branch when{remainder<0=>remainder+256,else=>remainder});remaining=remaining/256-branch when{remainder<0=>1,else=>0};index=index+1;};out};
let same:Function(List<Int>,List<Int>):Bool=function(left:List<Int>,right:List<Int>):Bool{branch when{left->length()!=right->length()=>{return false;},else=>unit};var index:Int=0;loop over(left as value:Int){branch on right->at(index){Result<Int,IndexError>::Ok(other:Int)=>{branch when{value!=other=>{return false;},else=>unit};},Result<Int,IndexError>::Err(error:IndexError)=>{return false;}};index=index+1;};true};
let field:Function(List<Int>,List<Int>,Int,Int):List<Int>=function(initial:List<Int>,prefix:List<Int>,value:Int,width:Int):List<Int>{append(append(initial,prefix),bytes(value,width))};
let fp:Function(List<Int>,Int,Int):List<Int>=function(initial:List<Int>,modrm:Int,offset:Int):List<Int>{field(initial,List<Int>[72,139,modrm],offset,4)};
let stack:Function(List<Int>,Int):List<Int>=function(initial:List<Int>,offset:Int):List<Int>{field(initial,List<Int>[72,137,132,36],offset,4)};
let output:Function(List<Int>,Operation,Span):Result<List<Int>,Diagnostic>=function(initial:List<Int>,op:Operation,span:Span):Result<List<Int>,Diagnostic>{branch on op->output{Parent::None=>Result<List<Int>,Diagnostic>::Ok(initial),Parent::Some(slot:Int)=>Result<List<Int>,Diagnostic>::Ok(field(initial,List<Int>[72,137,133],-72-slot*8,4))}};
// Decode records independently of the instruction emitter, retaining relocation roles.
let part:Function(Code,Map,Int,Int,Span):Result<Part,Diagnostic>=function(code:Code,labels:Map,start:Int,end:Int,span:Span):Result<Part,Diagnostic>{var cursor:Int=try get(labels,start);let limit:Int=try get(labels,end);try require(cursor>=0&&limit>cursor,span,"contract machine region");cursor=cursor+1;var data:List<Int>=List<Int>[];var references:List<Reference>=List<Reference>[];loop while(cursor<limit){let record:Record=try lookup<Record>(code->records,cursor);data=append(data,record->bytes);branch when{record->kind==2||record->kind==5=>{references=references->append(Reference{offset:data->length(),kind:record->kind,target:record->target});data=append(data,bytes(0,branch when{record->kind==2=>4,else=>8}));},record->kind==3||record->kind==4=>{data=append(data,bytes(record->value,branch when{record->kind==3=>4,else=>8}));},else=>unit};cursor=cursor+1;};Result<Part,Diagnostic>::Ok(Part{bytes:data,references:references})};
let check:Function(Part,List<Int>,List<Reference>,Span,String):Result<Unit,Diagnostic>=function(actual:Part,expected:List<Int>,references:List<Reference>,span:Span,message:String):Result<Unit,Diagnostic>{try require(same(actual->bytes,expected)&&actual->references->length()==references->length(),span,message);var ordinal:Int=0;loop over(references as wanted:Reference){let found:Reference=try atList<Reference>(actual->references,ordinal);try require(found->offset==wanted->offset&&found->kind==wanted->kind&&found->target==wanted->target,span,message);ordinal=ordinal+1;};Result<Unit,Diagnostic>::Ok(unit)};
let identity:Function(Native,Int,Span):Result<Int,Diagnostic>=function(plan:Native,typeId:Int,span:Span):Result<Int,Diagnostic>{let id:Int=try lookup<Int>(plan->runtimeTypes->values,typeId);try require(id>=0&&id<plan->runtimeTypes->types->count,span,"contract serialized runtime identity domain");Result<Int,Diagnostic>::Ok(id)};
let bitmap:Function(Procedure,Int,Int,Span):Result<Int,Diagnostic>=function(procedure:Procedure,block:Int,operation:Int,span:Span):Result<Int,Diagnostic>{var result:Int= -1;var ordinal:Int=0;loop over(procedure->frame->points->pages->append(procedure->frame->points->tail) as page:List<Point>){loop over(page as point:Point){branch when{point->block==block&&point->operation==operation=>{try require(result<0,span,"contract duplicate source root point");result=try lookup<Int>(procedure->pointLabels,ordinal);},else=>unit};ordinal=ordinal+1;};};try require(result>=0,span,"contract missing source root point");Result<Int,Diagnostic>::Ok(result)};
let constructor:Function(Native,Int,Int,Int,Span):Result<Int,Diagnostic>=function(plan:Native,owner:Int,block:Int,operation:Int,span:Span):Result<Int,Diagnostic>{var found:Int= -1;loop over(plan->constructors->pages->append(plan->constructors->tail) as page:List<Constructor>){loop over(page as candidate:Constructor){branch when{candidate->instance==owner&&candidate->block==block&&candidate->operation==operation=>{try require(found<0,span,"contract duplicate package constructor");found=candidate->entry;},else=>unit};};};try require(found>=0,span,"contract package constructor membership");Result<Int,Diagnostic>::Ok(found)};
let selected:Function(Native,Operation):Result<Int,Diagnostic>=function(plan:Native,op:Operation):Result<Int,Diagnostic>{let implementation:Int=try present(op->target,op->origin->span,"contract selected implementation");var result:Int= -1;var ordinal:Int=0;loop over(plan->concrete->pairs->pages->append(plan->concrete->pairs->tail) as page:List<Pair>){loop over(page as pair:Pair){branch when{pair->implementation==implementation=>{try require(result<0,op->origin->span,"contract duplicate selected pair");result=ordinal;},else=>unit};ordinal=ordinal+1;};};try require(result>=0,op->origin->span,"contract selected pair membership");Result<Int,Diagnostic>::Ok(result)};
let sourceOperation:Function(Native,Int,Int,Int,Operation,Part):Result<Unit,Diagnostic>=function(plan:Native,owner:Int,block:Int,position:Int,op:Operation,actual:Part):Result<Unit,Diagnostic>{let span:Span=op->origin->span;let procedure:Procedure=try lookup<Procedure>(plan->procedures,owner);let root:Int=try bitmap(procedure,block,position,span);var expected:List<Int>=field(List<Int>[],List<Int>[72,184],0,8);expected=field(expected,List<Int>[72,137,133],-48,4);var references:List<Reference>=List<Reference>[Reference{offset:2,kind:5,target:root}];
 branch when{op->code=="package"=>{let index:Int=try selected(plan,op);let pair:Pair=try lookup<Pair>(plan->concrete->pairs,index);let boxId:Int=try lookup<Int>(plan->layouts->boxes,pair->concreteType);let packageId:Int=try get(plan->layouts->types,pair->contractType);try require(boxId>=0&&packageId>=0&&procedure->frame->outgoing>=6,span,"contract package descriptor arguments");
  expected=stack(field(expected,List<Int>[72,184],0,8),0);expected=stack(field(expected,List<Int>[72,184],boxId,8),8);expected=stack(field(expected,List<Int>[72,184],packageId,8),16);expected=stack(field(expected,List<Int>[72,184],0,8),24);references=references->append(Reference{offset:73,kind:5,target:try lookup<Int>(plan->dispatchTables,index)});expected=stack(field(expected,List<Int>[72,184],try identity(plan,pair->concreteType,span),8),32);expected=stack(fp(expected,133,-72-(try atList<Int>(op->inputs,0))*8),40);expected=field(expected,List<Int>[232],0,4);references=references->append(Reference{offset:123,kind:2,target:try constructor(plan,owner,block,position,span)});
 },else=>{let contractShape:Type=try lookup<Type>(plan->concrete->types->types,try present(op->target,span,"contract dispatch receiver type"));let ordinal:Int=try atList<Int>(op->mapping,0);try require(contractShape->kind==29&&ordinal>=0&&ordinal<contractShape->members->length(),span,"contract dynamic member ordinal");expected=fp(expected,133,-72-(try atList<Int>(op->inputs,0))*8);expected=field(expected,List<Int>[72,139,144],32,4);expected=field(expected,List<Int>[76,139,154],32+ordinal*24,4);expected=field(expected,List<Int>[72,139,144],24,4);expected=field(expected,List<Int>[72,139,130],24,4);expected=stack(expected,8);expected=stack(field(expected,List<Int>[72,184],0,8),0);var argument:Int=0;loop over(op->inputs as slot:Int){branch when{argument>0=>{expected=stack(fp(expected,133,-72-slot*8),(argument+1)*8);},else=>unit};argument=argument+1;};let referenceOffset:Int=expected->length()+2;expected=stack(field(expected,List<Int>[72,184],0,8),(argument+1)*8);references=references->append(Reference{offset:referenceOffset,kind:5,target:root+1});expected=append(expected,List<Int>[65,255,211]);
 }};expected=try output(expected,op,span);check(actual,expected,references,span,"contract source ABI and runtime identity bytes")
};
// One root owns the filled box before the package allocation; no caller handoff.
let packageConstructor:Function(Native,Code,Map,Constructor,Span):Result<Unit,Diagnostic>=function(plan:Native,code:Code,labels:Map,entry:Constructor,span:Span):Result<Unit,Diagnostic>{var expected:List<Int>=field(List<Int>[85,72,137,229,83,65,84,65,85,65,86,65,87],List<Int>[72,129,236],104,4);expected=field(expected,List<Int>[72,184],0,8);expected=field(expected,List<Int>[72,137,133],-72,4);expected=field(expected,List<Int>[73,139,135],0,4);expected=field(expected,List<Int>[72,137,133],-64,4);expected=field(expected,List<Int>[72,137,173],-56,4);expected=field(expected,List<Int>[72,184],0,8);expected=field(expected,List<Int>[72,137,133],-48,4);expected=field(expected,List<Int>[72,141,133],-64,4);expected=field(expected,List<Int>[73,137,135],0,4);
 expected=field(expected,List<Int>[72,191],32,8);expected=fp(expected,181,24);expected=field(expected,List<Int>[232],0,4);expected=fp(expected,149,56);expected=field(expected,List<Int>[72,137,144],24,4);expected=field(expected,List<Int>[72,137,133],-72,4);
 expected=field(expected,List<Int>[72,191],48,8);expected=fp(expected,181,32);expected=field(expected,List<Int>[232],0,4);expected=fp(expected,149,-72);expected=field(expected,List<Int>[72,137,144],24,4);expected=fp(expected,149,40);expected=field(expected,List<Int>[72,137,144],32,4);expected=fp(expected,149,48);expected=field(expected,List<Int>[72,137,144],40,4);
 expected=fp(expected,149,-64);expected=field(expected,List<Int>[73,137,151],0,4);expected=field(expected,List<Int>[72,129,196],104,4);expected=append(expected,List<Int>[65,95,65,94,65,93,65,92,91,93,195]);try require(expected->length()==228,span,"contract constructor proof extent");try check(try part(code,labels,entry->entry,entry->roots,span),expected,List<Reference>[Reference{offset:60,kind:5,target:entry->roots},Reference{offset:107,kind:2,target:10},Reference{offset:150,kind:2,target:10}],span,"contract box allocation, root lifetime and package fill");let rootRecord:Int=try get(labels,entry->roots);let count:Record=try lookup<Record>(code->records,rootRecord+1);let word:Record=try lookup<Record>(code->records,rootRecord+2);try require(count->kind==4&&word->kind==4&&count->bytes->length()==0&&word->bytes->length()==0&&count->value==1&&word->value==1,span,"contract constructor root bitmap data");Result<Unit,Diagnostic>::Ok(unit)};
// Compare actual bitmap bytes using binary conversion, not the table emitter's
// per-bit mask/power loop. Checked frame metadata alone is not emitted evidence.
let bitmapData:Function(Code,Map,Int,Int,List<Bits<64>>,Span):Result<Unit,Diagnostic>=function(code:Code,labels:Map,id:Int,count:Int,words:List<Bits<64>>,span:Span):Result<Unit,Diagnostic>{
 var expected:List<Int>=bytes(count,8);loop over(words as word:Bits<64>){let encoded:Bytes=branch on word->toBytes(ByteOrder::LittleEndian){Result<Bytes,BitWidthError>::Ok(value:Bytes)=>value,Result<Bytes,BitWidthError>::Err(error:BitWidthError)=>{try require(false,span,"contract bitmap binary encoding");return Result<Unit,Diagnostic>::Ok(unit);}};var index:Int=0;loop while(index<8){let octet:Bits<8>=branch on encoded->at(index){Result<Bits<8>,IndexError>::Ok(value:Bits<8>)=>value,Result<Bits<8>,IndexError>::Err(error:IndexError)=>{try require(false,span,"contract bitmap byte extent");return Result<Unit,Diagnostic>::Ok(unit);}};let converted:Int=branch on octet->asInteger<Unsigned>()->convertTo<Int>(){Result<Int,IntegerConversionError>::Ok(value:Int)=>value,Result<Int,IntegerConversionError>::Err(error:IntegerConversionError)=>{try require(false,span,"contract bitmap octet conversion");return Result<Unit,Diagnostic>::Ok(unit);}};expected=expected->append(converted);index=index+1;};};
 var cursor:Int=try get(labels,id);try require(cursor>=0,span,"contract bitmap label membership");cursor=cursor+1;var actual:List<Int>=List<Int>[];loop while(cursor<code->records->count){let record:Record=try lookup<Record>(code->records,cursor);branch when{record->kind==1=>{break;},else=>unit};try require(record->kind==0||record->kind==3||record->kind==4,span,"contract bitmap scalar data only");actual=append(actual,record->bytes);branch when{record->kind==3||record->kind==4=>{actual=append(actual,bytes(record->value,branch when{record->kind==3=>4,else=>8}));},else=>unit};cursor=cursor+1;};try require(same(actual,expected),span,"contract emitted root bitmap data");Result<Unit,Diagnostic>::Ok(unit)
};
public let verify:Function(Native,Code):Result<Unit,Diagnostic>=function(plan:Native,initial:Code):Result<Unit,Diagnostic>{let span:Span=Span{start:0,end:0,line:1,column:1};var needed:Bool=plan->concrete->pairs->count>0;loop over(plan->concrete->instances->pages->append(plan->concrete->instances->tail) as page:List<Instance>){loop over(page as instance:Instance){loop over(instance->body->blocks->pages->append(instance->body->blocks->tail) as blocks:List<Block>){loop over(blocks as block:Block){loop over(block->operations as op:Operation){needed=needed||op->code=="package"||op->code=="dispatch";};};};};};branch when{!needed=>{return Result<Unit,Diagnostic>::Ok(unit);},else=>unit};let code:Code=flush(initial);var labels:Map=create();var index:Int=0;loop over(code->records->pages->append(code->records->tail) as page:List<Record>){var recordCursor0:Int=0;loop while(recordCursor0<page->length()){let record:Record=try atList<Record>(page,recordCursor0);recordCursor0=recordCursor0+1;branch when{record->kind==1=>{try require((try get(labels,record->target))<0,span,"contract duplicate machine label");labels=try put(labels,record->target,index);},else=>unit};index=index+1;};};
 loop over(plan->procedures->pages->append(plan->procedures->tail) as page:List<Procedure>){loop over(page as procedure:Procedure){try bitmapData(code,labels,procedure->entryRoots,procedure->frame->slots,procedure->frame->entry,span);var ordinal:Int=0;loop over(procedure->frame->points->pages->append(procedure->frame->points->tail) as points:List<Point>){loop over(points as point:Point){let id:Int=try lookup<Int>(procedure->pointLabels,ordinal);try bitmapData(code,labels,id,procedure->frame->slots,point->roots,span);branch when{point->handoff->length()>0=>{try bitmapData(code,labels,id+1,procedure->frame->slots,point->handoff,span);},else=>unit};ordinal=ordinal+1;};};};};try bitmapData(code,labels,globalRootsLabel,plan->globals->count,plan->globalRoots,span);
 index=0;loop over(plan->concrete->pairs->pages->append(plan->concrete->pairs->tail) as page:List<Pair>){loop over(page as pair:Pair){var expected:List<Int>=bytes(try identity(plan,pair->concreteType,span),8);expected=append(expected,bytes(try identity(plan,pair->contractType,span),8));expected=append(expected,bytes(pair->methods->length(),8));var references:List<Reference>=List<Reference>[];var ordinal:Int=0;loop over(pair->methods as method:Int){expected=append(expected,bytes(ordinal,8));references=references->append(Reference{offset:expected->length(),kind:5,target:(try lookup<Procedure>(plan->procedures,method))->entry});expected=append(expected,bytes(0,8));expected=append(expected,bytes(try identity(plan,try atList<Int>(pair->signatures,ordinal),span),8));ordinal=ordinal+1;};let following:Int=branch when{index+1<plan->dispatchTables->count=>try lookup<Int>(plan->dispatchTables,index+1),else=>staticTableLabel};try check(try part(code,labels,try lookup<Int>(plan->dispatchTables,index),following,span),expected,references,span,"contract table member code and canonical type metadata");index=index+1;};};
 branch when{plan->concrete->pairs->count>0=>{let first:Literal=try lookup<Literal>(plan->literals,0);let actual:Part=try part(code,labels,staticTableLabel,first->label,span);var expected:List<Int>=List<Int>[];var references:List<Reference>=List<Reference>[];loop over(plan->literals->pages->append(plan->literals->tail) as page:List<Literal>){loop over(page as literal:Literal){references=references->append(Reference{offset:expected->length(),kind:5,target:literal->label});expected=append(expected,bytes(0,8));};};try check(actual,expected,references,span,"contract tables excluded from managed static objects");},else=>unit};
 var owner:Int=0;loop over(plan->concrete->instances->pages->append(plan->concrete->instances->tail) as page:List<Instance>){loop over(page as instance:Instance){let procedure:Procedure=try lookup<Procedure>(plan->procedures,owner);var blockId:Int=0;loop over(instance->body->blocks->pages->append(instance->body->blocks->tail) as blocks:List<Block>){loop over(blocks as block:Block){let markers:List<Int>=try lookup<List<Int>>(procedure->operationLabels,blockId);var position:Int=0;loop over(block->operations as op:Operation){branch when{(op->code=="package"||op->code=="dispatch")&&op->unavailable->length()==0=>{let following:Int=branch when{position+1<markers->length()=>try atList<Int>(markers,position+1),else=>try lookup<Int>(procedure->terminatorLabels,blockId)};try sourceOperation(plan,owner,blockId,position,op,try part(code,labels,try atList<Int>(markers,position),following,op->origin->span));},else=>unit};position=position+1;};blockId=blockId+1;};};owner=owner+1;};};
 loop over(plan->constructors->pages->append(plan->constructors->tail) as page:List<Constructor>){loop over(page as entry:Constructor){let instance:Instance=try lookup<Instance>(plan->concrete->instances,entry->instance);let block:Block=try lookup<Block>(instance->body->blocks,entry->block);let op:Operation=try atList<Operation>(block->operations,entry->operation);branch when{op->code=="package"=>{try packageConstructor(plan,code,labels,entry,op->origin->span);},else=>unit};};};Result<Unit,Diagnostic>::Ok(unit)};
