namespace Mgnc\WholePathProof;
use Mgnc\Data\{Diagnostic,Span,lookup};
use Mgnc\Syntax\{Parent};
use Mgnc\TypeData\{Type,Member};
use Mgnc\SemanticData\{Declaration,Module};
use Mgnc\WholeNativeData\{Native,Global};
use Mgnc\WholeChecks\{require,present};
use Mgnc\WholeLayout\{argumentType};
use Mgnc\IntMap\{get};
use Mgnc\Tables\{atList};
let nominal:Function(Native,Int,String,Int,Int):Result<Type,Diagnostic>=function(plan:Native,id:Int,name:String,kind:Int,count:Int):Result<Type,Diagnostic>{let span:Span=Span{start:0,end:0,line:1,column:1};let value:Type=try lookup<Type>(plan->concrete->types->types,id);let declaration:Declaration=try lookup<Declaration>(plan->concrete->types->headers->declarations,try present(value->owner,span,"directory nominal owner"));let module:Module=try lookup<Module>(plan->concrete->types->headers->modules,declaration->file);try require(value->kind==kind&&value->members->length()==count&&value->arguments->length()==0&&declaration->name==name&&module->standard&&module->nameSpace=="Std\\Io",span,"directory nominal identity: "+name);Result<Type,Diagnostic>::Ok(value)};
let member:Function(Type,Int,String,Span):Result<Int,Diagnostic>=function(value:Type,index:Int,name:String,span:Span):Result<Int,Diagnostic>{let field:Member=try atList<Member>(value->members,index);try require(field->name==name,span,"directory error field name");present(field->value,span,"directory error field type")};
let variants:Function(Type,List<String>,Span):Result<Unit,Diagnostic>=function(value:Type,names:List<String>,span:Span):Result<Unit,Diagnostic>{var index:Int=0;loop over(names as name:String){let field:Member=try atList<Member>(value->members,index);try require(field->name==name,span,"directory error variant name");branch on field->value{Parent::None=>unit,Parent::Some(id:Int)=>{try require(false,span,"directory error variant payload");}};index=index+1;};Result<Unit,Diagnostic>::Ok(unit)};
public let signature:Function(Native,Global):Result<Int,Diagnostic>=function(plan:Native,global:Global):Result<Int,Diagnostic>{let span:Span=Span{start:0,end:0,line:1,column:1};let create:Bool=global->standard=="createDirectory";try require(create||global->standard=="joinPath",span,"directory Function identity");let count:Int=branch when{create=>1,else=>2};let functionType:Type=try lookup<Type>(plan->concrete->types->types,global->valueType);try require(functionType->kind==12&&functionType->arguments->length()==count+1,span,"directory Function signature");var index:Int=0;loop while(index<count){try require((try argumentType(functionType,index,span))==3,span,"directory Function argument");index=index+1;};let result:Type=try lookup<Type>(plan->concrete->types->types,try argumentType(functionType,count,span));try require(result->kind==11&&result->arguments->length()==2&&(try argumentType(result,0,span))==branch when{create=>0,else=>3},span,"directory Function Result");let error:Type=try nominal(plan,try argumentType(result,1,span),"IoError",20,4);try require((try member(error,2,"subject",span))==3,span,"directory original subject type");let operation:Type=try nominal(plan,try member(error,0,"operation",span),"IoOperation",21,8);try variants(operation,List<String>["ReadTextFile","WriteTextFile","ReadStdin","WriteStdout","WriteStderr","JoinPath","ReadDirectory","CreateDirectory"],span);let kind:Type=try nominal(plan,try member(error,1,"kind",span),"IoErrorKind",21,8);try variants(kind,List<String>["InvalidPath","InvalidEncoding","NotFound","PermissionDenied","UnsupportedTarget","BrokenPipe","ResourceExhausted","Other"],span);let phase:Type=try nominal(plan,try member(error,3,"phase",span),"IoErrorPhase",21,4);try variants(phase,List<String>["Input","Target","Body","Cleanup"],span);Result<Int,Diagnostic>::Ok(branch when{create=>78,else=>77})};
public let descriptors:Function(Native,Global):Result<List<Int>,Diagnostic>=function(plan:Native,global:Global):Result<List<Int>,Diagnostic>{let id:Int=try signature(plan,global);let span:Span=Span{start:0,end:0,line:1,column:1};let functionType:Type=try lookup<Type>(plan->concrete->types->types,global->valueType);let resultId:Int=try argumentType(functionType,functionType->arguments->length()-1,span);let result:Type=try lookup<Type>(plan->concrete->types->types,resultId);let errorId:Int=try argumentType(result,1,span);let error:Type=try lookup<Type>(plan->concrete->types->types,errorId);var types:List<Int>=branch when{id==77=>List<Int>[3],else=>List<Int>[]};types=types->append(try member(error,0,"operation",span))->append(try member(error,1,"kind",span))->append(try member(error,3,"phase",span))->append(errorId)->append(resultId);var expected:List<Int>=List<Int>[];loop over(types as typeId:Int){let value:Int=try get(plan->layouts->types,typeId);try require(value>=0,span,"directory allocation descriptor");expected=expected->append(value);};Result<List<Int>,Diagnostic>::Ok(expected)};
