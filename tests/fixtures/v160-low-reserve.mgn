namespace App;
type Cell=product{value:Int;};
let main:Function(List<String>):Int=function(args:List<String>):Int{
 let limit:Int=branch on args->at(0){Result<String,IndexError>::Ok(value:String)=>value->length(),Result<String,IndexError>::Err(error:IndexError)=>10000};
 var kept:List<Cell>=List<Cell>[];var index:Int=0;
 loop while(index<limit){kept=kept->append(Cell{value:index});index=index+1;};
 var last:Cell=Cell{value:0};index=0;
 loop while(index<100000){last=Cell{value:index};index=index+1;};
 let first:Cell=branch on kept->at(0){Result<Cell,IndexError>::Ok(value:Cell)=>value,Result<Cell,IndexError>::Err(error:IndexError)=>{return 2;}};
 branch when{kept->length()==limit&&first->value==0&&last->value==99999=>0,else=>1}
};
