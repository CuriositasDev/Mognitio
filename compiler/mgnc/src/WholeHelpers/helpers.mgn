namespace Mgnc\WholeHelpers;
use Mgnc\Data\{Diagnostic,Span};
use Mgnc\WholeChecks\{require};
// Kinds: 0 scalar, 1 managed value, 2 raw pointer, 3 descriptor, 4 code.
// Explicit signatures distinguish the source stack ABI from scalar register ABI.
public type Helper=product{id:Int;stack:Bool;arguments:List<Int>;result:Int;managedAllocation:Bool;mayFail:Bool;clobbers:List<Int>;dependencies:List<Int>;};
public let registry:Function():List<Helper>=function():List<Helper>{
 var entries:List<Helper>=List<Helper>[];loop over(List<Int>[10,11,12,13,14,15,19,20,21,22,40,41,42,43,44,45,60,61,62,63,64,65] as id:Int){
  let arguments:List<Int>=branch when{id==10=>List<Int>[0,3],id==12||id==19=>List<Int>[1],id==14||id==60=>List<Int>[0],id==40||id==65=>List<Int>[2,0],id==45=>List<Int>[2,0,2],id==41=>List<Int>[1,0,3,3,0],id==42=>List<Int>[1,0,0,3,3,3],id==43=>List<Int>[1,1,3],id==44=>List<Int>[1,3,3],id==61||id==62=>List<Int>[2],id==64=>List<Int>[0],else=>List<Int>[]};
  let dependencies:List<Int>=branch when{id==10=>List<Int>[11,14,19],id==11=>List<Int>[20,22,21,15],id==12=>List<Int>[13],id==20||id==21||id==22=>List<Int>[12],id==41||id==42||id==43||id==44=>List<Int>[10],id==61=>List<Int>[62],id==63=>List<Int>[61],else=>List<Int>[]};
  entries=entries->append(Helper{id:id,stack:id>=41&&id<=44,arguments:arguments,result:branch when{id==10||id>=41&&id<=44=>1,id==60=>2,else=>0},managedAllocation:id==10||id>=41&&id<=44,mayFail:id!=64,clobbers:List<Int>[0,1,2,6,7,8,9,10,11],dependencies:dependencies});
 };entries
};
public let verify:Function(List<Helper>):Result<Unit,Diagnostic>=function(entries:List<Helper>):Result<Unit,Diagnostic>{
 let span:Span=Span{start:0,end:0,line:1,column:1};var seen:List<Int>=List<Int>[];
 loop over(entries as helper:Helper){loop over(seen as id:Int){try require(id!=helper->id,span,"duplicate runtime helper");};seen=seen->append(helper->id);
  loop over(helper->dependencies as needed:Int){var found:Bool=false;loop over(entries as candidate:Helper){branch when{candidate->id==needed=>{found=true;},else=>unit};};try require(found,span,"missing runtime helper dependency");};
  loop over(helper->clobbers as reg:Int){try require(reg!=3&&reg!=4&&reg!=5&&reg<12,span,"runtime helper callee-save clobber");};
 };Result<Unit,Diagnostic>::Ok(unit)
};
