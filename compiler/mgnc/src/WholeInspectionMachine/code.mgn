namespace Mgnc\WholeInspectionMachine;
use Mgnc\Data\{Paged,Diagnostic,Span,empty,push,lookup};
use Mgnc\Machine\{Code,Record,flush};
use Mgnc\WholeNativeData\{Native,Global};
use Mgnc\WholeChecks\{require};
use Mgnc\Tables\{atList};
use Mgnc\IntMap\{Map,create,get,put};
let same:Function(List<Int>,List<Int>):Bool=function(left:List<Int>,right:List<Int>):Bool{branch when{left->length()!=right->length()=>{return false;},else=>unit};var i:Int=0;loop over(left as value:Int){let other:Int=branch on right->at(i){Result<Int,IndexError>::Ok(found:Int)=>found,Result<Int,IndexError>::Err(error:IndexError)=>{return false;}};branch when{value!=other=>{return false;},else=>unit};i=i+1;};true};
let tail:Function(List<Int>,List<Int>):Bool=function(data:List<Int>,suffix:List<Int>):Bool{branch when{data->length()<suffix->length()=>{return false;},else=>unit};var index:Int=0;loop over(suffix as value:Int){let other:Int=branch on data->at(data->length()-suffix->length()+index){Result<Int,IndexError>::Ok(found:Int)=>found,Result<Int,IndexError>::Err(error:IndexError)=>{return false;}};branch when{value!=other=>{return false;},else=>unit};index=index+1;};true};
let append:Function(List<Int>,List<Int>):List<Int>=function(left:List<Int>,right:List<Int>):List<Int>{var out:List<Int>=left;loop over(right as value:Int){out=out->append(value);};out};
let bytes:Function(Int,Int):List<Int>=function(value:Int,count:Int):List<Int>{var remaining:Int=value;var out:List<Int>=List<Int>[];var index:Int=0;loop while(index<count){let rem:Int=remaining%256;out=out->append(branch when{rem<0=>rem+256,else=>rem});remaining=remaining/256-branch when{rem<0=>1,else=>0};index=index+1;};out};
let pattern:Function(List<Int>,Int,Int):List<Int>=function(prefix:List<Int>,value:Int,size:Int):List<Int>{append(prefix,bytes(value,size))};
let occurrences:Function(List<Int>,List<Int>):Int=function(data:List<Int>,wanted:List<Int>):Int{var count:Int=0;var window:List<Int>=List<Int>[];loop over(data as value:Int){window=window->append(value);branch when{window->length()>wanted->length()=>{var out:List<Int>=List<Int>[];var ordinal:Int=0;loop over(window as octet:Int){branch when{ordinal>0=>{out=out->append(octet);},else=>unit};ordinal=ordinal+1;};window=out;},else=>unit};branch when{same(window,wanted)=>{count=count+1;},else=>unit};};count};
type State=product{pc:Int;ownership:Int;};
let ownership:Function(Code,Map,Int,Int,Span):Result<Unit,Diagnostic>=function(code:Code,labels:Map,start:Int,limit:Int,span:Span):Result<Unit,Diagnostic>{var queue:Paged<State>=push<State>(empty<State>(),State{pc:start,ownership:0});var index:Int=0;var seen:Map=create();loop while(index<queue->count){let state:State=try lookup<State>(queue,index);index=index+1;try require(state->pc>=start&&state->pc<limit,span,"inspection control escapes helper");let key:Int=(state->pc-start)*4+state->ownership;branch when{(try get(seen,key))>=0=>{continue;},else=>unit};seen=try put(seen,key,1);let record:Record=try lookup<Record>(code->records,state->pc);var owned:Int=state->ownership;
 branch when{record->kind==3&&record->value==168&&(tail(record->bytes,List<Int>[73,137,159])||tail(record->bytes,List<Int>[73,137,135]))=>{
  let previous:Record=try lookup<Record>(code->records,state->pc-1);
  branch when{tail(record->bytes,List<Int>[73,137,159])=>{try require(owned==0&&previous->kind==3&&previous->value==0&&tail(previous->bytes,List<Int>[72,137,131]),span,"inspection resource registration");owned=1;},tail(record->bytes,List<Int>[73,137,135])=>{try require(owned==2&&previous->kind==3&&previous->value==0&&tail(previous->bytes,List<Int>[72,139,131]),span,"inspection cleanup before release");owned=3;},else=>{try require(false,span,"inspection resource pointer");}};
 },record->kind==2&&tail(record->bytes,List<Int>[232])=>{
  branch when{record->target==10=>{try require(owned==3,span,"inspection result allocates while owning resources");},record->target==60=>{let following:Record=try lookup<Record>(code->records,state->pc+1);try require(owned==1&&following->kind==3&&following->value==16&&tail(following->bytes,List<Int>[72,137,131]),span,"inspection map registration");},record->target==61=>{try require(owned==1,span,"inspection cleanup ownership");owned=2;},else=>{try require(false,span,"inspection unexpected runtime call");}};
 },else=>unit};
 branch when{record->kind==0&&tail(record->bytes,List<Int>[65,95,65,94,65,93,65,92,91,93,195])=>{try require(owned==3,span,"inspection return retains resources");let restored:Record=try lookup<Record>(code->records,state->pc-1);try require(restored->kind==3&&restored->value==568&&tail(restored->bytes,List<Int>[72,129,196]),span,"inspection frame and callee saves");let rootStore:Record=try lookup<Record>(code->records,state->pc-2);let rootLoad:Record=try lookup<Record>(code->records,state->pc-3);try require(rootStore->kind==3&&rootStore->value==0&&tail(rootStore->bytes,List<Int>[73,137,151])&&rootLoad->kind==3&&rootLoad->value== -64&&tail(rootLoad->bytes,List<Int>[72,139,149]),span,"inspection root frame restore");continue;},else=>unit};var fallthrough:Bool=true;branch when{record->kind==2&&!tail(record->bytes,List<Int>[232])=>{let unconditional:Bool=tail(record->bytes,List<Int>[233]);try require(unconditional||record->bytes->length()>=2&&(try atList<Int>(record->bytes,record->bytes->length()-2))==15,span,"inspection branch opcode");branch when{record->target<128=>{try require(record->target==1||record->target==2,span,"inspection terminal target");},else=>{queue=push<State>(queue,State{pc:try get(labels,record->target),ownership:owned});}};fallthrough=!unconditional;},else=>unit};branch when{fallthrough=>{queue=push<State>(queue,State{pc:state->pc+1,ownership:owned});},else=>unit};
 };Result<Unit,Diagnostic>::Ok(unit)};
public let verify:Function(Native,Code):Result<Unit,Diagnostic>=function(plan:Native,initial:Code):Result<Unit,Diagnostic>{var selected:Bool=false;loop over(plan->globals->pages->append(plan->globals->tail) as page:List<Global>){loop over(page as global:Global){branch when{global->standard=="inspectPath"=>{selected=true;},else=>unit};};};branch when{!selected=>{return Result<Unit,Diagnostic>::Ok(unit);},else=>unit};let code:Code=flush(initial);let span:Span=Span{start:0,end:0,line:1,column:1};// Collect every actual relocation queried by these helper regions, including
 // a forged target outside its region, so rejection priority remains unchanged.
 var queriedLabels:Map=create();var indexingRegion:Bool=false;
 loop over(code->records->pages->append(code->records->tail) as records:List<Record>){loop over(records as record:Record){branch when{record->kind==1&&record->target<256=>{indexingRegion=record->target==76;},else=>unit};branch when{indexingRegion&&(record->kind==2||record->kind==5)&&record->target>=256=>{queriedLabels=try put(queriedLabels,record->target,1);},else=>unit};};};
 var labels:Map=create();var ordinal:Int=0;loop over(code->records->pages->append(code->records->tail) as page:List<Record>){loop over(page as record:Record){branch when{record->kind==1&&(record->target<256||(try get(queriedLabels,record->target))>=0)=>{labels=try put(labels,record->target,ordinal);},else=>unit};ordinal=ordinal+1;};};let start:Int=(try get(labels,76))+1;try require(start>0,span,"inspection entry");let first:Record=try lookup<Record>(code->records,start);try require(first->kind==3&&first->value==568&&same(first->bytes,List<Int>[85,72,137,229,83,65,84,65,85,65,86,65,87,72,129,236]),span,"inspection frame and callee saves");var cursor:Int=start;var data:List<Int>=List<Int>[];var calls:List<Int>=List<Int>[];
 loop while(cursor<code->records->count){let record:Record=try lookup<Record>(code->records,cursor);branch when{record->kind==1&&record->target<256=>{break;},else=>unit};data=append(data,record->bytes);branch when{record->kind==2||record->kind==3=>{data=append(data,bytes(branch when{record->kind==3=>record->value,else=>0},4));},record->kind==4||record->kind==5=>{data=append(data,bytes(branch when{record->kind==4=>record->value,else=>0},8));},else=>unit};branch when{record->kind==4&&same(record->bytes,List<Int>[72,184])=>{let next:Record=try lookup<Record>(code->records,cursor+1);branch when{next->bytes->length()>=2&&(try atList<Int>(next->bytes,0))==15&&(try atList<Int>(next->bytes,1))==5=>{calls=calls->append(record->value);},else=>unit};},else=>unit};branch when{record->kind==3&&(record->value==256||record->value==264)&&record->bytes->length()>=3&&(try atList<Int>(record->bytes,record->bytes->length()-1))==36&&(try atList<Int>(record->bytes,record->bytes->length()-3))==137=>{try require(false,span,"inspection overwrites identity snapshot");},else=>unit};cursor=cursor+1;};try require(same(calls,List<Int>[262]),span,"inspection syscall set");
 var stat:List<Int>=pattern(List<Int>[72,191],-100,8);stat=append(stat,pattern(List<Int>[72,139,179],16,4));stat=append(stat,pattern(List<Int>[72,141,148,36],256,4));stat=append(stat,pattern(List<Int>[73,186],256,8));stat=append(stat,pattern(List<Int>[72,184],262,8));stat=append(stat,List<Int>[15,5]);try require(occurrences(data,stat)==1,span,"inspection stat ABI and nofollow");
 var snapshot:List<Int>=pattern(List<Int>[72,139,148,36],256,4);snapshot=append(snapshot,pattern(List<Int>[72,137,144],24,4));snapshot=append(snapshot,pattern(List<Int>[72,139,148,36],264,4));snapshot=append(snapshot,pattern(List<Int>[72,137,144],32,4));snapshot=append(snapshot,pattern(List<Int>[72,137,133],-80,4));try require(occurrences(data,snapshot)==1,span,"inspection identity snapshot transport");try require(occurrences(data,append(pattern(List<Int>[72,184],-1,8),pattern(List<Int>[72,137,131],8,4)))==1,span,"inspection absent file descriptor");try ownership(code,labels,start,cursor,span);Result<Unit,Diagnostic>::Ok(unit)
};
