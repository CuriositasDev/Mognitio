namespace Mgnc\WholeDirectoryValues;
use Mgnc\WholeDirectoryData\{Types};
use Mgnc\Machine\{Code,label,jump,fresh,raw};
use Mgnc\WholeX64\{mov,load,store,address,immediate,alu,constant,byteLoad,byteStore};
public let allocate:Function(Code,Int,Int):Code=function(initial:Code,size:Int,descriptor:Int):Code{jump(immediate(immediate(initial,7,size),6,descriptor),List<Int>[232],10)};
// Raw name offset/byte/scalar homes are retained across every managed allocation.
public let name:Function(Code,Types):Code=function(initial:Code,types:Types):Code{var code:Code=load(initial,7,5,-192);code=constant(code,0,7,40);code=jump(code,List<Int>[15,128],1);code=immediate(code,6,types->string);code=jump(code,List<Int>[232],10);code=load(code,2,5,-192);code=store(code,0,24,2);code=load(code,2,5,-200);code=store(code,0,32,2);code=store(code,5,-80,0);code=address(code,7,0,40);code=load(code,6,5,-880);code=load(code,2,5,-184);code=alu(code,1,6,2);code=load(code,1,5,-192);raw(code,List<Int>[243,164])};
public let childSubject:Function(Code,Types):Code=function(initial:Code,types:Types):Code{var code:Code=load(initial,6,5,-72);code=load(code,1,6,24);code=alu(code,1,6,1);code=byteLoad(code,0,6,39);code=immediate(code,14,0);let separated:Int=code->nextLabel;let copied:Int=separated+1;code=fresh(code,2);code=constant(code,7,0,47);code=jump(code,List<Int>[15,132],separated);code=immediate(code,14,1);code=label(code,separated);code=load(code,0,5,-72);code=load(code,13,0,32);code=load(code,0,5,-80);code=load(code,0,0,32);code=alu(code,1,13,0);code=jump(code,List<Int>[15,128],6);code=alu(code,1,13,14);code=jump(code,List<Int>[15,128],6);code=load(code,0,5,-72);code=load(code,12,0,24);code=load(code,0,5,-80);code=load(code,0,0,24);code=alu(code,1,12,0);code=jump(code,List<Int>[15,128],1);code=alu(code,1,12,14);code=jump(code,List<Int>[15,128],1);code=mov(code,7,12);code=constant(code,0,7,40);code=jump(code,List<Int>[15,128],1);code=immediate(code,6,types->string);code=jump(code,List<Int>[232],10);code=store(code,0,24,12);code=store(code,0,32,13);code=store(code,5,-128,0);code=address(code,7,0,40);code=load(code,6,5,-72);code=load(code,1,6,24);code=constant(code,0,6,40);code=raw(code,List<Int>[243,164]);code=alu(code,133,14,14);code=jump(code,List<Int>[15,132],copied);code=immediate(code,0,47);code=byteStore(code,7,0,0);code=constant(code,0,7,1);code=label(code,copied);code=load(code,6,5,-80);code=load(code,1,6,24);code=constant(code,0,6,40);code=raw(code,List<Int>[243,164]);code=load(code,0,5,-128);store(code,5,-72,0)};
public let materialize:Function(Code,Types):Code=function(initial:Code,types:Types):Code{var code:Code=initial;loop over(List<Int>[-688,-880,-208] as slot:Int){code=load(code,0,5,slot);code=store(code,4,branch when{slot== -688=>0,slot== -880=>8,else=>16},0);};code=jump(code,List<Int>[232],88);code=immediate(code,12,0);code=immediate(code,14,0);let next:Int=code->nextLabel;let unique:Int=next+1;let skip:Int=next+2;let done:Int=next+3;let length:Int=next+4;code=fresh(code,5);code=label(code,next);code=load(code,1,5,-208);code=alu(code,57,12,1);code=jump(code,List<Int>[15,131],done);code=mov(code,0,12);code=immediate(code,1,40);code=raw(code,List<Int>[72,247,225]);code=load(code,13,5,-688);code=alu(code,1,13,0);code=alu(code,133,14,14);code=jump(code,List<Int>[15,132],unique);code=store(code,4,0,14);code=store(code,4,8,13);code=load(code,0,5,-880);code=store(code,4,16,0);code=jump(code,List<Int>[232],86);code=alu(code,133,0,0);code=jump(code,List<Int>[15,132],skip);code=label(code,unique);var index:Int=0;loop over(List<Int>[-184,-192,-200,-1136] as slot:Int){code=load(code,0,13,index*8);code=store(code,5,slot,0);index=index+1;};code=name(code,types);code=allocate(code,40,types->entryKind);code=load(code,2,5,-1136);code=store(code,0,24,2);code=immediate(code,2,0);code=store(code,0,32,2);code=store(code,5,-88,0);code=allocate(code,40,types->entry);code=load(code,2,5,-80);code=store(code,0,24,2);code=load(code,2,5,-88);code=store(code,0,32,2);code=store(code,5,-96,0);code=load(code,0,5,-104);code=immediate(code,2,0);code=alu(code,133,0,0);code=jump(code,List<Int>[15,132],length);code=load(code,2,0,24);code=label(code,length);code=constant(code,0,2,1);code=jump(code,List<Int>[15,128],9);code=store(code,5,-1112,2);code=allocate(code,48,types->list);code=load(code,2,5,-1112);code=store(code,0,24,2);code=load(code,2,5,-104);code=store(code,0,32,2);code=load(code,2,5,-96);code=store(code,0,40,2);code=store(code,5,-104,0);code=mov(code,14,13);code=label(code,skip);code=constant(code,0,12,1);code=jump(code,List<Int>[233],next);code=label(code,done);code=load(code,0,5,-104);store(code,5,-128,0)};
