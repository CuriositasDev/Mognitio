namespace Mgnc;
use Mgnc\Data\{Paged,Span,Diagnostic,empty,push,lookup};
use Mgnc\InputData\{SourceUnit,ProjectInput,InputError};
use Mgnc\Semantic\{SemanticProject,analyze};
use Mgnc\WholeLower\{lower};use Mgnc\WholeIR\{Project};
use Mgnc\WholePipeline\{prepare};use Mgnc\WholeNativeData\{Native};
use Mgnc\WholeNativeCheck\{verify as nativeCheck};
use Mgnc\WholeRuntimeTypes\{Info,RuntimeId,build,resolve};
use Mgnc\WholeRuntimeTypeCheck\{verify};
use Mgnc\WholeConcrete\{Plan};
use Mgnc\WholeConcreteTypes\{shape as equivalent};
use Mgnc\WholeSubstitution\{Binding};
use Mgnc\TypeData\{Store,Type};
use Mgnc\WholeStableKeys\{shape,vector,compare};
use Mgnc\TestTypePermutation\{mapped,permute,reorder};
use Mgnc\WholeChecks\{require};use Mgnc\Tables\{replaceItem};
use Std\Io\{writeStdout};
let reject:Function(Result<Unit,Diagnostic>,String):Result<Unit,Diagnostic>=function(result:Result<Unit,Diagnostic>,name:String):Result<Unit,Diagnostic>{let span:Span=Span{start:0,end:0,line:1,column:1};branch on result{Result<Unit,Diagnostic>::Ok(value:Unit)=>{try require(false,span,"accepted RuntimeTypeId mutation: "+name);},Result<Unit,Diagnostic>::Err(error:Diagnostic)=>{try require(error->phase=="internal",span,"wrong RuntimeTypeId mutation phase");discard writeStdout("V170_RUNTIME_TYPES_MUTANT "+name+"\n");}};Result<Unit,Diagnostic>::Ok(unit)};
let drop:Function(Paged<Int>):Paged<Int>=function(original:Paged<Int>):Paged<Int>{var out:Paged<Int>=empty<Int>();var index:Int=0;loop over(original->pages->append(original->tail) as page:List<Int>){loop over(page as value:Int){branch when{index+1<original->count=>{out=push<Int>(out,value);},else=>unit};index=index+1;};};out};
let reverse:Function(Paged<Int>):Result<Paged<Int>,Diagnostic>=function(original:Paged<Int>):Result<Paged<Int>,Diagnostic>{var out:Paged<Int>=empty<Int>();var index:Int=original->count;loop while(index>0){index=index-1;out=push<Int>(out,try lookup<Int>(original,index));};Result<Paged<Int>,Diagnostic>::Ok(out)};
let positive:Function(Plan,Info,Plan,Bool):Result<Unit,Diagnostic>=function(original:Plan,baseline:Info,changed:Plan,ids:Bool):Result<Unit,Diagnostic>{let span:Span=Span{start:0,end:0,line:1,column:1};let actual:Info=try build(changed);try verify(changed,actual);try require(actual->types->count==baseline->types->count,span,"permutation identity count");var index:Int=0;var moved:Int=0;loop while(index<baseline->values->count){let target:Int=branch when{ids=>mapped(index,baseline->values->count),else=>index};let expected:Int=try lookup<Int>(baseline->values,index);try require(expected==(try lookup<Int>(actual->values,target)),span,"coherent permutation RuntimeTypeId");branch when{expected>=0=>{try equivalent(original->types,changed->types,index,target,List<Binding>[],span);},else=>unit};branch when{target!=index=>{moved=moved+1;},else=>unit};index=index+1;};try require(!ids||moved>10,span,"nontrivial interner permutation");index=0;loop while(index<baseline->types->count){let left:Int=try lookup<Int>(baseline->types,index);let right:Int=try lookup<Int>(actual->types,index);try require((try compare(vector(try shape(original->types,left)),vector(try shape(changed->types,right))))==0,span,"permutation canonical representative");index=index+1;};Result<Unit,Diagnostic>::Ok(unit)};
let test:Function():Result<Unit,Diagnostic>=function():Result<Unit,Diagnostic>{let span:Span=Span{start:0,end:0,line:1,column:1};let input:SourceUnit=SourceUnit{path:"runtime-types.mgn",displayPath:"runtime-types.mgn",relativePath:"runtime-types.mgn",expectedNamespace:"",text:"namespace App;use Std\\Numeric\\{Bits,Signed};type A=product{value:Int;};type B=product{value:Int;};alias Alias=A;type Tag<N:Int>=product{};let signature:Function(Function(Bits<8>):Result<A,String>):Unit=function(value:Function(Bits<8>):Result<A,String>):Unit{unit};let main:Function(List<String>):Int=function(args:List<String>):Int{let a:Alias=A{value:3};let b:B=B{value:4};let tags:List<Tag<-7>>=List<Tag<-7>>[Tag<-7>{}];discard Tag<7>{};discard Int<8,Signed>{7};discard Bits<64>{1};discard tags;discard signature; a->value+b->value};"};let semantic:SemanticProject=branch on analyze(ProjectInput{manifestPath:"",manifestText:"",rootNamespace:"",entry:0,sources:List<SourceUnit>[input]}){Result<SemanticProject,InputError>::Ok(value:SemanticProject)=>value,Result<SemanticProject,InputError>::Err(error:InputError)=>{return Result<Unit,Diagnostic>::Err(error->diagnostic);}};let source:Project=try lower(semantic);let native:Native=try prepare(semantic);try nativeCheck(semantic,source,native);let plan:Plan=native->concrete;let info:Info=native->runtimeTypes;try verify(plan,info);let rebuilt:Info=try build(plan);try positive(plan,rebuilt,plan,false);let reversed:Plan=try permute(plan);try positive(plan,info,reversed,true);try positive(plan,info,try reorder(plan),false);try positive(plan,info,try reorder(reversed),true);
 var raw:Int= -1;var outside:Int= -1;var nominal:Int= -1;var nominalOther:Int= -1;var numeric:Bool=false;var bits:Bool=false;var functions:Bool=false;var lists:Bool=false;var results:Bool=false;var index:Int=0;loop over(plan->types->types->pages->append(plan->types->types->tail) as page:List<Type>){loop over(page as value:Type){let id:Int=try lookup<Int>(info->values,index);branch when{id<0=>{outside=index;},else=>{branch when{value->kind==1=>{raw=index;},value->kind==20&&value->members->length()==1=>{branch when{nominal<0=>{nominal=index;},else=>{nominalOther=index;}};},value->kind==23=>{numeric=true;},value->kind==24=>{bits=true;},value->kind==12=>{functions=true;},value->kind==10=>{lists=true;},value->kind==11=>{results=true;},else=>unit};}};index=index+1;};};try require(raw>=0&&outside>=0&&nominal>=0&&nominalOther>=0&&numeric&&bits&&functions&&lists&&results,span,"RuntimeTypeId family coverage");try require((try lookup<Int>(info->values,nominal))!=(try lookup<Int>(info->values,nominalOther)),span,"same-shape nominal identity");let rawId:Int=try lookup<Int>(info->values,raw);try require((try resolve(info,raw))->value==rawId,span,"raw scalar identity lookup");
 try reject(verify(plan,Info{values:empty<Int>(),types:info->types}),"compiler domain omitted");
 try reject(verify(plan,Info{values:push<Int>(info->values,-1),types:info->types}),"compiler domain extra");
 try reject(verify(plan,Info{values:info->values,types:empty<Int>()}),"identity closure omitted");
 try reject(verify(plan,Info{values:info->values,types:drop(info->types)}),"identity closure truncated");
 try reject(verify(plan,Info{values:info->values,types:push<Int>(info->types,raw)}),"duplicate representative");
 try reject(verify(plan,Info{values:info->values,types:try reverse(info->types)}),"reversed canonical order");
 try reject(verify(plan,Info{values:try replaceItem<Int>(info->values,raw,-1),types:info->types}),"scalar omitted");
 try reject(verify(plan,Info{values:try replaceItem<Int>(info->values,outside,0),types:info->types}),"non-emission assignment");
 try reject(verify(plan,Info{values:try replaceItem<Int>(info->values,raw,-2),types:info->types}),"invalid negative identity");
 try reject(verify(plan,Info{values:try replaceItem<Int>(info->values,raw,info->types->count),types:info->types}),"descriptor or out-of-domain identity");
 try reject(verify(plan,Info{values:try replaceItem<Int>(info->values,raw,(rawId+1)%info->types->count),types:info->types}),"wrong dense identity");
 try reject(verify(plan,Info{values:info->values,types:try replaceItem<Int>(info->types,rawId,outside)}),"non-emission representative");
 try reject(verify(reversed,info),"stale mapping after coherent interner permutation");
 branch on resolve(info,outside){Result<RuntimeId,Diagnostic>::Ok(value:RuntimeId)=>{try require(false,span,"outside-closure lookup accepted");},Result<RuntimeId,Diagnostic>::Err(error:Diagnostic)=>{try reject(Result<Unit,Diagnostic>::Err(error),"outside-closure lookup");}};
 let store:Store=plan->types;let late:Store=Store{headers:store->headers,types:push<Type>(store->types,try lookup<Type>(store->types,raw)),buckets:store->buckets,declarations:store->declarations,constraints:store->constraints};try reject(verify(Plan{pairs:plan->pairs,types:late,instances:plan->instances,initializers:plan->initializers},info),"late type-store growth");
 let bad:Info=Info{values:try replaceItem<Int>(info->values,raw,-1),types:info->types};try reject(nativeCheck(semantic,source,Native{abiRevision:native->abiRevision,dispatchTables:native->dispatchTables,runtimeTypes:bad,concrete:native->concrete,closures:native->closures,layouts:native->layouts,procedures:native->procedures,literals:native->literals,constructors:native->constructors,globals:native->globals,globalSymbols:native->globalSymbols,globalDeclarations:native->globalDeclarations,globalRoots:native->globalRoots,initializers:native->initializers,modules:native->modules,moduleCount:native->moduleCount,descriptors:native->descriptors,variants:native->variants,entryGlobal:native->entryGlobal,nextLabel:native->nextLabel}),"native pipeline integrates identity check");
 Result<Unit,Diagnostic>::Ok(unit)};
let main:Function(List<String>):Int=function(args:List<String>):Int{branch on test(){Result<Unit,Diagnostic>::Ok(value:Unit)=>{discard writeStdout("V170_RUNTIME_TYPES_OK valid=5 rejected=16\n");0},Result<Unit,Diagnostic>::Err(error:Diagnostic)=>{discard writeStdout(error->phase+": "+error->message+"\n");1}}};
