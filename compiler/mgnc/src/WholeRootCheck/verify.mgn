namespace Mgnc\WholeRootCheck;
use Std\Numeric\{Bits};
use Mgnc\Data\{Paged,Diagnostic,Span,empty,push,lookup};
use Mgnc\Syntax\{Parent};
use Mgnc\TypeData\{Store,Type};
use Mgnc\WholeIR\{Body,Block,Operation,Slot};
use Mgnc\WholeFrameData\{Frame,Point};
use Mgnc\WholeEffects\{allocating};
use Mgnc\WholeChecks\{require};
use Mgnc\IntMap\{Map,create,get,put};
use Mgnc\Tables\{atList};
use Mgnc\Facts\{mask,at as wordAt};
type Node=product{reads:List<Int>;write:Int;previous:List<Int>;};
type Graph=product{nodes:Paged<Node>;bases:Paged<Int>;};
let contains:Function(List<Int>,Int):Bool=function(values:List<Int>,wanted:Int):Bool{loop over(values as value:Int){branch when{value==wanted=>{return true;},else=>unit};};false};
// Build instruction-position predecessor edges independently of root planning.
let buildGraph:Function(Body):Result<Graph,Diagnostic>=function(body:Body):Result<Graph,Diagnostic>{
 var bases:Paged<Int>=empty<Int>();var count:Int=0;
 loop over(body->blocks->pages->append(body->blocks->tail) as page:List<Block>){loop over(page as block:Block){bases=push<Int>(bases,count);count=count+block->operations->length()+1;};};
 var heads:Map=create();var versions:Paged<List<Int>>=empty<List<Int>>();var blockId:Int=0;
 loop over(body->blocks->pages->append(body->blocks->tail) as page:List<Block>){loop over(page as block:Block){
  let end:Int=(try lookup<Int>(bases,blockId))+block->operations->length();
  loop over(block->terminator->targets as target:Int){let version:Int=try get(heads,target);let previous:List<Int>=branch when{version<0=>List<Int>[],else=>try lookup<List<Int>>(versions,version)};heads=try put(heads,target,versions->count);versions=push<List<Int>>(versions,previous->append(end));};blockId=blockId+1;
 };};
 var nodes:Paged<Node>=empty<Node>();blockId=0;
 loop over(body->blocks->pages->append(body->blocks->tail) as page:List<Block>){loop over(page as block:Block){
  let version:Int=try get(heads,blockId);var previous:List<Int>=branch when{version<0=>List<Int>[],else=>try lookup<List<Int>>(versions,version)};
  loop over(block->operations as op:Operation){let id:Int=nodes->count;let written:Int=branch on op->output{Parent::None=> -1,Parent::Some(slot:Int)=>slot};nodes=push<Node>(nodes,Node{reads:op->inputs,write:written,previous:previous});previous=List<Int>[id];};
  nodes=push<Node>(nodes,Node{reads:block->terminator->inputs,write:-1,previous:previous});blockId=blockId+1;
 };};Result<Graph,Diagnostic>::Ok(Graph{nodes:nodes,bases:bases})
};
// Index reads once. The oracle still enumerates predecessor paths per slot,
// without using the producer's fixed-point facts or retaining every slot's map.
type Reads=product{heads:Map;values:Paged<List<Int>>;};
type Checkpoint=product{position:Int;ignored:Int;bitmap:List<Bits<64>>;};
let readIndex:Function(Graph):Result<Reads,Diagnostic>=function(graph:Graph):Result<Reads,Diagnostic>{var heads:Map=create();var values:Paged<List<Int>>=empty<List<Int>>();var position:Int=0;loop over(graph->nodes->pages->append(graph->nodes->tail) as page:List<Node>){loop over(page as node:Node){loop over(node->reads as slot:Int){let prior:Int=try get(heads,slot);let list:List<Int>=branch when{prior<0=>List<Int>[],else=>try lookup<List<Int>>(values,prior)};heads=try put(heads,slot,values->count);values=push<List<Int>>(values,list->append(position));};position=position+1;};};Result<Reads,Diagnostic>::Ok(Reads{heads:heads,values:values})};
let livePositions:Function(Graph,Reads,Int):Result<Map,Diagnostic>=function(graph:Graph,index:Reads,slot:Int):Result<Map,Diagnostic>{var reached:Map=create();var queue:Paged<Int>=empty<Int>();let version:Int=try get(index->heads,slot);branch when{version>=0=>{loop over((try lookup<List<Int>>(index->values,version)) as position:Int){queue=push<Int>(queue,position);};},else=>unit};var cursor:Int=0;loop while(cursor<queue->count){let position:Int=try lookup<Int>(queue,cursor);cursor=cursor+1;branch when{(try get(reached,position))>=0=>{continue;},else=>unit};reached=try put(reached,position,1);let node:Node=try lookup<Node>(graph->nodes,position);loop over(node->previous as previous:Int){let prior:Node=try lookup<Node>(graph->nodes,previous);branch when{prior->write!=slot&&(try get(reached,previous))<0=>{queue=push<Int>(queue,previous);},else=>unit};};};Result<Map,Diagnostic>::Ok(reached)};
let bitmap:Function(Body,List<Bits<64>>,Span):Result<Unit,Diagnostic>=function(body:Body,actual:List<Bits<64>>,span:Span):Result<Unit,Diagnostic>{try require(actual->length()==(body->slots->count+63)/64,span,"root bitmap shape");var slot:Int=body->slots->count;loop while(slot<actual->length()*64){try require((try wordAt(actual,slot/64,span))->and(try mask(slot,span))==Bits<64>{0},span,"root bitmap padding");slot=slot+1;};Result<Unit,Diagnostic>::Ok(unit)};
let bitmapShape:Function(Body,List<Bits<64>>,Span):Result<Unit,Diagnostic>=function(body:Body,actual:List<Bits<64>>,span:Span):Result<Unit,Diagnostic>{try require(actual->length()==(body->slots->count+63)/64,span,"root bitmap shape");Result<Unit,Diagnostic>::Ok(unit)};
public let verify:Function(Store,Body,Frame):Result<Unit,Diagnostic>=function(store:Store,body:Body,frame:Frame):Result<Unit,Diagnostic>{
 let span:Span=(try lookup<Block>(body->blocks,body->entry))->terminator->origin->span;try require(frame->slots>=0&&frame->slots<=268435440&&frame->outgoing>=8&&frame->outgoing<=268435440-frame->slots,span,"frame size bounds");try require(frame->slots==body->slots->count&&frame->extent%16==0&&frame->extent>=64+frame->slots*8+frame->outgoing*8&&frame->extent<2147483648,span,"frame layout or alignment");
 let graph:Graph=try buildGraph(body);let reads:Reads=try readIndex(graph);try bitmapShape(body,frame->entry,span);var checkpoints:Paged<Checkpoint>=push<Checkpoint>(empty<Checkpoint>(),Checkpoint{position:try lookup<Int>(graph->bases,body->entry),ignored:-1,bitmap:frame->entry});var seen:Map=create();
 loop over(frame->points->pages->append(frame->points->tail) as page:List<Point>){loop over(page as point:Point){let block:Block=try lookup<Block>(body->blocks,point->block);try require(point->operation>=0&&point->operation<block->operations->length(),span,"root point operation bounds");let position:Int=(try lookup<Int>(graph->bases,point->block))+point->operation;try require((try get(seen,position))<0,span,"duplicate root point");seen=try put(seen,position,1);let op:Operation=try atList<Operation>(block->operations,point->operation);try require(try allocating(store,body,op),span,"root point on nonallocating operation");try bitmapShape(body,point->roots,span);checkpoints=push<Checkpoint>(checkpoints,Checkpoint{position:position,ignored:-1,bitmap:point->roots});
  branch when{op->code=="call"||op->code=="field-call"||op->code=="dispatch"=>{try bitmapShape(body,point->handoff,span);checkpoints=push<Checkpoint>(checkpoints,Checkpoint{position:position+1,ignored:branch on op->output{Parent::None=>-1,Parent::Some(slot:Int)=>slot},bitmap:point->handoff});},else=>{try require(point->handoff->length()==0,span,"unexpected call handoff bitmap");}};
 };};
 var expectedPoints:Int=0;var maximum:Int=8;loop over(body->blocks->pages->append(body->blocks->tail) as page:List<Block>){loop over(page as block:Block){loop over(block->operations as op:Operation){branch when{try allocating(store,body,op)=>{expectedPoints=expectedPoints+1;},else=>unit};branch when{op->inputs->length()+4>maximum=>{maximum=op->inputs->length()+4;},else=>unit};};};};try require(expectedPoints==frame->points->count,span,"missing allocation root point");try require(frame->outgoing==maximum&&frame->extent==((64+body->slots->count*8+maximum*8+15)/16)*16,span,"outgoing argument capacity");
 var mismatch:Int= -1;var missing:Bool=false;var slotId:Int=0;loop over(body->slots->pages->append(body->slots->tail) as page:List<Slot>){loop over(page as slot:Slot){let kind:Int=(try lookup<Type>(store->types,slot->valueType))->kind;let reference:Bool=kind==3||kind==4||kind==5||kind==10||kind==11||kind==12||kind==20||kind==21||kind==25||kind==26||kind==27||kind==28||kind==29;let reached:Map=branch when{reference=>try livePositions(graph,reads,slotId),else=>create()};let bit:Bits<64>=try mask(slotId,span);
  var ordinal:Int=0;loop over(checkpoints->pages->append(checkpoints->tail) as checks:List<Checkpoint>){loop over(checks as check:Checkpoint){let expected:Bool=slotId!=check->ignored&&reference&&(try get(reached,check->position))>=0;let selected:Bool=(try wordAt(check->bitmap,slotId/64,span))->and(bit)!=Bits<64>{0};branch when{expected!=selected&&(mismatch<0||ordinal<mismatch)=>{mismatch=ordinal;missing=expected;},else=>unit};ordinal=ordinal+1;};};slotId=slotId+1;
 };};
 // Preserve checkpoint/slot diagnostic priority while holding one slot map.
 var ordinal:Int=0;loop over(checkpoints->pages->append(checkpoints->tail) as checks:List<Checkpoint>){loop over(checks as check:Checkpoint){try require(ordinal!=mismatch,span,branch when{missing=>"missing live managed root",else=>"dead or scalar root retained"});try bitmap(body,check->bitmap,span);ordinal=ordinal+1;};};Result<Unit,Diagnostic>::Ok(unit)
};
