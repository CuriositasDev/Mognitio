namespace Mgnc\WholeConcreteTypes;
use Mgnc\NumericShape\{read as numericShape};
use Mgnc\Data\{Paged,Diagnostic,Span,empty,push,lookup};
use Mgnc\Syntax\{Parent};
use Mgnc\TypeData\{Store,Type,Argument,ValueTerm,Member};
use Mgnc\TypeOps\{parentEqual,valueEqual,argumentsEqual};
use Mgnc\WholeSubstitution\{Binding};
use Mgnc\WholeChecks\{require,present};
use Mgnc\Tables\{atList};
use Mgnc\IntMap\{Map,create,get,put};
public let bound:Function(List<Binding>,Int,Int,Span):Result<Argument,Diagnostic>=function(bindings:List<Binding>,owner:Int,ordinal:Int,span:Span):Result<Argument,Diagnostic>{
 loop over(bindings as binding:Binding){branch when{binding->owner==owner=>{return atList<Argument>(binding->arguments,ordinal);},else=>unit};};
 try require(false,span,"concrete missing parameter owner");Result<Argument,Diagnostic>::Ok(Argument::Type(0))
};
public let value:Function(ValueTerm,List<Binding>,Span):Result<ValueTerm,Diagnostic>=function(original:ValueTerm,bindings:List<Binding>,span:Span):Result<ValueTerm,Diagnostic>{
 branch on original->parameter{Parent::None=>Result<ValueTerm,Diagnostic>::Ok(original),Parent::Some(ordinal:Int)=>{
  let actual:Argument=try bound(bindings,original->owner,ordinal,span);
  branch on actual{Argument::Value(term:ValueTerm)=>{try require(parentEqual(term->parameter,Parent::None),span,"concrete unresolved value");Result<ValueTerm,Diagnostic>::Ok(term)},Argument::Type(typeId:Int)=>{try require(false,span,"concrete value argument kind");Result<ValueTerm,Diagnostic>::Ok(original)}}
 }}
};
// Compare a source type graph against substituted output without invoking the producer.
type Pair=product{source:Int;actual:Int;};
public let shape:Function(Store,Store,Int,Int,List<Binding>,Span):Result<Unit,Diagnostic>=function(source:Store,actual:Store,sourceId:Int,actualId:Int,bindings:List<Binding>,span:Span):Result<Unit,Diagnostic>{
 var queue:Paged<Pair>=push<Pair>(empty<Pair>(),Pair{source:sourceId,actual:actualId});var cursor:Int=0;var visited:Map=create();
 loop while(cursor<queue->count){
  let pair:Pair=try lookup<Pair>(queue,cursor);cursor=cursor+1;
  let known:Int=try get(visited,pair->source);branch when{known>=0=>{try require(known==pair->actual,span,"concrete canonical type mapping");continue;},else=>unit};
  visited=try put(visited,pair->source,pair->actual);
  let original:Type=try lookup<Type>(source->types,pair->source);let result:Type=try lookup<Type>(actual->types,pair->actual);
  branch when{original->kind==22=>{
   let ordinal:ValueTerm=branch on try atList<Argument>(original->arguments,0){Argument::Value(term:ValueTerm)=>term,Argument::Type(typeId:Int)=>{try require(false,span,"concrete parameter shape");ValueTerm{parameter:Parent::None,owner:0,value:0}}};
   let argument:Argument=try bound(bindings,try present(original->owner,span,"concrete parameter owner"),ordinal->value,span);
   let expected:Int=branch on argument{Argument::Type(typeId:Int)=>typeId,Argument::Value(term:ValueTerm)=>{try require(false,span,"concrete type argument kind");0}};
   try require(expected==pair->actual,span,"concrete type substitution");continue;
  },else=>unit};
  try require(original->kind==result->kind&&parentEqual(original->owner,result->owner)&&original->arguments->length()==result->arguments->length()&&original->members->length()==result->members->length(),span,"concrete type structure");
  var index:Int=0;
  loop over(original->arguments as argument:Argument){let other:Argument=try atList<Argument>(result->arguments,index);index=index+1;
   branch on argument{Argument::Type(typeId:Int)=>branch on other{Argument::Type(otherId:Int)=>{queue=push<Pair>(queue,Pair{source:typeId,actual:otherId});},Argument::Value(term:ValueTerm)=>{try require(false,span,"concrete argument kind");}},Argument::Value(term:ValueTerm)=>branch on other{Argument::Value(otherTerm:ValueTerm)=>{try require(valueEqual(try value(term,bindings,span),otherTerm),span,"concrete value substitution");},Argument::Type(otherId:Int)=>{try require(false,span,"concrete argument kind");}}};
  };
  index=0;loop over(original->members as member:Member){let other:Member=try atList<Member>(result->members,index);index=index+1;try require(member->name==other->name,span,"concrete member name");
   branch on member->value{Parent::None=>{try require(parentEqual(other->value,Parent::None),span,"concrete empty member");},Parent::Some(typeId:Int)=>{queue=push<Pair>(queue,Pair{source:typeId,actual:try present(other->value,span,"concrete member type")});}};
  };
 };Result<Unit,Diagnostic>::Ok(unit)
};
public let arguments:Function(Store,Store,List<Argument>,List<Argument>,List<Binding>,Span):Result<Unit,Diagnostic>=function(source:Store,actual:Store,original:List<Argument>,result:List<Argument>,bindings:List<Binding>,span:Span):Result<Unit,Diagnostic>{
 try require(original->length()==result->length(),span,"concrete argument count");var index:Int=0;
 loop over(original as argument:Argument){let other:Argument=try atList<Argument>(result,index);index=index+1;
  branch on argument{Argument::Type(typeId:Int)=>branch on other{Argument::Type(otherId:Int)=>{try shape(source,actual,typeId,otherId,bindings,span);},Argument::Value(term:ValueTerm)=>{try require(false,span,"concrete argument kind");}},Argument::Value(term:ValueTerm)=>branch on other{Argument::Value(otherTerm:ValueTerm)=>{try require(valueEqual(try value(term,bindings,span),otherTerm),span,"concrete value substitution");},Argument::Type(otherId:Int)=>{try require(false,span,"concrete argument kind");}}};
 };Result<Unit,Diagnostic>::Ok(unit)
};
public let optional:Function(Store,Store,Parent,Parent,List<Binding>,Span):Result<Unit,Diagnostic>=function(source:Store,actual:Store,original:Parent,result:Parent,bindings:List<Binding>,span:Span):Result<Unit,Diagnostic>{
 branch on original{Parent::None=>{try require(parentEqual(result,Parent::None),span,"concrete absent type");},Parent::Some(typeId:Int)=>{try shape(source,actual,typeId,try present(result,span,"concrete missing type"),bindings,span);}};Result<Unit,Diagnostic>::Ok(unit)
};
public let closed:Function(Store,Int,Span):Result<Unit,Diagnostic>=function(store:Store,root:Int,span:Span):Result<Unit,Diagnostic>{
 var pending:Paged<Int>=push<Int>(empty<Int>(),root);var cursor:Int=0;var seen:Map=create();
 loop while(cursor<pending->count){let id:Int=try lookup<Int>(pending,cursor);cursor=cursor+1;branch when{(try get(seen,id))>=0=>{continue;},else=>unit};seen=try put(seen,id,1);
  let item:Type=try lookup<Type>(store->types,id);try require(item->kind<22||item->kind==23||item->kind==24||item->kind==25||item->kind==26||item->kind==27||item->kind==28||item->kind==29,span,"concrete unresolved or unsupported type");
  branch when{item->kind==23||item->kind==24=>{discard try numericShape(store,id,span);},else=>unit};
  loop over(item->arguments as argument:Argument){branch on argument{Argument::Type(child:Int)=>{pending=push<Int>(pending,child);},Argument::Value(term:ValueTerm)=>{try require(parentEqual(term->parameter,Parent::None),span,"concrete unresolved value");}};};
  loop over(item->members as member:Member){branch on member->value{Parent::Some(child:Int)=>{pending=push<Int>(pending,child);},Parent::None=>unit};};
 };Result<Unit,Diagnostic>::Ok(unit)
};
public let prefix:Function(Store,Store,Span):Result<Unit,Diagnostic>=function(source:Store,actual:Store,span:Span):Result<Unit,Diagnostic>{
 try require(actual->types->count>=source->types->count,span,"concrete type prefix size");var index:Int=0;
 loop over(source->types->pages->append(source->types->tail) as page:List<Type>){loop over(page as original:Type){let result:Type=try lookup<Type>(actual->types,index);index=index+1;
  try require(original->kind==result->kind&&parentEqual(original->owner,result->owner)&&argumentsEqual(original->arguments,result->arguments)&&original->members->length()==result->members->length(),span,"concrete source type prefix");
  var position:Int=0;loop over(original->members as member:Member){let other:Member=try atList<Member>(result->members,position);position=position+1;try require(member->name==other->name&&parentEqual(member->value,other->value),span,"concrete source member prefix");};
 };};Result<Unit,Diagnostic>::Ok(unit)
};
