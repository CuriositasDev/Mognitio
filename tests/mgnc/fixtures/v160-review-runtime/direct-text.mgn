namespace App;var value:String="old"+" value";let reader:Function():String=function():String{value};let changed:Unit={value="new"+" value";unit};let main:Function(List<String>):Int=function(args:List<String>):Int{var n:Int=0;loop while(n<32){discard "temporary"+" value";n=n+1;};branch when{reader()=="old value"=>0,else=>1}};
