namespace Mgnc\WholeDirectoryFinish;
use Mgnc\WholeDirectoryData\{Types,frame};
use Mgnc\WholeDirectoryValues\{allocate,name,childSubject,materialize};
use Mgnc\WholeFrame\{end};
use Mgnc\WholeABI\{resources};
use Mgnc\Machine\{Code,label,jump,fresh};
use Mgnc\WholeX64\{load,store,address,immediate,alu,constant};
let status:Function(Code,Bool):Code=function(initial:Code,closing:Bool):Code{var code:Code=constant(initial,7,0,-4095);code=jump(code,List<Int>[15,140],2);code=constant(code,7,0,-1);code=jump(code,List<Int>[15,143],2);branch when{closing=>{code=constant(code,7,0,-9);code=jump(code,List<Int>[15,132],2);},else=>unit};code};
let selected:Function(Code):Code=function(initial:Code):Code{var code:Code=initial;let kept:Int=code->nextLabel;code=fresh(code,1);code=load(code,1,5,-160);code=constant(code,7,1,-1);code=jump(code,List<Int>[15,133],kept);code=jump(code,List<Int>[232],83);code=store(code,5,-160,0);code=immediate(code,0,3);code=store(code,5,-1256,0);label(code,kept)};
let variant:Function(Code,Int,Int,Int):Code=function(initial:Code,descriptor:Int,tag:Int,slot:Int):Code{var code:Code=allocate(initial,40,descriptor);code=store(code,0,24,tag);code=immediate(code,2,0);code=store(code,0,32,2);store(code,5,slot,0)};
public let emit:Function(Code,Types):Code=function(initial:Code,types:Types):Code{var code:Code=load(initial,0,5,-1248);code=store(code,5,-1256,0);code=address(code,7,5,-512);code=jump(code,List<Int>[232],62);let closed:Int=code->nextLabel;let failed:Int=closed+1;let cleanup:Int=closed+2;code=fresh(code,3);code=alu(code,133,0,0);code=jump(code,List<Int>[15,132],closed);code=status(code,true);code=selected(code);code=label(code,closed);code=load(code,0,5,-160);code=constant(code,7,0,-1);code=jump(code,List<Int>[15,133],failed);code=materialize(code,types);code=jump(code,List<Int>[233],cleanup);code=label(code,failed);code=load(code,0,5,-176);code=alu(code,133,0,0);code=jump(code,List<Int>[15,132],cleanup);code=childSubject(name(code,types),types);code=label(code,cleanup);
 loop over(List<Int>[-896,-704,-512] as record:Int){code=load(code,0,15,resources);code=address(code,1,5,record);code=alu(code,57,0,1);code=jump(code,List<Int>[15,133],2);code=address(code,7,5,record);code=jump(code,List<Int>[232],61);code=alu(code,133,2,2);code=jump(code,List<Int>[15,133],2);let clean:Int=code->nextLabel;code=fresh(code,1);code=alu(code,133,0,0);code=jump(code,List<Int>[15,132],clean);code=status(code,false);code=selected(code);code=label(code,clean);code=load(code,0,5,record);branch when{record!= -512=>{code=address(code,1,5,record+192);code=alu(code,57,0,1);code=jump(code,List<Int>[15,133],2);},else=>unit};code=store(code,15,resources,0);};
 code=load(code,12,5,-160);code=load(code,13,5,-1256);let ok:Int=code->nextLabel;let result:Int=ok+1;code=fresh(code,2);code=constant(code,7,12,-1);code=jump(code,List<Int>[15,132],ok);code=immediate(code,0,0);loop over(List<Int>[-80,-88,-96,-104] as slot:Int){code=store(code,5,slot,0);};code=immediate(code,14,6);code=variant(code,types->operation,14,-112);code=variant(code,types->kind,12,-88);code=variant(code,types->phase,13,-120);code=allocate(code,56,types->error);var index:Int=0;loop over(List<Int>[-112,-88,-72,-120] as slot:Int){code=load(code,2,5,slot);code=store(code,0,24+index*8,2);index=index+1;};code=store(code,5,-128,0);code=immediate(code,14,1);code=jump(code,List<Int>[233],result);code=label(code,ok);code=immediate(code,14,0);code=label(code,result);code=allocate(code,40,types->result);code=store(code,0,24,14);code=load(code,2,5,-128);code=store(code,0,32,2);end(code,frame)};
