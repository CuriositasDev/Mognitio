public type Entry=product{key:Int;value:Int;};
public type Map=product{small:Level0;large:List<Entry>;};
public let create:Function():Map=function():Map{Map{small:blank0,large:List<Entry>[]}};
public let get:Function(Map,Int):Result<Int,Diagnostic>=function(table:Map,key:Int):Result<Int,Diagnostic>{
 branch when{key<0=>{return Result<Int,Diagnostic>::Err(problem("internal",Span{start:0,end:0,line:1,column:1},"negative radix key"));},key>=16777216=>{
  loop over(table->large as entry:Entry){branch when{entry->key==key=>{return Result<Int,Diagnostic>::Ok(entry->value);},else=>unit};};return Result<Int,Diagnostic>::Ok(-2);
 },else=>unit};
 let node0:Level0=table->small;
