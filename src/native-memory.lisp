(in-package #:mognitio.native.runtime)

(defun physical-size-unit ()
  (runtime-unit :physical-size
    '((:load-word :rax :rsp 8) (:add-imm :rax 39) (:jb :allocation-failed)
      (:and-imm :rax -8) (:ret))))

(defun repair-fit-cursors ()
  ;; A cursor is the address of a free-list link, not an object reference.
  ;; Removing its containing block redirects it to that block's incoming link.
  ;; Splits and consumption preserve the original first-fit ordering.
  `((:lea-base :r10 :r15 ,(context-field-offset :fit-cursors (test-image-p)))
    (:lea-base :rdx :r10 384) (:lea-base :rsi :r9 16)
    (:label :repair-fit) (:load-word :rdi :r10 0) (:cmp-reg :rdi :rsi)
    (:jnz :next-fit) (:store-word :r10 0 :r11)
    (:label :next-fit) (:add-imm :r10 8) (:cmp-reg :r10 :rdx)
    (:jb :repair-fit)))

(defun take-free-forms ()
  ;; R9 is a known fitting block, R11 the address of its incoming link,
  ;; RCX the requested physical size. No call, allocation, or GC is permitted.
  (append '((:load-word :r8 :r9 16)
    (:load-word :rdx :r9 0) (:sub-reg :rdx :rcx)
    (:cmp-imm :rdx 40) (:jb :whole)
    (:store-word :r9 0 :rcx) (:mov-reg :rax :r9) (:add-reg :rax :rcx)
    (:store-word :rax 0 :rdx) (:store-word :rax 16 :r8)
    (:imm-rdx 0) (:store-word :rax 8 :rdx) (:store-word :rax 24 :rdx)
    (:store-word :r11 0 :rax) (:jmp :taken)
    (:label :whole) (:store-word :r11 0 :r8)
    (:label :taken) (:imm-rax 1) (:store-word :r9 8 :rax)
    (:imm-rax 0) (:store-word :r9 16 :rax) (:store-word :r9 24 :rax))
    (repair-fit-cursors) '((:mov-reg :rax :r9))))

(defun find-free-unit ()
  (runtime-unit :find-free
    (append
      `((:load-word :rcx :rsp 8) (:imm-reg :r10 0)
        (:cmp-imm :rcx 40) (:jb :head) (:cmp-imm :rcx 160) (:ja :large)
        (:lea-base :r10 :r15 ,(- (context-field-offset :fit-cursors (test-image-p)) 40))
        (:add-reg :r10 :rcx) (:jmp :cached)
        ;; Large requests use a bounded direct-mapped exact-size cache. A hash
        ;; collision must invalidate the old cursor before reusing its slot.
        (:label :large) (:mov-reg :rax :rcx) (:and-imm :rax 248)
        (:lea-base :r8 :r15 ,(context-field-offset :large-fit-sizes (test-image-p)))
        (:add-reg :r8 :rax)
        (:lea-base :r10 :r15 ,(context-field-offset :large-fit-cursors (test-image-p)))
        (:add-reg :r10 :rax) (:load-word :r11 :r8 0) (:cmp-reg :r11 :rcx)
        (:jz :cached) (:store-word :r8 0 :rcx)
        (:imm-reg :r11 0) (:store-word :r10 0 :r11)
        (:label :cached) (:load-word :r11 :r10 0)
        (:cmp-imm :r11 0) (:jnz :cursor)
        (:label :head)
        (:lea-base :r11 :r15 ,(context-field-offset :free-head (test-image-p)))
        (:label :cursor) (:load-word :r9 :r11 0)
        (:label :block) (:cmp-imm :r9 0) (:jz :missing))
      (when (option :gc-counters) (bump 112))
      '((:load-word :rax :r9 0) (:cmp-reg :rax :rcx) (:jae :found)
        (:lea-base :r11 :r9 16) (:load-word :r9 :r11 0) (:jmp :block)
        (:label :found) (:cmp-imm :r10 0) (:jz :uncached)
        (:store-word :r10 0 :r11) (:label :uncached))
      (take-free-forms)
      '((:ret) (:label :missing) (:imm-rax 0) (:ret)))))

(defun watch-allocation ()
  ;; Observe one complete block lifecycle in three fixed records. This is a
  ;; lower bound on reuse, not a count of all allocations in reclaimed ranges.
  (when (option :trace)
    `((:load-word :rax :r15 ,+watch-state+) (:test) (:jnz :watch-existing)
      (:store-word :r15 ,+watch-pointer+ :r9)
      (:load-word :rdx :r9 0) (:store-word :r15 ,+watch-size+ :rdx)
      (:imm-rax 1) (:store-word :r15 ,+watch-state+ :rax)
      (:store-word :r15 ,+trace+ :rax) (:store-word :r15 ,(+ +trace+ 8) :r9)
      (:store-word :r15 ,(+ +trace+ 16) :rdx) (:jmp :watch-done)
      (:label :watch-existing) (:cmp-imm :rax 2) (:jnz :watch-done)
      (:load-word :rax :r15 ,+watch-pointer+) (:cmp-reg :rax :r9) (:jnz :watch-done)
      (:imm-rax 3) (:store-word :r15 ,+watch-state+ :rax)
      (:store-word :r15 ,(+ +trace+ 48) :rax) (:store-word :r15 ,(+ +trace+ 56) :r9)
      (:load-word :rax :r9 0) (:store-word :r15 ,(+ +trace+ 64) :rax)
      (:imm-rax 1) (:store-word :r15 ,+observed-reuses+ :rax)
      (:label :watch-done))))

(defun allocate-unit ()
  (let ((unit (option :arena-unit 1048576)) (cap (option :cap)))
    (unless (and (typep unit '(integer 4096 2147483647))
                 (or (null cap) (typep cap '(integer 4096 9223372036854775807))))
      (internal-error "Invalid internal heap configuration"))
    (runtime-unit :allocate-block
      (append (helper-frame 10)
        (when (option :fail-allocation)
          (unless (typep (option :fail-allocation) '(integer 1 2147483647))
            (internal-error "Invalid allocation fault ordinal"))
          (append (bump 232)
                  `((:cmp-imm :rax ,(option :fail-allocation)) (:jz :allocation-failed))))
        '((:load-frame :rax 16) (:store-out 0 :rax) (:call (:runtime :physical-size))
          (:store-frame -8 :rax))
        (when (option :stress) '((:call (:runtime :collect))))
        '((:load-frame :rax -8) (:store-out 0 :rax) (:call (:runtime :find-free))
          (:test) (:jnz :found) (:call (:runtime :collect)))
        ;; A tiny reclaimable tail must not force a full collection for every
        ;; short-lived object. Keep bounded reserve after collection; explicit
        ;; geometry/caps retain their original reuse and failure behavior.
        ;; One eighth of mapped space, capped at 16 MiB, leaves collection
        ;; headroom without exceeding the inherited whole-project RSS budget.
        ;; Count only blocks that fit this request. Fragmented small holes
        ;; otherwise hide a nearly exhausted supply of large allocations.
        (unless (or (option :arena-unit) cap)
          `((:load-word :rax :r15 ,+mapped-bytes+) (:imm-rcx 8) (:imm-rdx 0) (:div-rcx)
            (:cmp-imm :rax 16777216) (:jbe :reserve-sized) (:imm-rax 16777216)
            (:label :reserve-sized) (:mov-reg :r8 :rax) (:imm-rax 0)
            (:load-frame :r10 -8)
            (:load-word :r9 :r15 ,(context-field-offset :free-head (test-image-p)))
            (:label :reserve-block) (:cmp-reg :rax :r8) (:jae :retry)
            (:cmp-imm :r9 0) (:jz :reserve-low)
            (:load-word :rdx :r9 0) (:cmp-reg :rdx :r10) (:jb :reserve-next)
            (:add-reg :rax :rdx) (:label :reserve-next)
            (:load-word :r9 :r9 16) (:jmp :reserve-block)
            (:label :reserve-low) (:imm-rax 1) (:store-frame -24 :rax) (:jmp :grow)))
        '((:label :retry) (:load-frame :rax -8) (:store-out 0 :rax) (:call (:runtime :find-free))
          (:test) (:jnz :found)
          (:label :grow)
          ;; At most one bounded extension per allocation attempt.
          (:load-frame :rax -8) (:add-imm :rax 32) (:jb :allocation-failed))
        ;; Preserve the small-heap minimum. Large live heaps need reserve space
        ;; proportional to their size, instead of collecting after every 1 MiB.
        ;; Explicit test geometry and caps retain the requested fixed unit.
        (unless (or (option :arena-unit) cap)
          `((:mov-reg :r8 :rax) (:load-word :rax :r15 ,+mapped-bytes+)
            (:imm-rcx 8) (:imm-rdx 0) (:div-rcx)
            (:cmp-imm :rax 16777216) (:jbe :growth-clamped) (:imm-rax 16777216)
            (:label :growth-clamped) (:cmp-reg :rax :r8) (:jae :growth-sized)
            (:mov-reg :rax :r8) (:label :growth-sized)))
        `((:cmp-imm :rax ,unit) (:jae :round) (:imm-rax ,unit)
          (:label :round) (:load-word :rcx :r15 ,+page-size+)
          (:mov-reg :rdx :rcx) (:add-imm :rdx -1) (:add-reg :rax :rdx) (:jb :allocation-failed)
          (:imm-rdx 0) (:div-rcx) (:mul) (:store-frame -16 :rax)
          (:load-word :rdx :r15 ,+mapped-bytes+) (:add-reg :rdx :rax) (:jb :allocation-failed))
        (when cap `((:imm-rax ,cap) (:cmp-rax-rdx) (:jb :allocation-failed)))
        '((:imm-reg :rdi 0) (:load-frame :rsi -16) (:imm-rdx 3)
          (:imm-reg :r10 34) (:imm-reg :r8 -1) (:imm-reg :r9 0) (:mov-eax 9))
        (if (option :mmap-fail) '((:imm-rax -12)) '((:syscall)))
        (if (or (option :arena-unit) cap)
            '((:cmp-imm :rax -4095) (:jae :allocation-failed))
            '((:cmp-imm :rax -4095) (:jb :mapped)
              ;; Reserve growth is optional when a reclaimed block can satisfy
              ;; this request. A failed mmap must not discard that valid result.
              (:load-frame :rax -24) (:test) (:jz :allocation-failed)
              (:load-frame :rax -8) (:store-out 0 :rax) (:call (:runtime :find-free))
              (:test) (:jnz :found) (:jmp :allocation-failed)
              (:label :mapped)))
        '((:mov-reg :r9 :rax)
          (:imm-rdx 0) (:store-word :r9 0 :rdx) (:store-word :r9 24 :rdx)
          (:load-frame :rdx -16) (:store-word :r9 8 :rdx)
          (:imm-rax 32) (:store-word :r9 16 :rax))
        (bump +mapped-bytes+ :rdx)
        `((:load-word :r8 :r15 ,+arena-head+) (:cmp-imm :r8 0) (:jnz :tail)
          (:store-word :r15 ,+arena-head+ :r9) (:jmp :arena-ready)
          (:label :tail) (:load-word :rax :r8 0) (:test) (:jz :append)
          (:mov-reg :r8 :rax) (:jmp :tail)
          (:label :append) (:store-word :r8 0 :r9)
          (:label :arena-ready) (:add-imm :r9 32) (:load-frame :rdx -16) (:add-imm :rdx -32)
          (:store-word :r9 0 :rdx) (:imm-rax 0) (:store-word :r9 8 :rax)
          (:store-word :r9 16 :rax) (:store-word :r9 24 :rax)
          ;; Append in arena order, then consume this known fitting block.
          (:lea-base :r11 :r15 ,(context-field-offset :free-head (test-image-p)))
          (:label :free-tail) (:load-word :rax :r11 0) (:test) (:jz :free-append)
          (:lea-base :r11 :rax 16) (:jmp :free-tail)
          (:label :free-append) (:store-word :r11 0 :r9) (:load-frame :rcx -8))
        (unless (or (option :arena-unit) cap)
          '((:load-frame :rax -24) (:test) (:jz :consume-new)
            ;; Preserve first-fit selection after proactive growth as well.
            (:load-frame :rax -8) (:store-out 0 :rax) (:call (:runtime :find-free))
            (:test) (:jnz :found) (:jmp :allocation-failed)
            (:label :consume-new)))
        (take-free-forms)
        '((:label :found) (:mov-reg :r9 :rax))
        (bump +alloc-count+)
        '((:load-word :rdx :r9 0)) (bump +alloc-bytes+ :rdx)
        (watch-allocation)
        '((:mov-reg :rax :r9)) (helper-return)))))
