namespace Mgnc\WholeRootCheck;
use Std\Numeric\{Bits};
use Mgnc\Data\{Paged,Diagnostic,Span,empty,push,lookup};
use Mgnc\Syntax\{Parent};
use Mgnc\TypeData\{Store,Type};
use Mgnc\WholeIR\{Body,Block,Operation,Slot};
use Mgnc\WholeFrameData\{Frame,Point};
use Mgnc\WholeEffects\{allocating};
use Mgnc\WholeChecks\{require};
use Mgnc\IntMap\{Map,create,get,put};
use Mgnc\Tables\{atList};
use Mgnc\Facts\{mask,at as wordAt};
type Node=product{reads:List<Int>;write:Int;previous:List<Int>;};
type Graph=product{nodes:Paged<Node>;bases:Paged<Int>;};
type Uses=product{reached:Map;reference:Bool;bit:Bits<64>;};
let contains:Function(List<Int>,Int):Bool=function(values:List<Int>,wanted:Int):Bool{loop over(values as value:Int){branch when{value==wanted=>{return true;},else=>unit};};false};
// Build instruction-position predecessor edges independently of root planning.
let buildGraph:Function(Body):Result<Graph,Diagnostic>=function(body:Body):Result<Graph,Diagnostic>{
 var bases:Paged<Int>=empty<Int>();var count:Int=0;
 loop over(body->blocks->pages->append(body->blocks->tail) as page:List<Block>){loop over(page as block:Block){bases=push<Int>(bases,count);count=count+block->operations->length()+1;};};
 var heads:Map=create();var versions:Paged<List<Int>>=empty<List<Int>>();var blockId:Int=0;
 loop over(body->blocks->pages->append(body->blocks->tail) as page:List<Block>){loop over(page as block:Block){
  let end:Int=(try lookup<Int>(bases,blockId))+block->operations->length();
  loop over(block->terminator->targets as target:Int){let version:Int=try get(heads,target);let previous:List<Int>=branch when{version<0=>List<Int>[],else=>try lookup<List<Int>>(versions,version)};heads=try put(heads,target,versions->count);versions=push<List<Int>>(versions,previous->append(end));};blockId=blockId+1;
 };};
 var nodes:Paged<Node>=empty<Node>();blockId=0;
 loop over(body->blocks->pages->append(body->blocks->tail) as page:List<Block>){loop over(page as block:Block){
  let version:Int=try get(heads,blockId);var previous:List<Int>=branch when{version<0=>List<Int>[],else=>try lookup<List<Int>>(versions,version)};
  loop over(block->operations as op:Operation){let id:Int=nodes->count;let written:Int=branch on op->output{Parent::None=> -1,Parent::Some(slot:Int)=>slot};nodes=push<Node>(nodes,Node{reads:op->inputs,write:written,previous:previous});previous=List<Int>[id];};
  nodes=push<Node>(nodes,Node{reads:block->terminator->inputs,write:-1,previous:previous});blockId=blockId+1;
 };};Result<Graph,Diagnostic>::Ok(Graph{nodes:nodes,bases:bases})
};
// For each source read, enumerate predecessor positions until a write kills
// that value. This reachability oracle shares no producer fixed-point equations.
let indexUses:Function(Store,Body,Graph):Result<Paged<Uses>,Diagnostic>=function(store:Store,body:Body,graph:Graph):Result<Paged<Uses>,Diagnostic>{
 let span:Span=(try lookup<Block>(body->blocks,body->entry))->terminator->origin->span;var result:Paged<Uses>=empty<Uses>();var slotId:Int=0;
 loop over(body->slots->pages->append(body->slots->tail) as page:List<Slot>){loop over(page as slot:Slot){
  let kind:Int=(try lookup<Type>(store->types,slot->valueType))->kind;var reached:Map=create();
  branch when{kind>=3=>{
   var queue:Paged<Int>=empty<Int>();var id:Int=0;
   loop over(graph->nodes->pages->append(graph->nodes->tail) as pages:List<Node>){loop over(pages as node:Node){branch when{contains(node->reads,slotId)=>{queue=push<Int>(queue,id);},else=>unit};id=id+1;};};
   var cursor:Int=0;loop while(cursor<queue->count){
    let position:Int=try lookup<Int>(queue,cursor);cursor=cursor+1;branch when{(try get(reached,position))>=0=>{continue;},else=>unit};reached=try put(reached,position,1);
    let node:Node=try lookup<Node>(graph->nodes,position);
    loop over(node->previous as previous:Int){let prior:Node=try lookup<Node>(graph->nodes,previous);branch when{prior->write!=slotId&&(try get(reached,previous))<0=>{queue=push<Int>(queue,previous);},else=>unit};};
   };
  },else=>unit};
  result=push<Uses>(result,Uses{reached:reached,reference:kind>=3,bit:try mask(slotId,span)});slotId=slotId+1;
 };};Result<Paged<Uses>,Diagnostic>::Ok(result)
};
let roots:Function(Body,Paged<Uses>,Int,List<Bits<64>>,Span):Result<Unit,Diagnostic>=function(body:Body,uses:Paged<Uses>,position:Int,actual:List<Bits<64>>,span:Span):Result<Unit,Diagnostic>{
 try require(actual->length()==(body->slots->count+63)/64,span,"root bitmap shape");var slotId:Int=0;
 loop over(uses->pages->append(uses->tail) as page:List<Uses>){loop over(page as used:Uses){
  let expected:Bool=used->reference&&(try get(used->reached,position))>=0;let selected:Bool=(try wordAt(actual,slotId/64,span))->and(used->bit)!=Bits<64>{0};
  try require(expected==selected,span,branch when{expected=>"missing live managed root",else=>"dead or scalar root retained"});slotId=slotId+1;
 };};
 loop while(slotId<actual->length()*64){try require((try wordAt(actual,slotId/64,span))->and(try mask(slotId,span))==Bits<64>{0},span,"root bitmap padding");slotId=slotId+1;};Result<Unit,Diagnostic>::Ok(unit)
};
public let verify:Function(Store,Body,Frame):Result<Unit,Diagnostic>=function(store:Store,body:Body,frame:Frame):Result<Unit,Diagnostic>{
 let span:Span=(try lookup<Block>(body->blocks,body->entry))->terminator->origin->span;try require(frame->slots>=0&&frame->slots<=268435440&&frame->outgoing>=8&&frame->outgoing<=268435440-frame->slots,span,"frame size bounds");try require(frame->slots==body->slots->count&&frame->extent%16==0&&frame->extent>=64+frame->slots*8+frame->outgoing*8&&frame->extent<2147483648,span,"frame layout or alignment");
 let indexed:Graph=try buildGraph(body);let uses:Paged<Uses>=try indexUses(store,body,indexed);try roots(body,uses,try lookup<Int>(indexed->bases,body->entry),frame->entry,span);var id:Int=0;
 loop over(frame->points->pages->append(frame->points->tail) as page:List<Point>){loop over(page as point:Point){let block:Block=try lookup<Block>(body->blocks,point->block);try require(point->operation>=0&&point->operation<block->operations->length(),span,"root point operation bounds");
  var earlier:Int=0;loop while(earlier<id){let other:Point=try lookup<Point>(frame->points,earlier);try require(other->block!=point->block||other->operation!=point->operation,span,"duplicate root point");earlier=earlier+1;};
  let op:Operation=try atList<Operation>(block->operations,point->operation);try require(try allocating(store,body,op),span,"root point on nonallocating operation");try roots(body,uses,(try lookup<Int>(indexed->bases,point->block))+point->operation,point->roots,span);id=id+1;
 };};
 var expected:Int=0;var maximum:Int=8;
 loop over(body->blocks->pages->append(body->blocks->tail) as page:List<Block>){loop over(page as block:Block){loop over(block->operations as op:Operation){branch when{try allocating(store,body,op)=>{expected=expected+1;},else=>unit};branch when{op->inputs->length()+4>maximum=>{maximum=op->inputs->length()+4;},else=>unit};};};};
 try require(expected==frame->points->count,span,"missing allocation root point");try require(frame->outgoing==maximum&&frame->extent==((64+body->slots->count*8+maximum*8+15)/16)*16,span,"outgoing argument capacity");Result<Unit,Diagnostic>::Ok(unit)
};
