namespace Mgnc\WholeHelperCheck;
use Mgnc\Data\{Diagnostic,Span,lookup};
use Mgnc\Machine\{Code,Record,flush};
use Mgnc\WholeHelpers\{Helper,contains,verify as contracts};
use Mgnc\WholeChecks\{require};
use Mgnc\IntMap\{Map,create,get,put};
use Mgnc\Tables\{atList};
// Runtime entries use reserved labels below 128; fixed data occupies 128..255.
// Source entries and local labels are allocated from 256. Inspect the actual
// emitted reference graph, separately from the declared dependency closure.
public let verify:Function(List<Helper>,Code):Result<Unit,Diagnostic>=function(entries:List<Helper>,initial:Code):Result<Unit,Diagnostic>{
 try contracts(entries);let span:Span=Span{start:0,end:0,line:1,column:1};let code:Code=flush(initial);
 var helpers:Map=create();var labels:Map=create();var index:Int=0;
 loop over(entries as helper:Helper){helpers=try put(helpers,helper->id,index);index=index+1;};
 // Keep every fixed runtime label even if registry roots are corrupted, plus
 // any declared entry/root labels. The full machine oracle separately checks
 // every source/local label and reference.
 var queriedLabels:Map=create();loop over(entries as helper:Helper){queriedLabels=try put(queriedLabels,helper->id,1);loop over(helper->roots as root:Int){queriedLabels=try put(queriedLabels,root,1);};};
 index=0;loop over(code->records->pages->append(code->records->tail) as page:List<Record>){loop over(page as record:Record){
  branch when{record->kind==1&&(record->target<256||(try get(queriedLabels,record->target))>=0)=>{labels=try put(labels,record->target,index);},else=>unit};index=index+1;
 };};
 loop over(entries as helper:Helper){
  try require((try get(labels,helper->id))>=0,span,"unlinked runtime helper");
  loop over(helper->roots as root:Int){try require((try get(labels,root))>=0,span,"unlinked runtime root descriptor");};
  branch when{helper->id>=69&&helper->id<=71=>{
   let expected:List<Int>=branch when{helper->id==69=>List<Int>[0,0,0,3,3,3],helper->id==70=>List<Int>[1,0,0,3,3],else=>List<Int>[1,0,0,3,3,3]};try require(helper->stack&&helper->managedAllocation&&helper->mayFail&&!helper->terminal&&helper->result==1&&helper->arguments->length()==expected->length(),span,"binary helper signature");var ordinal:Int=0;loop over(helper->arguments as kind:Int){try require(kind==(try atList<Int>(expected,ordinal)),span,"binary helper argument kinds");ordinal=ordinal+1;};
  },else=>unit};
  branch when{helper->id==73||helper->id==74=>{try require(helper->stack&&helper->managedAllocation&&helper->mayFail&&!helper->terminal&&helper->result==1&&helper->arguments->length()==1&&(try atList<Int>(helper->arguments,0))==1,span,"binary Function helper signature");},else=>unit};
  branch when{helper->id==77||helper->id==78||helper->id==79=>{let count:Int=branch when{helper->id==77=>2,else=>1};try require(helper->stack&&helper->managedAllocation&&helper->mayFail&&!helper->terminal&&helper->result==1&&helper->arguments->length()==count&&helper->roots->length()==1&&contains(helper->roots,helper->id+96),span,"directory helper signature");loop over(helper->arguments as kind:Int){try require(kind==1,span,"directory helper argument kind");};},else=>unit};
  branch when{helper->id>=85&&helper->id<=88=>{let expected:List<Int>=branch when{helper->id==87=>List<Int>[2,2,0,0],helper->id==88=>List<Int>[2,2,0],else=>List<Int>[2,2,2]};try require(!helper->stack&&!helper->managedAllocation&&!helper->mayFail&&!helper->terminal&&helper->result==0&&helper->roots->length()==0&&helper->arguments->length()==expected->length(),span,"directory raw helper effects");var ordinal:Int=0;loop over(helper->arguments as kind:Int){try require(kind==(try atList<Int>(expected,ordinal)),span,"directory raw helper argument kinds");ordinal=ordinal+1;};},else=>unit};
  branch when{helper->id==76=>{try require(helper->stack&&helper->managedAllocation&&helper->mayFail&&!helper->terminal&&helper->result==1&&helper->arguments->length()==1&&(try atList<Int>(helper->arguments,0))==1&&helper->roots->length()==1&&contains(helper->roots,172),span,"inspection helper signature");},else=>unit};
  branch when{helper->id==75=>{try require(helper->stack&&helper->managedAllocation&&helper->mayFail&&!helper->terminal&&helper->result==1&&helper->arguments->length()==3&&helper->roots->length()==1&&contains(helper->roots,171),span,"publication helper signature");loop over(helper->arguments as kind:Int){try require(kind==1,span,"publication argument kinds");};},else=>unit};
  branch when{helper->id==68=>{try require(helper->stack&&helper->managedAllocation&&helper->mayFail&&!helper->terminal&&helper->result==1&&helper->arguments->length()==7&&helper->roots->length()==2&&contains(helper->roots,144)&&contains(helper->roots,145),span,"numeric Result helper signature");var ordinal:Int=0;loop over(helper->arguments as kind:Int){try require(kind==branch when{ordinal==4||ordinal==5=>3,else=>0},span,"numeric Result helper argument kinds");ordinal=ordinal+1;};},else=>unit};
 };
 branch when{(try get(helpers,68))>=0=>{
 loop over(List<Int>[144,145] as root:Int){let rootPosition:Int=try get(labels,root);try require(rootPosition>=0,span,"numeric helper root descriptor");let size:Record=try lookup<Record>(code->records,rootPosition+1);let bits:Record=try lookup<Record>(code->records,rootPosition+2);let next:Record=try lookup<Record>(code->records,rootPosition+3);try require(size->kind==4&&size->bytes->length()==0&&size->value==1&&bits->kind==4&&bits->bytes->length()==0&&bits->value==root-144&&next->kind==1,span,"numeric helper root descriptor");};
 },else=>unit};
 loop over(List<Int>[160,161,162,163,164] as root:Int){let helper:Int=branch when{root<=161=>69,root<=163=>71,else=>70};branch when{(try get(helpers,helper))>=0=>{let position:Int=try get(labels,root);try require(position>=0,span,"binary helper bitmap");let count:Record=try lookup<Record>(code->records,position+1);let bits:Record=try lookup<Record>(code->records,position+2);let next:Record=try lookup<Record>(code->records,position+3);try require(count->kind==4&&count->bytes->length()==0&&count->value==branch when{root==162||root==163=>2,else=>1}&&bits->kind==4&&bits->bytes->length()==0&&bits->value==branch when{root==160=>0,root==163=>2,else=>1}&&next->kind==1,span,"binary helper bitmap");},else=>unit};};
 loop over(List<Int>[167,168,169,170] as root:Int){let helper:Int=branch when{root==170=>74,else=>73};branch when{(try get(helpers,helper))>=0=>{let position:Int=try get(labels,root);try require(position>=0,span,"binary Function bitmap");let count:Record=try lookup<Record>(code->records,position+1);let bits:Record=try lookup<Record>(code->records,position+2);let next:Record=try lookup<Record>(code->records,position+3);try require(count->kind==4&&count->bytes->length()==0&&count->value==branch when{root==170=>1,else=>3}&&bits->kind==4&&bits->bytes->length()==0&&bits->value==branch when{root==168=>2,root==169=>4,else=>1}&&next->kind==1,span,"binary Function bitmap");},else=>unit};};
 branch when{(try get(helpers,75))>=0=>{let position:Int=try get(labels,171);try require(position>=0,span,"publication helper bitmap");let count:Record=try lookup<Record>(code->records,position+1);let bits:Record=try lookup<Record>(code->records,position+2);let next:Record=try lookup<Record>(code->records,position+3);try require(count->kind==4&&count->bytes->length()==0&&count->value==7&&bits->kind==4&&bits->bytes->length()==0&&bits->value==127&&next->kind==1,span,"publication helper bitmap");},else=>unit};
 branch when{(try get(helpers,76))>=0=>{let position:Int=try get(labels,172);let count:Record=try lookup<Record>(code->records,position+1);let bits:Record=try lookup<Record>(code->records,position+2);let next:Record=try lookup<Record>(code->records,position+3);try require(position>=0&&count->kind==4&&count->bytes->length()==0&&count->value==4&&bits->kind==4&&bits->bytes->length()==0&&bits->value==15&&next->kind==1,span,"inspection helper bitmap");},else=>unit};
 loop over(List<Int>[77,78,79] as helper:Int){branch when{(try get(helpers,helper))>=0=>{let position:Int=try get(labels,helper+96);try require(position>=0,span,"directory helper bitmap");let count:Record=try lookup<Record>(code->records,position+1);let bits:Record=try lookup<Record>(code->records,position+2);let next:Record=try lookup<Record>(code->records,position+3);try require(count->kind==4&&count->bytes->length()==0&&count->value==branch when{helper==79=>8,else=>6}&&bits->kind==4&&bits->bytes->length()==0&&bits->value==branch when{helper==79=>255,else=>63}&&next->kind==1,span,"directory helper bitmap");},else=>unit};};
 var owner:Int= -1;
 loop over(code->records->pages->append(code->records->tail) as page:List<Record>){loop over(page as record:Record){
  branch when{record->kind==1=>{
   let found:Int=try get(helpers,record->target);
   branch when{found>=0=>{owner=found;},record->target<256=>{
    try require(record->target==0||record->target>=128,span,"unregistered runtime entry");owner= -1;
   },else=>unit};
  },owner>=0&&(record->kind==2||record->kind==5)=>{
   let helper:Helper=try atList<Helper>(entries,owner);let target:Int=try get(helpers,record->target);
   branch when{record->kind==2&&target>=0&&record->target!=helper->id=>{
    try require(contains(helper->dependencies,record->target),span,"undeclared runtime helper dependency");
   },record->kind==5&&record->target>=134&&(record->target<=145||record->target>=160&&record->target<=164||record->target>=167&&record->target<=175)&&record->target!=140&&record->target!=141&&record->target!=142=>{
    try require(contains(helper->roots,record->target),span,"undeclared runtime root descriptor");
   },else=>unit};
  },else=>unit};
 };};Result<Unit,Diagnostic>::Ok(unit)
};
