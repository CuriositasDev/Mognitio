namespace Mgnc\WholeBounds;
use Std\Numeric\{Bits};
use Mgnc\Data\{Diagnostic,empty};
use Mgnc\WholeFrameData\{Frame,Point};
use Mgnc\WholeFrame\{begin,end,select};
use Mgnc\Machine\{Code,label,jump,fresh,field,raw};
use Mgnc\WholeX64\{mov,load,store,address,immediate,alu,constant,byteLoad};
use Mgnc\WholeABI\{allocateLabel};
let frame:Frame=Frame{slots:2,outgoing:8,extent:144,entry:List<Bits<64>>[Bits<64>{1}],points:empty<Point>()};
// Stack arguments: List, index, Result descriptor, IndexError descriptor,
// element-is-managed. Helper slots own the receiver and selected payload.
let at:Function(Code):Result<Code,Diagnostic>=function(initial:Code):Result<Code,Diagnostic>{
 var code:Code=try begin(label(initial,41),frame,List<Int>[0],List<Int>[],134);
 let length:Int=code->nextLabel;let invalid:Int=length+1;let walk:Int=length+2;let selected:Int=length+3;let scalar:Int=length+4;let result:Int=length+5;code=fresh(code,6);
 code=load(code,12,5,-72);code=immediate(code,13,0);code=alu(code,133,12,12);code=jump(code,List<Int>[15,132],length);code=load(code,13,12,24);
 code=label(code,length);code=load(code,0,5,32);code=alu(code,57,0,13);code=jump(code,List<Int>[15,131],invalid);code=mov(code,1,13);code=constant(code,5,1,1);code=alu(code,41,1,0);
 code=label(code,walk);code=alu(code,133,1,1);code=jump(code,List<Int>[15,132],selected);code=load(code,12,12,32);code=constant(code,5,1,1);code=jump(code,List<Int>[233],walk);
 code=label(code,selected);code=load(code,0,12,40);code=store(code,5,-80,0);code=select(code,136);code=load(code,0,5,56);code=alu(code,133,0,0);code=jump(code,List<Int>[15,132],scalar);code=select(code,135);code=label(code,scalar);code=immediate(code,13,0);code=jump(code,List<Int>[233],result);
 code=label(code,invalid);code=immediate(code,7,40);code=load(code,6,5,48);code=jump(code,List<Int>[232],allocateLabel);code=load(code,2,5,32);code=store(code,0,24,2);code=store(code,0,32,13);code=store(code,5,-80,0);code=select(code,135);code=immediate(code,13,1);
 code=label(code,result);code=immediate(code,7,40);code=load(code,6,5,40);code=jump(code,List<Int>[232],allocateLabel);code=store(code,0,24,13);code=load(code,2,5,-80);code=store(code,0,32,2);Result<Code,Diagnostic>::Ok(end(code,frame))
};
// Stack arguments: String, start, end, Result descriptor, SliceError descriptor,
// String descriptor. UTF-8 inputs are already validated at construction.
let slice:Function(Code):Result<Code,Diagnostic>=function(initial:Code):Result<Code,Diagnostic>{
 var code:Code=try begin(label(initial,42),frame,List<Int>[0],List<Int>[],134);
 let invalid:Int=code->nextLabel;let scan:Int=invalid+1;let advance:Int=invalid+2;let one:Int=invalid+3;let two:Int=invalid+4;let three:Int=invalid+5;let next:Int=invalid+6;let copy:Int=invalid+7;let result:Int=invalid+8;code=fresh(code,9);
 code=load(code,3,5,-72);code=load(code,14,3,32);code=load(code,0,5,40);code=alu(code,57,0,14);code=jump(code,List<Int>[15,135],invalid);code=load(code,1,5,32);code=alu(code,57,1,0);code=jump(code,List<Int>[15,135],invalid);
 code=immediate(code,12,0);code=immediate(code,13,0);code=immediate(code,14,0);
 code=label(code,scan);code=load(code,0,5,32);code=alu(code,57,14,0);code=jump(code,List<Int>[15,133],advance);code=mov(code,12,13);
 code=label(code,advance);code=load(code,0,5,40);code=alu(code,57,14,0);code=jump(code,List<Int>[15,132],copy);code=mov(code,2,3);code=alu(code,1,2,13);code=byteLoad(code,0,2,40);code=constant(code,7,0,128);code=jump(code,List<Int>[15,130],one);code=constant(code,7,0,224);code=jump(code,List<Int>[15,130],two);code=constant(code,7,0,240);code=jump(code,List<Int>[15,130],three);code=constant(code,0,13,4);code=jump(code,List<Int>[233],next);
 code=label(code,one);code=constant(code,0,13,1);code=jump(code,List<Int>[233],next);code=label(code,two);code=constant(code,0,13,2);code=jump(code,List<Int>[233],next);code=label(code,three);code=constant(code,0,13,3);
 code=label(code,next);code=constant(code,0,14,1);code=jump(code,List<Int>[233],scan);
 code=label(code,copy);code=mov(code,14,13);code=alu(code,41,14,12);code=mov(code,7,14);code=constant(code,0,7,40);code=jump(code,List<Int>[15,128],6);code=load(code,6,5,64);code=jump(code,List<Int>[232],allocateLabel);
 code=store(code,0,24,14);code=load(code,2,5,40);code=load(code,1,5,32);code=alu(code,41,2,1);code=store(code,0,32,2);code=address(code,6,3,40);code=alu(code,1,6,12);code=address(code,7,0,40);code=mov(code,1,14);code=raw(code,List<Int>[243,164]);code=store(code,5,-80,0);code=select(code,135);code=immediate(code,12,0);code=jump(code,List<Int>[233],result);
 code=label(code,invalid);code=immediate(code,7,48);code=load(code,6,5,56);code=jump(code,List<Int>[232],allocateLabel);code=load(code,2,5,32);code=store(code,0,24,2);code=load(code,2,5,40);code=store(code,0,32,2);code=store(code,0,40,14);code=store(code,5,-80,0);code=select(code,135);code=immediate(code,12,1);
 code=label(code,result);code=immediate(code,7,40);code=load(code,6,5,48);code=jump(code,List<Int>[232],allocateLabel);code=store(code,0,24,12);code=load(code,2,5,-80);code=store(code,0,32,2);Result<Code,Diagnostic>::Ok(end(code,frame))
};
public let emit:Function(Code):Result<Code,Diagnostic>=function(initial:Code):Result<Code,Diagnostic>{
 var code:Code=try slice(try at(initial));loop over(List<Int>[134,135,136] as target:Int){code=label(code,target);code=field(code,4,2);code=field(code,4,branch when{target==134=>1,target==135=>2,else=>0});};Result<Code,Diagnostic>::Ok(code)
};
