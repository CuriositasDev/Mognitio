namespace Mgnc\WholeBinaryProof;
use Mgnc\Syntax\{Parent};
use Mgnc\Data\{Diagnostic,Span,lookup};
use Mgnc\SemanticData\{Declaration,Module};
use Mgnc\TypeData\{Store,Type,Member,Argument,ValueTerm};
use Mgnc\WholeIR\{Body,Operation};
use Mgnc\WholeNativeData\{Native};
use Mgnc\WholeChecks\{require,present,slotType};
use Mgnc\VariantSupport\{memberType};
use Mgnc\Tables\{atList};
use Mgnc\IntMap\{get};
public type Proof=product{helper:Int;start:Int;metadata:List<Int>;};
public let selected:Function(Store,Body,Operation):Result<Bool,Diagnostic>=function(store:Store,body:Body,op:Operation):Result<Bool,Diagnostic>{
 branch when{op->unavailable->length()>0||op->inputs->length()==0=>{return Result<Bool,Diagnostic>::Ok(false);},else=>unit};let kind:Int=(try lookup<Type>(store->types,try slotType(body,try atList<Int>(op->inputs,0))))->kind;Result<Bool,Diagnostic>::Ok(kind==24&&op->code=="method:toBytes"||kind==25&&(op->code=="method:toBits"||op->code=="method:at"||op->code=="method:slice"))
};
let nominal:Function(Store,Int,String,List<String>,Span):Result<Unit,Diagnostic>=function(store:Store,id:Int,name:String,fields:List<String>,span:Span):Result<Unit,Diagnostic>{
 let value:Type=try lookup<Type>(store->types,id);try require(value->kind==20&&value->arguments->length()==0&&value->members->length()==fields->length(),span,"binary error nominal shape");let declaration:Declaration=try lookup<Declaration>(store->headers->declarations,try present(value->owner,span,"binary nominal owner"));let module:Module=try lookup<Module>(store->headers->modules,declaration->file);try require(module->standard&&module->nameSpace=="Std\\Binary"&&declaration->name==name,span,"binary standard error identity");var ordinal:Int=0;loop over(value->members as field:Member){try require(field->name==(try atList<String>(fields,ordinal))&&(try present(field->value,span,"binary error field"))==1,span,"binary error fields");ordinal=ordinal+1;};Result<Unit,Diagnostic>::Ok(unit)
};
public let expected:Function(Native,Body,Operation):Result<Proof,Diagnostic>=function(plan:Native,body:Body,op:Operation):Result<Proof,Diagnostic>{
 let store:Store=plan->concrete->types;let span:Span=op->origin->span;let input:Int=try slotType(body,try atList<Int>(op->inputs,0));let output:Int=try slotType(body,try present(op->output,span,"binary checked output"));let result:Type=try lookup<Type>(store->types,output);try require(result->kind==11&&result->arguments->length()==2,span,"binary Result shape");let payload:Int=try memberType(result->arguments,0,span);let error:Int=try memberType(result->arguments,1,span);let descriptor:Int=try get(plan->layouts->types,output);let errorDescriptor:Int=try get(plan->layouts->types,error);try require(descriptor>=0&&errorDescriptor>=0,span,"binary descriptor membership");
 branch when{op->code=="method:at"=>{try require((try lookup<Type>(store->types,payload))->kind==24&&error==4,span,"Bytes access Result");let element:Type=try lookup<Type>(store->types,payload);let width:ValueTerm=branch on try atList<Argument>(element->arguments,0){Argument::Value(term:ValueTerm)=>term,Argument::Type(id:Int)=>{try require(false,span,"byte element width");ValueTerm{parameter:Parent::None,owner:0,value:0}}};try require(width->value==8,span,"byte access width");Result<Proof,Diagnostic>::Ok(Proof{helper:68,start:40,metadata:List<Int>[descriptor,errorDescriptor,2]})},op->code=="method:slice"=>{try require(payload==input&&error==5,span,"Bytes slice Result");Result<Proof,Diagnostic>::Ok(Proof{helper:71,start:32,metadata:List<Int>[descriptor,errorDescriptor,try get(plan->layouts->types,input)]})},else=>{
  let order:Type=try lookup<Type>(store->types,try slotType(body,try atList<Int>(op->inputs,1)));try require((try atList<Member>(order->members,0))->name=="LittleEndian"&&(try atList<Member>(order->members,1))->name=="BigEndian",span,"ByteOrder ordinals");let owner:Declaration=try lookup<Declaration>(store->headers->declarations,try present(order->owner,span,"byte order nominal"));let module:Module=try lookup<Module>(store->headers->modules,owner->file);try require(order->kind==21&&module->standard&&module->nameSpace=="Std\\Binary"&&owner->name=="ByteOrder"&&order->members->length()==2,span,"ByteOrder identity");
  branch when{op->code=="method:toBytes"=>{try require((try lookup<Type>(store->types,payload))->kind==25,span,"encoded Bytes payload");try nominal(store,error,"BitWidthError",List<String>["width"],span);let bytesDescriptor:Int=try get(plan->layouts->types,payload);try require(bytesDescriptor>=0,span,"Bytes payload descriptor");Result<Proof,Diagnostic>::Ok(Proof{helper:69,start:32,metadata:List<Int>[bytesDescriptor,descriptor,errorDescriptor]})},else=>{try require(op->code=="method:toBits"&&(try lookup<Type>(store->types,payload))->kind==24,span,"decoded Bits payload");let width:ValueTerm=branch on try atList<Argument>(op->arguments,0){Argument::Value(term:ValueTerm)=>term,Argument::Type(id:Int)=>{try require(false,span,"decode width argument");ValueTerm{parameter:Parent::None,owner:0,value:0}}};let payloadType:Type=try lookup<Type>(store->types,payload);let actual:ValueTerm=branch on try atList<Argument>(payloadType->arguments,0){Argument::Value(term:ValueTerm)=>term,Argument::Type(id:Int)=>{try require(false,span,"decode payload width");ValueTerm{parameter:Parent::None,owner:0,value:0}}};try require(width->value==actual->value,span,"decoded Bits width correspondence");try nominal(store,error,"BinaryDecodeError",List<String>["width","length"],span);Result<Proof,Diagnostic>::Ok(Proof{helper:70,start:32,metadata:List<Int>[descriptor,errorDescriptor]})}}
 }}
};
