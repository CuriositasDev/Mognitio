namespace Mgnc\Catalog;
use Mgnc\Data\{Diagnostic};
use Mgnc\InputData\{SourceUnit};
use Mgnc\SemanticData\{Headers};
use Mgnc\Headers\{scan};
use Mgnc\Forest\{SyntaxForest};
use Mgnc\Structural\{analyzeSyntax};
let io:String="namespace Std\\Io;\npublic type IoOperation = sum { ReadTextFile; WriteTextFile; ReadStdin; WriteStdout; WriteStderr; JoinPath; ReadDirectory; CreateDirectory; };\npublic type IoErrorKind = sum { InvalidPath; InvalidEncoding; NotFound; PermissionDenied; UnsupportedTarget; BrokenPipe; ResourceExhausted; Other; };\npublic type IoError = product { operation: IoOperation; kind: IoErrorKind; subject: String; phase: IoErrorPhase; };\npublic type DirectoryEntryKind = sum { File; Directory; Symlink; Other; };\npublic type DirectoryEntry = product { name: String; kind: DirectoryEntryKind; };\npublic type IoErrorPhase = sum { Input; Target; Body; Cleanup; };\npublic type FileIdentity = product {};\npublic type PathInfo = product { kind: DirectoryEntryKind; identity: FileIdentity; };\npublic type PathInfoError = product { kind: IoErrorKind; subject: String; };\npublic let readTextFile: Function(String): Result<String,IoError> = function(path:String): Result<String,IoError> { panic { \"compiler body\" } };\npublic let writeTextFile: Function(String,String): Result<Unit,IoError> = function(path:String,text:String): Result<Unit,IoError> { panic { \"compiler body\" } };\npublic let readStdin: Function(): Result<String,IoError> = function(): Result<String,IoError> { panic { \"compiler body\" } };\npublic let writeStdout: Function(String): Result<Unit,IoError> = function(text:String): Result<Unit,IoError> { panic { \"compiler body\" } };\npublic let writeStderr: Function(String): Result<Unit,IoError> = function(text:String): Result<Unit,IoError> { panic { \"compiler body\" } };\npublic let joinPath: Function(String,String): Result<String,IoError> = function(base:String,relative:String): Result<String,IoError> { panic { \"compiler body\" } };\npublic let readDirectory: Function(String): Result<List<DirectoryEntry>,IoError> = function(path:String): Result<List<DirectoryEntry>,IoError> { panic { \"compiler body\" } };\npublic let createDirectory: Function(String): Result<Unit,IoError> = function(path:String): Result<Unit,IoError> { panic { \"compiler body\" } };\npublic let inspectPath: Function(String): Result<PathInfo,PathInfoError> = function(path:String): Result<PathInfo,PathInfoError> { panic { \"compiler body\" } };";
let numeric:String="namespace Std\\Numeric;\npublic type Signed = product {};\npublic type Unsigned = product {};\npublic type Bits<N:Int> = product {};\npublic type IntegerConversionError = product {};\npublic type BitShiftError = product { count:Int; width:Int; };\n";
let binary:String="namespace Std\\Binary;\nuse Std\\Numeric\\{Bits};\npublic type Bytes=product{};\npublic type ByteOrder=sum{LittleEndian;BigEndian;};\npublic type ByteValueError=product{index:Int;value:Int;};\npublic type BitWidthError=product{width:Int;};\npublic type BinaryDecodeError=product{width:Int;length:Int;};\npublic type BinaryFileMode=sum{Data;Executable;};\npublic type BinaryOutputErrorKind=sum{InvalidPath;AlreadyExists;NotFound;PermissionDenied;UnsupportedTarget;ResourceExhausted;Other;};\npublic type BinaryOutputPhase=sum{Input;Target;Body;Publish;Cleanup;};\npublic type BinaryPublicationState=sum{NotPublished;Published;Unknown;};\npublic type BinaryOutputError=product{kind:BinaryOutputErrorKind;subject:String;phase:BinaryOutputPhase;publication:BinaryPublicationState;};\npublic let bytesFromInts:Function(List<Int>):Result<Bytes,ByteValueError>=function(values:List<Int>):Result<Bytes,ByteValueError>{panic{\"compiler body\"}};\npublic let bytesFromBits:Function(List<Bits<8>>):Bytes=function(values:List<Bits<8>>):Bytes{panic{\"compiler body\"}};\npublic let publishFile:Function(String,Bytes,BinaryFileMode):Result<Unit,BinaryOutputError>=function(path:String,bytes:Bytes,mode:BinaryFileMode):Result<Unit,BinaryOutputError>{panic{\"compiler body\"}};\n";
public let attach:Function(Headers):Result<Headers,Diagnostic>=function(headers:Headers):Result<Headers,Diagnostic>{
 var result:Headers=headers;var catalogIndex:Int=0;
 loop over(List<String>[io,numeric,binary] as text:String){
  let identity:String=branch when{catalogIndex==0=>"standard:Std\\Io@1.5.0",catalogIndex==1=>"standard:Std\\Numeric@1.2.0",else=>"standard:Std\\Binary@1.2.0"};catalogIndex=catalogIndex+1;
  let source:SourceUnit=SourceUnit{path:identity,displayPath:identity,relativePath:identity,expectedNamespace:"",text:text};
  let tree:SyntaxForest=try analyzeSyntax(text);
  result=try scan(result->input,result->modules,result->declarations,result->names,source,tree,true);
 };
 Result<Headers,Diagnostic>::Ok(result)
};
