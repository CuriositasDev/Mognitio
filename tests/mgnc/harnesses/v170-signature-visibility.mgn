namespace Mgnc;
use Mgnc\Data\{Span,Diagnostic,number};
use Mgnc\InputData\{SourceUnit,ProjectInput,InputError};
use Mgnc\Semantic\{SemanticProject,analyze};
use Mgnc\WholeChecks\{require};
use Std\Io\{writeStdout};
let check:Function(String,Bool):Result<Unit,Diagnostic>=function(text:String,valid:Bool):Result<Unit,Diagnostic>{let span:Span=Span{start:0,end:0,line:1,column:1};let source:SourceUnit=SourceUnit{path:"visibility.mgn",displayPath:"visibility.mgn",relativePath:"visibility.mgn",expectedNamespace:"",text:text};branch on analyze(ProjectInput{manifestPath:"",manifestText:"",rootNamespace:"",entry:0,sources:List<SourceUnit>[source]}){Result<SemanticProject,InputError>::Ok(value:SemanticProject)=>{try require(valid,span,"visibility failure accepted");},Result<SemanticProject,InputError>::Err(error:InputError)=>{try require(!valid&&error->status==1&&error->path=="visibility.mgn"&&error->diagnostic->phase=="semantic"&&error->diagnostic->message=="public signature exposes a private nominal type",span,"visibility rejection reason");}};Result<Unit,Diagnostic>::Ok(unit)};
let test:Function():Result<Unit,Diagnostic>=function():Result<Unit,Diagnostic>{
 let good:String="namespace App;public type Value=product{value:Int;};alias Local=Value;public let make:Function():Local=function():Local{Value{value:1}};public let keep:Function(Value):Value=function(value:Value):Value{value};let main:Function(List<String>):Int=function(args:List<String>):Int{0};";
 let hidden:String="namespace App;type Value=product{value:Int;};alias Local=Value;public let make:Function():Local=function():Local{Value{value:1}};public let keep:Function(Value):Value=function(value:Value):Value{value};let main:Function(List<String>):Int=function(args:List<String>):Int{0};";
 let packed:String="namespace App;public contract Read{read(value:Self):Int;}type Value=product{value:Int;};witness Proof=Value implements Read{read(value:Self):Int{value->value}}public let make:Function():Read=function():Read{Read(Value{value:7})};let main:Function(List<String>):Int=function(args:List<String>):Int{assert make()->read()==7;0};";
 let leaked:String="namespace App;public contract Read{read(value:Self):Int;}type Value=product{value:Int;};public witness Proof=Value implements Read{read(value:Self):Int{value->value}}public let make:Function():Read=function():Read{Read(Value{value:7})};let main:Function(List<String>):Int=function(args:List<String>):Int{0};";
 let late:String="namespace App;public type Visible=product{value:Int;};type Secret=product{value:Int;};public let good:Function(Visible):Visible=function(value:Visible):Visible{value};public let bad:Function():Secret=function():Secret{Secret{value:1}};let main:Function(List<String>):Int=function(args:List<String>):Int{0};";
 var round:Int=0;loop while(round<3){try check(good,true);try check(hidden,false);try check(good,true);try check(packed,true);try check(leaked,false);try check(late,false);round=round+1;};discard writeStdout("SIGNATURE_VISIBILITY_MEMO_OK accepted=9 rejected=9 projects=18\n");Result<Unit,Diagnostic>::Ok(unit)};
let main:Function(List<String>):Int=function(args:List<String>):Int{branch on test(){Result<Unit,Diagnostic>::Ok(value:Unit)=>0,Result<Unit,Diagnostic>::Err(error:Diagnostic)=>{discard writeStdout(error->phase+": "+error->message+"\n");1}}};
