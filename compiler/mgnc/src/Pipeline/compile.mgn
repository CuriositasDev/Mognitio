namespace Mgnc\Pipeline;
use Std\Binary\{Bytes};
use Mgnc\Data\{Diagnostic};
use Mgnc\Semantic\{SemanticProject};
use Mgnc\NativeProject\{Projected,project};
use Mgnc\NativeLayout\{validate};
use Mgnc\IR\{ModuleIR};
use Mgnc\Lower\{lower};
use Mgnc\Verify\{verify};
use Mgnc\Native\{generate};
use Mgnc\Encode\{encode};
public let compile:Function(SemanticProject):Result<Bytes,Diagnostic>=function(semantic:SemanticProject):Result<Bytes,Diagnostic>{
 let projected:Projected=try project(semantic);try validate(semantic,projected);
 let module:ModuleIR=try lower(projected->program);try verify(module);
 encode(try generate(module))
};
