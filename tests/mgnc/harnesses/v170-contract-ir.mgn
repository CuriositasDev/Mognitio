let test:Function(String):Result<Unit,Diagnostic>=function(folder:String):Result<Unit,Diagnostic>{let span:Span=Span{start:0,end:0,line:1,column:1};let context:SemanticProject=try semantic("contract-ir.mgn","namespace App;type Value=product{value:Int;};contract Calc{read(self:Self):Int;plus(self:Self,n:Int):Int;hold(self:Self):Function():Int;checked(self:Self,n:Int):Result<Int,IndexError>;}witness Scalar=Int implements Calc{hold(value:Self):Function():Int{function():Int{value}}plus(value:Self,n:Int):Int{value+n}checked(value:Self,n:Int):Result<Int,IndexError>{let result:Int=try List<Int>[value]->at(n);Result<Int,IndexError>::Ok(result)}read(value:Self):Int{value}}witness Managed=Value implements Calc{read(value:Self):Int{value->value}checked(value:Self,n:Int):Result<Int,IndexError>{let result:Int=try List<Int>[value->value]->at(n);Result<Int,IndexError>::Ok(result)}hold(value:Self):Function():Int{function():Int{value->value}}plus(value:Self,n:Int):Int{value->value+n}}let consume:Function(Calc):Int=function(value:Calc):Int{value->read()+value->plus(2)};let main:Function(List<String>):Int=function(args:List<String>):Int{let a:Calc=Calc(7);let b:Calc=Calc(Value{value:13});assert consume(a)==16;assert consume(b)==28;branch on b->checked(0){Result<Int,IndexError>::Ok(value:Int)=>{assert value==13;},Result<Int,IndexError>::Err(error:IndexError)=>{assert false;}};let held:Function():Int=b->hold();discard \"other\"+\" allocation\";assert held()==13;0};");let source:Project=try lower(context);let baseline:Native=try prepare(context);let plan:Plan=baseline->concrete;try concreteCheck(context,source,plan);try require(baseline->abiRevision==2&&plan->pairs->count==2,span,"contract baseline pairs and ABI");try machineMutants(baseline,flush(try emit(baseline)));let image:Bytes=try compile(baseline);try save(folder+"/baseline",image);
 let changed:Changed=try transform(context,source,plan);try sourceCheck(changed->semantic,changed->source);let permuted:Native=try checked(changed->semantic,changed->source,changed->concrete);let permutedImage:Bytes=try compile(permuted);try require(image==permutedImage,span,"coherent semantic interner permutation native image");try save(folder+"/permuted",permutedImage);let reordered:Native=try checked(context,source,try reorder(plan));let reorderedImage:Bytes=try compile(reordered);try require(image==reorderedImage,span,"concrete request-order native image");try save(folder+"/reordered",reorderedImage);let combined:Native=try checked(changed->semantic,changed->source,try reorder(changed->concrete));let combinedImage:Bytes=try compile(combined);try require(image==combinedImage,span,"combined interner and request-order native image");try save(folder+"/combined",combinedImage);
