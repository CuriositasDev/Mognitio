let origin:Span=Span{start:3,end:8,line:4,column:5};
let word:Function(Int,Int):Bits<64>=function(pattern:Int,index:Int):Bits<64>{branch when{pattern==0=>Bits<64>{0},pattern==1=>Bits<64>{18446744073709551615},index%2==0=>Bits<64>{12297829382473034410},else=>Bits<64>{6148914691236517205}}};
let vector:Function(Int,Int):List<Bits<64>>=function(n:Int,pattern:Int):List<Bits<64>>{var result:List<Bits<64>>=List<Bits<64>>[];var i:Int=0;loop while(i<n){result=result->append(word(pattern,i));i=i+1;};result};
let matches:Function(List<Bits<64>>,Int,Int,List<Int>,List<Bits<64>>):Bool=function(values:List<Bits<64>>,n:Int,pattern:Int,keys:List<Int>,words:List<Bits<64>>):Bool{
 branch when{values->length()!=n=>{return false;},else=>unit};var i:Int=0;
 loop while(i<n){var expected:Bits<64>=word(pattern,i);var j:Int=0;
  loop over(keys as key:Int){branch when{key==i=>{branch on words->at(j){Result<Bits<64>,IndexError>::Ok(value:Bits<64>)=>{expected=value;},Result<Bits<64>,IndexError>::Err(error:IndexError)=>{return false;}};},else=>unit};j=j+1;};
  branch on values->at(i){Result<Bits<64>,IndexError>::Ok(value:Bits<64>)=>{branch when{value!=expected=>{return false;},else=>unit};},Result<Bits<64>,IndexError>::Err(error:IndexError)=>{return false;}};i=i+1;
 };true
};
let materialized:Function(WordEdit,Int,Int,List<Int>,List<Bits<64>>):Bool=function(edit:WordEdit,n:Int,pattern:Int,keys:List<Int>,words:List<Bits<64>>):Bool{
 branch on finishEdit(edit,origin){Result<List<Bits<64>>,Diagnostic>::Ok(value:List<Bits<64>>)=>matches(value,n,pattern,keys,words),Result<List<Bits<64>>,Diagnostic>::Err(error:Diagnostic)=>false}
};
let reads:Function(WordEdit,List<Int>,List<String>):Bool=function(edit:WordEdit,queries:List<Int>,messages:List<String>):Bool{
 var index:Int=0;loop over(queries as slot:Int){
  let expected:String=branch on messages->at(index){Result<String,IndexError>::Ok(value:String)=>value,Result<String,IndexError>::Err(error:IndexError)=>{return false;}};
  branch on requireEdit(edit,slot,origin){Result<Unit,Diagnostic>::Ok(value:Unit)=>{branch when{expected!=""=>{return false;},else=>unit};},Result<Unit,Diagnostic>::Err(error:Diagnostic)=>{branch when{expected==""||error->message!=expected||error->phase!="internal"||error->span->start!=3||error->span->end!=8||error->span->line!=4||error->span->column!=5=>{return false;},else=>unit};}};index=index+1;
 };true
};
