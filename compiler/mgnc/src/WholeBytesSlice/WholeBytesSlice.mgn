namespace Mgnc\WholeBytesSlice;
use Std\Numeric\{Bits};
use Mgnc\Data\{Diagnostic,empty};
use Mgnc\WholeFrameData\{Frame,Point};
use Mgnc\WholeFrame\{begin,end,select};
use Mgnc\WholeABI\{allocateLabel};
use Mgnc\Machine\{Code,label,jump,fresh,field,raw};
use Mgnc\WholeX64\{load,store,mov,address,immediate,constant,alu};
// Bytes, start, end, Result descriptor, SliceError descriptor, Bytes descriptor.
public let emit:Function(Code):Result<Code,Diagnostic>=function(initial:Code):Result<Code,Diagnostic>{
 let frame:Frame=Frame{slots:2,outgoing:8,extent:144,entry:List<Bits<64>>[Bits<64>{1}],points:empty<Point>()};var code:Code=try begin(label(initial,71),frame,List<Int>[0],List<Int>[],162);
 let invalid:Int=code->nextLabel;let result:Int=invalid+1;code=fresh(code,2);code=load(code,3,5,-72);code=load(code,14,3,24);code=load(code,12,5,32);code=load(code,13,5,40);code=alu(code,57,13,14);code=jump(code,List<Int>[15,135],invalid);code=alu(code,57,12,13);code=jump(code,List<Int>[15,135],invalid);
 code=alu(code,41,13,12);code=mov(code,7,13);code=constant(code,0,7,32);code=jump(code,List<Int>[15,128],1);code=load(code,6,5,64);code=jump(code,List<Int>[232],allocateLabel);code=store(code,0,24,13);code=address(code,7,0,32);code=address(code,6,3,32);code=alu(code,1,6,12);code=mov(code,1,13);code=raw(code,List<Int>[243,164]);code=store(code,5,-80,0);code=immediate(code,12,0);code=jump(code,List<Int>[233],result);
 code=label(code,invalid);code=immediate(code,7,48);code=load(code,6,5,56);code=jump(code,List<Int>[232],allocateLabel);code=store(code,0,24,12);code=store(code,0,32,13);code=store(code,0,40,14);code=store(code,5,-80,0);code=immediate(code,12,1);
 code=label(code,result);code=select(code,163);code=immediate(code,7,40);code=load(code,6,5,48);code=jump(code,List<Int>[232],allocateLabel);code=store(code,0,24,12);code=load(code,2,5,-80);code=store(code,0,32,2);code=end(code,frame);
 loop over(List<Int>[162,163] as id:Int){code=label(code,id);code=field(code,4,2);code=field(code,4,branch when{id==162=>1,else=>2});};Result<Code,Diagnostic>::Ok(code)
};
