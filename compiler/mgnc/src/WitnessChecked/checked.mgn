namespace Mgnc\WitnessChecked;
use Mgnc\WitnessIsolation\{verify as verifyIsolation};
use Mgnc\Data\{Diagnostic,lookup};
use Mgnc\Syntax\{Parent};
use Mgnc\SemanticValues\{State,Node,FunctionInfo,Symbol,BodyState};
use Mgnc\SemanticData\{Declaration,Module,Evidence};
use Mgnc\TypeData\{Type,Argument,Member};
use Mgnc\TypeOps\{parentEqual};
use Mgnc\WitnessVerifier\{require,formed,closed,selfUsage,nodeType};
use Mgnc\WitnessSyntax\{extent};
use Mgnc\Projection\{parts,item,text,concrete};
use Mgnc\HeaderRead\{rightList};
use Mgnc\BridgeLists\{leftList};
use Mgnc\VariantSupport\{memberType};
use Mgnc\NodeStorage\{getNode};
use Mgnc\Grammar\{ruleTypeName,ruleWitnessMethod};
use Mgnc\Tables\{atList};
public let declaration:Function(State,Int):Result<Unit,Diagnostic>=function(state:State,id:Int):Result<Unit,Diagnostic>{
 let declared:Declaration=try lookup<Declaration>(state->types->headers->declarations,id);let module:Module=try lookup<Module>(state->types->headers->modules,declared->file);
 branch when{declared->kind!=7=>{try require(declared->evidence->length()==0,declared->span,"evidence on another declaration");return Result<Unit,Diagnostic>::Ok(unit);},else=>unit};
 try require(declared->evidence->length()==1,declared->span,"witness evidence count");let proof:Evidence=try atList<Evidence>(declared->evidence,0);
 try require(proof->declaration==id,declared->span,"witness evidence owner");
 try require((try formed(state->types,declared->file,module->tree,declared->annotation,Parent::None,List<Argument>[]))==proof->concreteType,declared->span,"concrete evidence source");
 try require((try formed(state->types,declared->file,module->tree,declared->body,Parent::None,List<Argument>[]))==proof->contractType,declared->span,"contractType evidence source");
 try closed(state->types,proof->concreteType,declared->span);try closed(state->types,proof->contractType,declared->span);
 let contractType:Type=try lookup<Type>(state->types->types,proof->contractType);try require(contractType->kind==29,declared->span,"evidence contractType kind");
 var previous:Int=0;loop while(previous<id){let other:Declaration=try lookup<Declaration>(state->types->headers->declarations,previous);loop over(other->evidence as existing:Evidence){try require(existing->concreteType!=proof->concreteType||existing->contractType!=proof->contractType,declared->span,"duplicate project pair");};previous=previous+1;};
 let fields:List<Int>=try parts(module->tree,declared->node);let methods:List<Int>=try leftList(module->tree,try item(fields,7));
 try require(methods->length()==proof->methods->length()&&methods->length()==contractType->members->length(),declared->span,"method coverage");
 let body:Int=branch on try lookup<BodyState>(state->bodies,id){BodyState::Complete(root:Int)=>root,BodyState::NotRequired=>{try require(false,declared->span,"method bodies incomplete");return Result<Unit,Diagnostic>::Ok(unit);},BodyState::Pending=>{try require(false,declared->span,"method bodies incomplete");return Result<Unit,Diagnostic>::Ok(unit);},BodyState::Checking=>{try require(false,declared->span,"method bodies incomplete");return Result<Unit,Diagnostic>::Ok(unit);}};
 let container:Node=try lookup<Node>(state->nodes,body);try require(container->operation=="witness"&&container->children->length()==methods->length()&&container->file==declared->file,declared->span,"method body container");
 var ordinal:Int=0;loop over(proof->methods as method:Int){
  var count:Int=0;loop over(methods as original:Int){branch when{original==method=>{count=count+1;},else=>unit};};try require(count==1,declared->span,"method source membership");
  let methodFields:List<Int>=try parts(module->tree,method);let member:Member=try atList<Member>(contractType->members,ordinal);let params:List<Int>=try rightList(module->tree,try item(methodFields,2));
  try require((try getNode(module->tree->nodes,method))->rule==ruleWitnessMethod&&(try text(module->tree,try item(methodFields,0)))==member->name,declared->span,"method declaration order");
  let methodNode:Node=try lookup<Node>(state->nodes,try atList<Int>(container->children,ordinal));let functionId:Int=branch on methodNode->target{Parent::Some(value:Int)=>value,Parent::None=>{try require(false,declared->span,"method function missing");return Result<Unit,Diagnostic>::Ok(unit);}};
  try verifyIsolation(state,try atList<Int>(container->children,ordinal),functionId);
  let info:FunctionInfo=try lookup<FunctionInfo>(state->functions,functionId);let signature:Type=try lookup<Type>(state->types->types,info->valueType);
  let requirement:Int=branch on member->value{Parent::Some(value:Int)=>value,Parent::None=>{try require(false,declared->span,"contractType signature missing");return Result<Unit,Diagnostic>::Ok(unit);}};let wanted:Type=try lookup<Type>(state->types->types,requirement);
  try require(methodNode->operation=="function"&&info->file==declared->file&&info->cursor==(try getNode(module->tree->nodes,method))->start&&parentEqual(info->templateOwner,Parent::Some(id))&&parentEqual(info->parent,Parent::None)&&info->captures->length()==0,declared->span,"isolated method ownership");
  try require((try nodeType(methodNode))==info->valueType&&signature->kind==12&&wanted->kind==12&&signature->arguments->length()==wanted->arguments->length()+1&&params->length()==info->parameters->length()&&params->length()+1==signature->arguments->length(),declared->span,"method signature arity");
  try require((try memberType(signature->arguments,0,declared->span))==proof->concreteType,declared->span,"method receiver signature");
  var position:Int=0;loop while(position<wanted->arguments->length()){try require((try memberType(signature->arguments,position+1,declared->span))==(try memberType(wanted->arguments,position,declared->span)),declared->span,"exact method signature");position=position+1;};
  position=0;var allowed:Int= -1;loop over(params as param:Int){let values:List<Int>=try parts(module->tree,param);let annotation:Int=try concrete(module->tree,try item(values,2));
   let isSelf:Bool=position==0&&(try getNode(module->tree->nodes,annotation))->rule==ruleTypeName&&(try text(module->tree,annotation))=="Self";
   let expected:Int=branch when{isSelf=>{allowed=annotation;proof->concreteType},else=>try formed(state->types,declared->file,module->tree,annotation,Parent::Some(id),List<Argument>[])};
   try require(expected==(try memberType(signature->arguments,position,declared->span)),declared->span,"method parameter source");
   let symbol:Symbol=try lookup<Symbol>(state->symbols,try atList<Int>(info->parameters,position));try require(symbol->name==(try text(module->tree,try item(values,0)))&&symbol->valueType==expected&&!symbol->mutable&&parentEqual(symbol->functionOwner,Parent::Some(functionId)),declared->span,"method parameter binding");position=position+1;
  };
  try selfUsage(module->tree,method,allowed);try require((try formed(state->types,declared->file,module->tree,try item(methodFields,5),Parent::Some(id),List<Argument>[]))==(try memberType(signature->arguments,params->length(),declared->span)),declared->span,"method result source");ordinal=ordinal+1;
 };Result<Unit,Diagnostic>::Ok(unit)
};
