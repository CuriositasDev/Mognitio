 runtimeTypes:RuntimeTypes;concrete:Plan;closures:Closures;layouts:Layouts;procedures:Paged<Procedure>;literals:Paged<Literal>;constructors:Paged<Constructor>;
 globals:Paged<Global>;globalSymbols:Map;globalDeclarations:Map;globalRoots:List<Bits<64>>;
