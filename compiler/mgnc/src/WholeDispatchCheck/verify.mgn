namespace Mgnc\WholeDispatchCheck;
use Mgnc\Data\{Paged,Diagnostic,Span,empty,push,lookup};
use Mgnc\Syntax\{Parent};
use Mgnc\Semantic\{SemanticProject};
use Mgnc\SemanticData\{Declaration,Evidence};
use Mgnc\SemanticValues\{BodyState,Node,FunctionInfo};
use Mgnc\TypeData\{Type,Argument,ValueTerm,Member};
use Mgnc\TypeOps\{parentEqual};
use Mgnc\WholeIR\{Project,Slot,Block,Operation};
use Mgnc\WholeConcrete\{Plan,Instance};
use Mgnc\WholeSubstitution\{Binding};
use Mgnc\WholeDispatchData\{Pair};
use Mgnc\WholeConcreteTypes\{closed};
use Mgnc\WholeStableKeys\{shape,vector,compare};
use Mgnc\WholeChecks\{require,present};
use Mgnc\Tables\{atList};
use Mgnc\IntMap\{Map,create,get,put};
let typeArgument:Function(List<Argument>,Int,Span):Result<Int,Diagnostic>=function(arguments:List<Argument>,index:Int,span:Span):Result<Int,Diagnostic>{branch on try atList<Argument>(arguments,index){Argument::Type(id:Int)=>Result<Int,Diagnostic>::Ok(id),Argument::Value(term:ValueTerm)=>{try require(false,span,"dispatch signature type argument");Result<Int,Diagnostic>::Ok(0)}}};
// Return only checked package edges. The caller's traversal owns reachability.
public let verify:Function(SemanticProject,Project,Plan):Result<Paged<List<Int>>,Diagnostic>=function(semantic:SemanticProject,source:Project,plan:Plan):Result<Paged<List<Int>>,Diagnostic>{
 let span:Span=Span{start:0,end:0,line:1,column:1};var selected:Map=create();var used:Map=create();var pairIndex:Int=0;
 loop over(plan->pairs->pages->append(plan->pairs->tail) as page:List<Pair>){loop over(page as pair:Pair){
  try require((try get(selected,pair->implementation))<0,span,"duplicate dispatch witness");selected=try put(selected,pair->implementation,pairIndex);
  let declared:Declaration=try lookup<Declaration>(source->types->headers->declarations,pair->implementation);try require(declared->kind==7&&declared->parameters->length()==0&&declared->evidence->length()==1,span,"dispatch source witness declaration");let proof:Evidence=try atList<Evidence>(declared->evidence,0);
  try require(proof->declaration==pair->implementation&&proof->concreteType==pair->concreteType&&proof->contractType==pair->contractType,span,"dispatch source evidence pair");try closed(plan->types,pair->concreteType,span);try closed(plan->types,pair->contractType,span);let contractShape:Type=try lookup<Type>(plan->types->types,pair->contractType);
  try require(contractShape->kind==29&&pair->methods->length()==contractShape->members->length()&&pair->signatures->length()==pair->methods->length()&&pair->methods->length()==proof->methods->length(),span,"dispatch member coverage");
  var prior:Int=0;loop while(prior<pairIndex){let other:Pair=try lookup<Pair>(plan->pairs,prior);try require(other->concreteType!=pair->concreteType||other->contractType!=pair->contractType,span,"duplicate dispatch concrete pair");prior=prior+1;};
  let body:Int=branch on try lookup<BodyState>(semantic->state->bodies,pair->implementation){BodyState::Complete(node:Int)=>node,BodyState::NotRequired=>{try require(false,span,"dispatch source witness body");0},BodyState::Pending=>{try require(false,span,"dispatch source witness pending");0},BodyState::Checking=>{try require(false,span,"dispatch source witness checking");0}};
  let container:Node=try lookup<Node>(semantic->state->nodes,body);try require(container->operation=="witness"&&container->children->length()==pair->methods->length(),span,"dispatch method source container");var ordinal:Int=0;
  loop over(pair->methods as method:Int){let sourceNode:Node=try lookup<Node>(semantic->state->nodes,try atList<Int>(container->children,ordinal));let functionId:Int=try present(sourceNode->target,span,"dispatch source method identity");let info:FunctionInfo=try lookup<FunctionInfo>(semantic->state->functions,functionId);let actual:Instance=try lookup<Instance>(plan->instances,method);
   try require(sourceNode->operation=="function"&&parentEqual(info->templateOwner,Parent::Some(pair->implementation))&&parentEqual(info->parent,Parent::None)&&info->captures->length()==0,span,"dispatch method ownership");
   try require(actual->key->body==(try lookup<Int>(source->functions,functionId))&&actual->key->bindings->length()==1&&parentEqual(actual->body->functionOwner,Parent::Some(functionId))&&actual->body->captures->length()==0,span,"dispatch method complete body key");let binding:Binding=try atList<Binding>(actual->key->bindings,0);try require(binding->owner==pair->implementation&&binding->arguments->length()==0,span,"dispatch method lexical bindings");
   let signatureId:Int=try atList<Int>(pair->signatures,ordinal);try require(signatureId==info->valueType,span,"dispatch source method signature identity");try closed(plan->types,signatureId,span);let signature:Type=try lookup<Type>(plan->types->types,signatureId);let memberType:Int=try present((try atList<Member>(contractShape->members,ordinal))->value,span,"dispatch contract signature");let wanted:Type=try lookup<Type>(plan->types->types,memberType);
   try require(signature->kind==12&&wanted->kind==12&&signature->arguments->length()==wanted->arguments->length()+1&&actual->body->parameters->length()+1==signature->arguments->length(),span,"dispatch method signature arity");try require((try typeArgument(signature->arguments,0,span))==pair->concreteType,span,"dispatch concrete receiver signature");
   var position:Int=0;loop while(position<wanted->arguments->length()){try require((try typeArgument(signature->arguments,position+1,span))==(try typeArgument(wanted->arguments,position,span)),span,"dispatch exact contract method signature");position=position+1;};position=0;loop over(actual->body->parameters as parameter:Int){try require((try lookup<Slot>(actual->body->slots,parameter))->valueType==(try typeArgument(signature->arguments,position,span)),span,"dispatch method parameter type");position=position+1;};try require(actual->body->resultType==(try typeArgument(signature->arguments,position,span)),span,"dispatch method result type");ordinal=ordinal+1;
  };pairIndex=pairIndex+1;
 };};
 var edges:Paged<List<Int>>=empty<List<Int>>();loop over(plan->instances->pages->append(plan->instances->tail) as page:List<Instance>){loop over(page as instance:Instance){var targets:List<Int>=List<Int>[];
  loop over(instance->body->blocks->pages->append(instance->body->blocks->tail) as blocks:List<Block>){loop over(blocks as block:Block){loop over(block->operations as op:Operation){branch when{op->code=="package"&&op->unavailable->length()==0=>{
   let implementation:Int=try present(op->target,op->origin->span,"package selected witness");let index:Int=try get(selected,implementation);try require(index>=0,op->origin->span,"missing dispatch concrete pair");let pair:Pair=try lookup<Pair>(plan->pairs,index);try require(op->arguments->length()==2&&op->inputs->length()==1,op->origin->span,"package operand arity");try require((try typeArgument(op->arguments,0,span))==pair->concreteType&&(try typeArgument(op->arguments,1,span))==pair->contractType,op->origin->span,"package selected pair type arguments");let input:Int=try atList<Int>(op->inputs,0);let output:Int=try present(op->output,op->origin->span,"completed package output");try require((try lookup<Slot>(instance->body->slots,input))->valueType==pair->concreteType&&(try lookup<Slot>(instance->body->slots,output))->valueType==pair->contractType,op->origin->span,"package typed operands");used=try put(used,implementation,1);loop over(pair->methods as method:Int){targets=targets->append(method);};
  },op->code=="dispatch"&&op->unavailable->length()==0=>{
   let contractId:Int=try present(op->target,op->origin->span,"dispatch contract identity");let contractShape:Type=try lookup<Type>(plan->types->types,contractId);try require(contractShape->kind==29&&op->mapping->length()==1&&op->arguments->length()==0&&op->inputs->length()>0,op->origin->span,"dispatch typed member selection");let ordinal:Int=try atList<Int>(op->mapping,0);try require(ordinal>=0&&ordinal<contractShape->members->length(),op->origin->span,"dispatch typed member ordinal");let member:Member=try atList<Member>(contractShape->members,ordinal);let signature:Type=try lookup<Type>(plan->types->types,try present(member->value,op->origin->span,"dispatch member signature"));try require(signature->kind==12&&signature->arguments->length()==op->inputs->length(),op->origin->span,"dispatch typed argument arity");var position:Int=0;loop over(op->inputs as input:Int){let expected:Int=branch when{position==0=>contractId,else=>try typeArgument(signature->arguments,position-1,op->origin->span)};try require((try lookup<Slot>(instance->body->slots,input))->valueType==expected,op->origin->span,"dispatch typed argument value");position=position+1;};let output:Int=try present(op->output,op->origin->span,"dispatch completed result");try require((try lookup<Slot>(instance->body->slots,output))->valueType==(try typeArgument(signature->arguments,signature->arguments->length()-1,op->origin->span)),op->origin->span,"dispatch typed result value");
  },else=>unit};};};};edges=push<List<Int>>(edges,targets);
 };};loop over(plan->pairs->pages->append(plan->pairs->tail) as page:List<Pair>){loop over(page as pair:Pair){try require((try get(used,pair->implementation))>=0,span,"unrequested dispatch concrete pair");};};Result<Paged<List<Int>>,Diagnostic>::Ok(edges)
};
// Inspect adjacent identities directly; do not call producer canonicalization.
public let canonical:Function(Plan):Result<Unit,Diagnostic>=function(plan:Plan):Result<Unit,Diagnostic>{let span:Span=Span{start:0,end:0,line:1,column:1};var previous:Paged<Int>=empty<Int>();var ordinal:Int=0;loop over(plan->pairs->pages->append(plan->pairs->tail) as page:List<Pair>){loop over(page as pair:Pair){let contractShape:List<Int>=try shape(plan->types,pair->contractType);let concrete:List<Int>=try shape(plan->types,pair->concreteType);var key:List<Int>=List<Int>[contractShape->length()];loop over(contractShape as item:Int){key=key->append(item);};key=key->append(concrete->length());loop over(concrete as item:Int){key=key->append(item);};let actual:Paged<Int>=vector(key);branch when{ordinal>0=>{try require((try compare(previous,actual))<0,span,"canonical dispatch pair order");},else=>unit};previous=actual;ordinal=ordinal+1;};};Result<Unit,Diagnostic>::Ok(unit)};
