namespace Mgnc\WholeStandardProof;
use Mgnc\Data\{Diagnostic,Span,lookup};
use Mgnc\TypeData\{Type,Member,Argument,ValueTerm};
use Mgnc\SemanticData\{Declaration,Module};
use Mgnc\WholeNativeData\{Native,Global};
use Mgnc\WholeChecks\{require,present};
use Mgnc\WholeLayout\{argumentType};
use Mgnc\Tables\{atList};
use Mgnc\IntMap\{get};
public let helper:Function(Native,Global):Result<Int,Diagnostic>=function(plan:Native,value:Global):Result<Int,Diagnostic>{
 let span:Span=Span{start:0,end:0,line:1,column:1};let declaration:Declaration=try lookup<Declaration>(plan->concrete->types->headers->declarations,value->declaration);let module:Module=try lookup<Module>(plan->concrete->types->headers->modules,declaration->file);try require(module->standard&&value->standard==declaration->name,span,"standard Function origin");let name:String=declaration->name;
 branch when{module->nameSpace=="Std\\Io"=>{let id:Int=branch when{name=="readTextFile"=>50,name=="writeTextFile"=>51,name=="readStdin"=>52,name=="writeStdout"=>53,name=="writeStderr"=>54,else=>-1};try require(id>=0,span,"standard I/O Function identity");Result<Int,Diagnostic>::Ok(id)},else=>{
  try require(module->nameSpace=="Std\\Binary"&&(name=="bytesFromInts"||name=="bytesFromBits"),span,"standard Binary Function identity");let checked:Bool=name=="bytesFromInts";let signature:Type=try lookup<Type>(plan->concrete->types->types,value->valueType);try require(signature->kind==12&&signature->arguments->length()==2,span,"Binary Function signature");let input:Type=try lookup<Type>(plan->concrete->types->types,try argumentType(signature,0,span));try require(input->kind==10&&input->arguments->length()==1,span,"Binary Function input List");let element:Type=try lookup<Type>(plan->concrete->types->types,try argumentType(input,0,span));let output:Int=try argumentType(signature,1,span);var byteId:Int=output;
  branch when{checked=>{try require(element->kind==1,span,"bytesFromInts element");let result:Type=try lookup<Type>(plan->concrete->types->types,output);try require(result->kind==11&&result->arguments->length()==2,span,"bytesFromInts Result");byteId=try argumentType(result,0,span);let error:Type=try lookup<Type>(plan->concrete->types->types,try argumentType(result,1,span));let owner:Declaration=try lookup<Declaration>(plan->concrete->types->headers->declarations,try present(error->owner,span,"ByteValueError owner"));let source:Module=try lookup<Module>(plan->concrete->types->headers->modules,owner->file);try require(error->kind==20&&owner->name=="ByteValueError"&&source->standard&&source->nameSpace=="Std\\Binary"&&error->members->length()==2,span,"ByteValueError identity");var ordinal:Int=0;loop over(error->members as field:Member){try require(field->name==branch when{ordinal==0=>"index",else=>"value"}&&(try present(field->value,span,"ByteValueError field"))==1,span,"ByteValueError fields");ordinal=ordinal+1;};},else=>{try require(element->kind==24&&element->arguments->length()==1,span,"bytesFromBits element");branch on try atList<Argument>(element->arguments,0){Argument::Value(term:ValueTerm)=>{try require(term->value==8,span,"bytesFromBits width");},Argument::Type(id:Int)=>{try require(false,span,"bytesFromBits value width");}};}};
  try require((try lookup<Type>(plan->concrete->types->types,byteId))->kind==25,span,"Binary Function Bytes result");Result<Int,Diagnostic>::Ok(branch when{checked=>73,else=>74})
 }}
};

public let descriptors:Function(Native,Global):Result<List<Int>,Diagnostic>=function(plan:Native,value:Global):Result<List<Int>,Diagnostic>{
 let id:Int=try helper(plan,value);let span:Span=Span{start:0,end:0,line:1,column:1};let signature:Type=try lookup<Type>(plan->concrete->types->types,value->valueType);let resultId:Int=try argumentType(signature,1,span);let output:Type=try lookup<Type>(plan->concrete->types->types,resultId);
 branch when{id==74=>Result<List<Int>,Diagnostic>::Ok(List<Int>[try get(plan->layouts->types,resultId)]),id==73=>Result<List<Int>,Diagnostic>::Ok(List<Int>[try get(plan->layouts->buffers,try argumentType(signature,0,span)),try get(plan->layouts->types,try argumentType(output,1,span)),try get(plan->layouts->types,try argumentType(output,0,span)),try get(plan->layouts->types,resultId)]),else=>{try require(false,span,"binary allocation signature");Result<List<Int>,Diagnostic>::Ok(List<Int>[])}}
};
