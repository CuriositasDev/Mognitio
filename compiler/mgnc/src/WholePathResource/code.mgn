namespace Mgnc\WholePathResource;
use Mgnc\Machine\{Code,label,jump,fresh,raw};
use Mgnc\WholeX64\{mov,immediate,alu,constant};
public let emit:Function(Code):Code=function(initial:Code):Code{var code:Code=label(initial,83);let cases:Int=code->nextLabel;code=fresh(code,7);var index:Int=0;loop over(List<List<Int>>[List<Int>[36],List<Int>[2],List<Int>[1,13,30],List<Int>[20,21],List<Int>[12,23,24,28,122,31]] as group:List<Int>){loop over(group as errno:Int){code=constant(code,7,0,-errno);code=jump(code,List<Int>[15,132],cases+index);};index=index+1;};code=immediate(code,0,7);code=raw(code,List<Int>[195]);index=0;loop over(List<Int>[0,2,3,4,6] as kind:Int){code=label(code,cases+index);code=immediate(code,0,kind);code=raw(code,List<Int>[195]);index=index+1;};
 code=label(code,84);code=mov(code,6,7);code=immediate(code,7,0);code=immediate(code,2,3);code=immediate(code,10,34);code=immediate(code,8,-1);code=immediate(code,9,0);code=immediate(code,0,9);code=raw(code,List<Int>[15,5]);code=constant(code,7,0,-22);code=jump(code,List<Int>[15,132],2);code=constant(code,7,0,-4095);code=jump(code,List<Int>[15,131],1);code=alu(code,133,0,0);code=jump(code,List<Int>[15,142],2);code=mov(code,2,0);code=constant(code,4,2,4095);code=jump(code,List<Int>[15,133],2);raw(code,List<Int>[195])};
