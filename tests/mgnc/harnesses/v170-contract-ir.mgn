let reject:Function(Result<Unit,Diagnostic>,String):Result<Unit,Diagnostic>=function(result:Result<Unit,Diagnostic>,name:String):Result<Unit,Diagnostic>{let span:Span=Span{start:0,end:0,line:1,column:1};branch on result{Result<Unit,Diagnostic>::Ok(value:Unit)=>{try require(false,span,"accepted contract mutation: "+name);},Result<Unit,Diagnostic>::Err(error:Diagnostic)=>{try require(error->phase=="internal",span,"wrong contract mutation diagnostic phase: "+error->message);discard writeStdout("V170_CONTRACT_MUTANT "+name+"\n");}};Result<Unit,Diagnostic>::Ok(unit)};
let semantic:Function(String,String):Result<SemanticProject,Diagnostic>=function(name:String,text:String):Result<SemanticProject,Diagnostic>{let input:SourceUnit=SourceUnit{path:name,displayPath:name,relativePath:name,expectedNamespace:"",text:text};branch on analyze(ProjectInput{manifestPath:"",manifestText:"",rootNamespace:"",entry:0,sources:List<SourceUnit>[input]}){Result<SemanticProject,InputError>::Ok(value:SemanticProject)=>Result<SemanticProject,Diagnostic>::Ok(value),Result<SemanticProject,InputError>::Err(error:InputError)=>Result<SemanticProject,Diagnostic>::Err(error->diagnostic)}};
let checked:Function(SemanticProject,Project,Plan):Result<Native,Diagnostic>=function(context:SemanticProject,source:Project,plan:Plan):Result<Native,Diagnostic>{try sourceCheck(context,source);try concreteCheck(context,source,plan);let value:Native=try nativeBuild(context,source,plan);try nativeCheck(context,source,value);Result<Native,Diagnostic>::Ok(value)};
let save:Function(String,Bytes):Result<Unit,Diagnostic>=function(path:String,data:Bytes):Result<Unit,Diagnostic>{branch on publishFile(path,data,BinaryFileMode::Executable){Result<Unit,BinaryOutputError>::Ok(value:Unit)=>Result<Unit,Diagnostic>::Ok(unit),Result<Unit,BinaryOutputError>::Err(error:BinaryOutputError)=>{try require(false,Span{start:0,end:0,line:1,column:1},"contract test image publication");Result<Unit,Diagnostic>::Ok(unit)}}};
let withPairs:Function(Plan,Paged<Pair>):Plan=function(original:Plan,pairs:Paged<Pair>):Plan{Plan{pairs:pairs,types:original->types,instances:original->instances,initializers:original->initializers}};
let methods:Function(Pair,List<Int>,List<Int>):Pair=function(original:Pair,entries:List<Int>,signatures:List<Int>):Pair{Pair{implementation:original->implementation,concreteType:original->concreteType,contractType:original->contractType,methods:entries,signatures:signatures}};
