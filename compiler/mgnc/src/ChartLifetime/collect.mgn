namespace Mgnc\ChartLifetime;
use Mgnc\Data\{Paged,empty,push,lookup,Span,Diagnostic,problem};
use Mgnc\Buckets\{Buckets,blank,bucket,putBucket};
use Mgnc\ForestData\{ChartItem};
use Mgnc\ItemStorage\{getItem};
use Mgnc\Forest\{Stable,LiveColumn,Pending};
public let historical:Function(Paged<LiveColumn>,Int):Result<Stable,Diagnostic>=function(history:Paged<LiveColumn>,cursor:Int):Result<Stable,Diagnostic>{
 var low:Int=0;var high:Int=history->count;
 loop while(low<high){
  let middle:Int=low+(high-low)/2;let column:LiveColumn=try lookup<LiveColumn>(history,middle);
  branch when{column->cursor==cursor=>{return Result<Stable,Diagnostic>::Ok(column->body);},column->cursor<cursor=>{low=middle+1;},else=>{high=middle;}};
 };
 Result<Stable,Diagnostic>::Err(problem("internal",Span{start:0,end:0,line:1,column:1},"missing live chart origin"))
};
type Origins=product{items:Paged<Int>;keys:Buckets;};
let contains:Function(Origins,Int):Bool=function(origins:Origins,cursor:Int):Bool{
 loop over(bucket(origins->keys,(cursor/2)%16) as previous:Int){branch when{previous==cursor=>{return true;},else=>unit};};false
};
let enqueue:Function(Origins,Int):Origins=function(origins:Origins,cursor:Int):Origins{
 branch when{contains(origins,cursor)=>{return origins;},else=>unit};
 let bin:Int=(cursor/2)%16;let keys:List<Int>=bucket(origins->keys,bin);
 Origins{items:push<Int>(origins->items,cursor),keys:putBucket(origins->keys,bin,keys->append(cursor))}
};
// Conservative origin closure: every possible matching waiter is among these
// nonterminal waiters. Keeping additional origins cannot remove any derivation.
// Completed items are excluded: they do not represent a future resumption.
public let retain:Function(Paged<LiveColumn>,List<List<Pending>>):Result<Paged<LiveColumn>,Diagnostic>=function(history:Paged<LiveColumn>,future:List<List<Pending>>):Result<Paged<LiveColumn>,Diagnostic>{
 var origins:Origins=Origins{items:empty<Int>(),keys:blank()};
 loop over(future as entries:List<Pending>){loop over(entries as entry:Pending){origins=enqueue(origins,entry->origin);};};
 var current:Int=0;
 loop while(current<origins->items->count){
  let cursor:Int=try lookup<Int>(origins->items,current);current=current+1;
  let column:Stable=try historical(history,cursor);var bin:Int=0;
  loop while(bin<16){
   loop over(bucket(column->waits,bin) as index:Int){
    let parent:ChartItem=try getItem(column->items,index);
    branch when{parent->origin!=cursor=>{origins=enqueue(origins,parent->origin);},else=>unit};
   };bin=bin+1;
  };
 };
 var result:Paged<LiveColumn>=empty<LiveColumn>();
 loop over(history->pages->append(history->tail) as page:List<LiveColumn>){
  loop over(page as column:LiveColumn){branch when{contains(origins,column->cursor)=>{result=push<LiveColumn>(result,column);},else=>unit};};
 };
 Result<Paged<LiveColumn>,Diagnostic>::Ok(result)
};
