let writePage:Function(NodePage,Int,ForestNode):NodePage=function(page:NodePage,lane:Int,value:ForestNode):NodePage{
NodePage{symbol0:branch when{lane==0=>value->symbol,else=>page->symbol0},slot0:branch when{lane==0=>value->slot,else=>page->slot0},start0:branch when{lane==0=>value->start,else=>page->start0},end0:branch when{lane==0=>value->end,else=>page->end0},rule0:branch when{lane==0=>value->rule,else=>page->rule0},left0:branch when{lane==0=>value->left,else=>page->left0},right0:branch when{lane==0=>value->right,else=>page->right0},split0:branch when{lane==0=>value->split,else=>page->split0},alternatives0:branch when{lane==0=>value->alternatives,else=>page->alternatives0},symbol1:branch when{lane==1=>value->symbol,else=>page->symbol1},slot1:branch when{lane==1=>value->slot,else=>page->slot1},start1:branch when{lane==1=>value->start,else=>page->start1},end1:branch when{lane==1=>value->end,else=>page->end1},rule1:branch when{lane==1=>value->rule,else=>page->rule1},left1:branch when{lane==1=>value->left,else=>page->left1},right1:branch when{lane==1=>value->right,else=>page->right1},split1:branch when{lane==1=>value->split,else=>page->split1},alternatives1:branch when{lane==1=>value->alternatives,else=>page->alternatives1},symbol2:branch when{lane==2=>value->symbol,else=>page->symbol2},slot2:branch when{lane==2=>value->slot,else=>page->slot2},start2:branch when{lane==2=>value->start,else=>page->start2},end2:branch when{lane==2=>value->end,else=>page->end2},rule2:branch when{lane==2=>value->rule,else=>page->rule2},left2:branch when{lane==2=>value->left,else=>page->left2},right2:branch when{lane==2=>value->right,else=>page->right2},split2:branch when{lane==2=>value->split,else=>page->split2},alternatives2:branch when{lane==2=>value->alternatives,else=>page->alternatives2},symbol3:branch when{lane==3=>value->symbol,else=>page->symbol3},slot3:branch when{lane==3=>value->slot,else=>page->slot3},start3:branch when{lane==3=>value->start,else=>page->start3},end3:branch when{lane==3=>value->end,else=>page->end3},rule3:branch when{lane==3=>value->rule,else=>page->rule3},left3:branch when{lane==3=>value->left,else=>page->left3},right3:branch when{lane==3=>value->right,else=>page->right3},split3:branch when{lane==3=>value->split,else=>page->split3},alternatives3:branch when{lane==3=>value->alternatives,else=>page->alternatives3},symbol4:branch when{lane==4=>value->symbol,else=>page->symbol4},slot4:branch when{lane==4=>value->slot,else=>page->slot4},start4:branch when{lane==4=>value->start,else=>page->start4},end4:branch when{lane==4=>value->end,else=>page->end4},rule4:branch when{lane==4=>value->rule,else=>page->rule4},left4:branch when{lane==4=>value->left,else=>page->left4},right4:branch when{lane==4=>value->right,else=>page->right4},split4:branch when{lane==4=>value->split,else=>page->split4},alternatives4:branch when{lane==4=>value->alternatives,else=>page->alternatives4},symbol5:branch when{lane==5=>value->symbol,else=>page->symbol5},slot5:branch when{lane==5=>value->slot,else=>page->slot5},start5:branch when{lane==5=>value->start,else=>page->start5},end5:branch when{lane==5=>value->end,else=>page->end5},rule5:branch when{lane==5=>value->rule,else=>page->rule5},left5:branch when{lane==5=>value->left,else=>page->left5},right5:branch when{lane==5=>value->right,else=>page->right5},split5:branch when{lane==5=>value->split,else=>page->split5},alternatives5:branch when{lane==5=>value->alternatives,else=>page->alternatives5},symbol6:branch when{lane==6=>value->symbol,else=>page->symbol6},slot6:branch when{lane==6=>value->slot,else=>page->slot6},start6:branch when{lane==6=>value->start,else=>page->start6},end6:branch when{lane==6=>value->end,else=>page->end6},rule6:branch when{lane==6=>value->rule,else=>page->rule6},left6:branch when{lane==6=>value->left,else=>page->left6},right6:branch when{lane==6=>value->right,else=>page->right6},split6:branch when{lane==6=>value->split,else=>page->split6},alternatives6:branch when{lane==6=>value->alternatives,else=>page->alternatives6},symbol7:branch when{lane==7=>value->symbol,else=>page->symbol7},slot7:branch when{lane==7=>value->slot,else=>page->slot7},start7:branch when{lane==7=>value->start,else=>page->start7},end7:branch when{lane==7=>value->end,else=>page->end7},rule7:branch when{lane==7=>value->rule,else=>page->rule7},left7:branch when{lane==7=>value->left,else=>page->left7},right7:branch when{lane==7=>value->right,else=>page->right7},split7:branch when{lane==7=>value->split,else=>page->split7},alternatives7:branch when{lane==7=>value->alternatives,else=>page->alternatives7},symbol8:branch when{lane==8=>value->symbol,else=>page->symbol8},slot8:branch when{lane==8=>value->slot,else=>page->slot8},start8:branch when{lane==8=>value->start,else=>page->start8},end8:branch when{lane==8=>value->end,else=>page->end8},rule8:branch when{lane==8=>value->rule,else=>page->rule8},left8:branch when{lane==8=>value->left,else=>page->left8},right8:branch when{lane==8=>value->right,else=>page->right8},split8:branch when{lane==8=>value->split,else=>page->split8},alternatives8:branch when{lane==8=>value->alternatives,else=>page->alternatives8},symbol9:branch when{lane==9=>value->symbol,else=>page->symbol9},slot9:branch when{lane==9=>value->slot,else=>page->slot9},start9:branch when{lane==9=>value->start,else=>page->start9},end9:branch when{lane==9=>value->end,else=>page->end9},rule9:branch when{lane==9=>value->rule,else=>page->rule9},left9:branch when{lane==9=>value->left,else=>page->left9},right9:branch when{lane==9=>value->right,else=>page->right9},split9:branch when{lane==9=>value->split,else=>page->split9},alternatives9:branch when{lane==9=>value->alternatives,else=>page->alternatives9},symbol10:branch when{lane==10=>value->symbol,else=>page->symbol10},slot10:branch when{lane==10=>value->slot,else=>page->slot10},start10:branch when{lane==10=>value->start,else=>page->start10},end10:branch when{lane==10=>value->end,else=>page->end10},rule10:branch when{lane==10=>value->rule,else=>page->rule10},left10:branch when{lane==10=>value->left,else=>page->left10},right10:branch when{lane==10=>value->ri