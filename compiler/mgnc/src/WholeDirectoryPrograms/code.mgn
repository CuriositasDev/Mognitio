namespace Mgnc\WholeDirectoryPrograms;
use Mgnc\Data\{Diagnostic};
use Mgnc\WholeDirectoryStep\{emit as emitRows};
use Mgnc\Machine\{Code,fresh};
use Mgnc\DirectoryData\Read0\{rows as rowsRead0};
use Mgnc\DirectoryData\Read1\{rows as rowsRead1};
use Mgnc\DirectoryData\Read2\{rows as rowsRead2};
use Mgnc\DirectoryData\Read3\{rows as rowsRead3};
use Mgnc\DirectoryData\Read4\{rows as rowsRead4};
use Mgnc\DirectoryData\Read5\{rows as rowsRead5};
use Mgnc\DirectoryData\Read6\{rows as rowsRead6};
use Mgnc\DirectoryData\Read7\{rows as rowsRead7};
use Mgnc\DirectoryData\Compare0\{rows as rowsCompare0};
use Mgnc\DirectoryData\Names0\{rows as rowsNames0};
use Mgnc\DirectoryData\Sift0\{rows as rowsSift0};
use Mgnc\DirectoryData\Sift1\{rows as rowsSift1};
use Mgnc\DirectoryData\Sort0\{rows as rowsSort0};
use Mgnc\DirectoryData\Sort1\{rows as rowsSort1};
public let emit:Function(Code,Int):Result<Code,Diagnostic>=function(initial:Code,owner:Int):Result<Code,Diagnostic>{var code:Code=initial;let base:Int=code->nextLabel;
branch when{owner==79=>{code=fresh(code,35);
code=try emitRows(code,rowsRead0(),base,owner);
code=try emitRows(code,rowsRead1(),base,owner);
code=try emitRows(code,rowsRead2(),base,owner);
code=try emitRows(code,rowsRead3(),base,owner);
code=try emitRows(code,rowsRead4(),base,owner);
code=try emitRows(code,rowsRead5(),base,owner);
code=try emitRows(code,rowsRead6(),base,owner);
code=try emitRows(code,rowsRead7(),base,owner);
},else=>unit};
branch when{owner==85=>{code=fresh(code,4);
code=try emitRows(code,rowsCompare0(),base,owner);
},else=>unit};
branch when{owner==86=>{code=fresh(code,4);
code=try emitRows(code,rowsNames0(),base,owner);
},else=>unit};
branch when{owner==87=>{code=fresh(code,3);
code=try emitRows(code,rowsSift0(),base,owner);
code=try emitRows(code,rowsSift1(),base,owner);
},else=>unit};
branch when{owner==88=>{code=fresh(code,3);
code=try emitRows(code,rowsSort0(),base,owner);
code=try emitRows(code,rowsSort1(),base,owner);
},else=>unit};
Result<Code,Diagnostic>::Ok(code)};
