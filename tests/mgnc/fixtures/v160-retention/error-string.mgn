namespace App;
let pass:Function(Result<String,String>):Result<Int,String>=function(input:Result<String,String>):Result<Int,String>{let value:String=try input;Result<Int,String>::Ok(value->length())};
let main:Function(List<String>):Int=function(args:List<String>):Int{discard args;branch on pass(Result<String,String>::Err("retained"+" error")){Result<Int,String>::Ok(value:Int)=>1,Result<Int,String>::Err(error:String)=>branch when{error=="retained error"=>0,else=>2}}};
