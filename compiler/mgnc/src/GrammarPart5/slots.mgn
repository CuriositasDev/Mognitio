namespace Mgnc\GrammarPart5;
use Mgnc\Data\{Paged,push};
use Mgnc\GrammarData\{Slot};
// Generated fixed grammar slots; every part is included in the C1 inventory.
public let extend:Function(Paged<Slot>):Paged<Slot>=function(initial:Paged<Slot>):Paged<Slot>{
 var result:Paged<Slot>=initial;
 loop over(List<Slot>[
 Slot{lhs:42,rule:96,dot:2,next:43},
 Slot{lhs:42,rule:96,dot:3,next:0},
 Slot{lhs:43,rule:97,dot:0,next:44},
