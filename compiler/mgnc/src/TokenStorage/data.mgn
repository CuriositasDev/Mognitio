TokenPage{kind0:v0->kind,text0:v0->text,start0:v0->start,end0:v0->end,line0:v0->line,column0:v0->column,scalarStart0:v0->scalarStart,scalarEnd0:v0->scalarEnd,endLine0:v0->endLine,endColumn0:v0->endColumn,kind1:v1->kind,text1:v1->text,start1:v1->start,end1:v1->end,line1:v1->line,column1:v1->column,scalarStart1:v1->scalarStart,scalarEnd1:v1->scalarEnd,endLine1:v1->endLine,endColumn1:v1->endColumn,kind2:v2->kind,text2:v2->text,start2:v2->start,end2:v2->end,line2:v2->line,column2:v2->column,scalarStart2:v2->scalarStart,scalarEnd2:v2->scalarEnd,endLine2:v2->endLine,endColumn2:v2->endColumn,kind3:v3->kind,text3:v3->text,start3:v3->start,end3:v3->end,line3:v3->line,column3:v3->column,scalarStart3:v3->scalarStart,scalarEnd3:v3->scalarEnd,endLine3:v3->endLine,endColumn3:v3->endColumn,kind4:v4->kind,text4:v4->text,start4:v4->start,end4:v4->end,line4:v4->line,column4:v4->column,scalarStart4:v4->scalarStart,scalarEnd4:v4->scalarEnd,endLine4:v4->endLine,endColumn4:v4->endColumn,kind5:v5->kind,text5:v5->text,start5:v5->start,end5:v5->end,line5:v5->line,column5:v5->column,scalarStart5:v5->scalarStart,scalarEnd5:v5->scalarEnd,endLine5:v5->endLine,endColumn5:v5->endColumn,kind6:v6->kind,text6:v6->text,start6:v6->start,end6:v6->end,line6:v6->line,column6:v6->column,scalarStart6:v6->scalarStart,scalarEnd6:v6->scalarEnd,endLine6:v6->endLine,endColumn6:v6->endColumn,kind7:v7->kind,text7:v7->text,start7:v7->start,end7:v7->end,line7:v7->line,column7:v7->column,scalarStart7:v7->scalarStart,scalarEnd7:v7->scalarEnd,endLine7:v7->endLine,endColumn7:v7->endColumn,kind8:v8->kind,text8:v8->text,start8:v8->start,end8:v8->end,line8:v8->line,column8:v8->column,scalarStart8:v8->scalarStart,scalarEnd8:v8->scalarEnd,endLine8:v8->endLine,endColumn8:v8->endColumn,kind9:v9->kind,text9:v9->text,start9:v9->start,end9:v9->end,line9:v9->line,column9:v9->column,scalarStart9:v9->scalarStart,scalarEnd9:v9->scalarEnd,endLine9:v9->endLine,endColumn9:v9->endColumn,kind10:v10->kind,text10:v10->text,start10:v10->start,end10:v10->end,line10:v10->line,column10:v10->column,scalarStart10:v10->scalarStart,scalarEnd10:v10->scalarEnd,endLine10:v10->endLine,endColumn10:v10->endColumn,kind11:v11->kind,text11:v11->text,start11:v11->start,end11:v11->end,line11:v11->line,column11:v11->column,scalarStart11:v11->scalarStart,scalarEnd11:v11->scalarEnd,endLine11:v11->endLine,endColumn11:v11->endColumn,kind12:v12->kind,text12:v12->text,start12:v12->start,end12:v12->end,line12:v12->line,column12:v12->column,scalarStart12:v12->scalarStart,scalarEnd12:v12->scalarEnd,endLine12:v12->endLine,endColumn12:v12->endColumn,kind13:v13->kind,text13:v13->text,start13:v13->start,end13:v13->end,line13:v13->line,column13:v13->column,scalarStart13:v13->scalarStart,scalarEnd13:v13->scalarEnd,endLine13:v13->endLine,endColumn13:v13->endColumn,kind14:v14->kind,text14:v14->text,start14:v14->start,end14:v14->end,line14:v14->line,column14:v14->column,scalarStart14:v14->scalarStart,scalarEnd14:v14->scalarEnd,endLine14:v14->endLine,endColumn14:v14->endColumn,kind15:v15->kind,text15:v15->text,start15:v15->start,end15:v15->end,line15:v15->line,column15:v15->column,scalarStart15:v15->scalarStart,scalarEnd15:v15->scalarEnd,endLine15:v15->endLine,endColumn15:v15->endColumn}
};
public let addToken:Function(TokenStore,Lexeme):TokenStore=function(table:TokenStore,value:Lexeme):TokenStore{
 var pages:Paged<TokenPage>=table->pages;var tail:List<Lexeme>=table->tail;
 branch when{tail->length()==16=>{pages=push<TokenPage>(pages,packPage(tail));tail=List<Lexeme>[];},else=>unit};
 TokenStore{pages:pages,tail:tail->append(value),count:table->count+1}
};
public let getToken:Function(TokenStore,Int):Result<Lexeme,Diagnostic>=function(table:TokenStore,index:Int):Result<Lexeme,Diagnostic>{
 branch when{index<0||index>=table->count=>{return Result<Lexeme,Diagnostic>::Err(problem("internal",Span{start:0,end:0,line:1,column:1},"invalid token arena index"));},else=>unit};
 branch when{index/16==table->pages->count=>{return atList<Lexeme>(table->tail,index%16);},else=>unit};
 let page:TokenPage=try lookup<TokenPage>(table->pages,index/16);
 Result<Lexeme,Diagnostic>::Ok(readPage(page,index%16))
};
public let setToken:Function(TokenStore,Int,Lexeme):Result<TokenStore,Diagnostic>=function(table:TokenStore,index:Int,value:Lexeme):Result<TokenStore,Diagnostic>{
 let checked:Lexeme=try getToken(table,index);
 branch when{index/16==table->pages->count=>Result<TokenStore,Diagnostic>::Ok(TokenStore{pages:table->pages,tail:replaceList<Lexeme>(table->tail,index%16,value),count:table->count}),else=>{
 let previous:TokenPage=try lookup<TokenPage>(table->pages,index/16);
 let pages:Paged<TokenPage>=try replaceItem<TokenPage>(table->pages,index/16,writePage(previous,index%16,value));
 Result<TokenStore,Diagnostic>::Ok(TokenStore{pages:pages,tail:table->tail,count:table->count})
 }}
};
