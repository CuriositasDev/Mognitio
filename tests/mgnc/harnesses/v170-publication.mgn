namespace Mgnc;
use Mgnc\Data\{Paged,Span,Diagnostic,empty,lookup};
use Mgnc\InputData\{SourceUnit,ProjectInput,InputError};
use Mgnc\Semantic\{SemanticProject,analyze};
use Mgnc\WholePipeline\{prepare};
use Mgnc\WholePubMachine\{verify as publication};
use Mgnc\WholeNativeData\{Native,Global};
use Mgnc\WholeNativeEmit\{emit};
use Mgnc\WholeMachineCheck\{verify as machine};
use Mgnc\WholeHelpers\{Helper,registry};
use Mgnc\WholeHelperCheck\{verify as helpers};
use Mgnc\Machine\{Code,Record,flush};
use Mgnc\WholeChecks\{require};
use Mgnc\WholeStandardProof\{helper as standardProof};
use Mgnc\Tables\{replaceItem,atList};
use Mgnc\WholeLayout\{Layouts,Descriptor,argumentType};
use Mgnc\WholeLayoutCheck\{verify as layouts};
use Mgnc\TypeData\{Type};
use Mgnc\IntMap\{get};
use Std\Io\{writeStdout};
let reject:Function(Result<Unit,Diagnostic>,String):Result<Unit,Diagnostic>=function(result:Result<Unit,Diagnostic>,message:String):Result<Unit,Diagnostic>{
 let span:Span=Span{start:0,end:0,line:1,column:1};branch on result{Result<Unit,Diagnostic>::Ok(value:Unit)=>{try require(false,span,"accepted binary mutation");},Result<Unit,Diagnostic>::Err(error:Diagnostic)=>{try require(error->phase=="internal"&&error->message=="whole IR: "+message,span,"wrong binary detector: "+error->message);discard writeStdout("V170_PUBLICATION_MUTANT "+message+"\n");}};Result<Unit,Diagnostic>::Ok(unit)
};



let changed:Function(Code,Int,Record):Result<Code,Diagnostic>=function(code:Code,index:Int,item:Record):Result<Code,Diagnostic>{Result<Code,Diagnostic>::Ok(Code{records:try replaceItem<Record>(code->records,index,item),nextLabel:code->nextLabel,pending:code->pending})};
let test:Function():Result<Unit,Diagnostic>=function():Result<Unit,Diagnostic>{
 let span:Span=Span{start:0,end:0,line:1,column:1};let input:SourceUnit=SourceUnit{path:"publication.mgn",displayPath:"publication.mgn",relativePath:"publication.mgn",expectedNamespace:"",text:"namespace App;use Std\\Numeric\\{Bits};use Std\\Binary\\{bytesFromBits,publishFile,BinaryFileMode};let main:Function(List<String>):Int=function(args:List<String>):Int{discard publishFile(\"\",bytesFromBits(List<Bits<8>>[]),BinaryFileMode::Data);0};"};
 let semantic:SemanticProject=branch on analyze(ProjectInput{manifestPath:"",manifestText:"",rootNamespace:"",entry:0,sources:List<SourceUnit>[input]}){Result<SemanticProject,InputError>::Ok(value:SemanticProject)=>value,Result<SemanticProject,InputError>::Err(error:InputError)=>{return Result<Unit,Diagnostic>::Err(error->diagnostic);}};let plan:Native=try prepare(semantic);let code:Code=flush(try emit(plan));try machine(plan,code);
 var owner:Int= -1;var ordinal:Int=0;var seen:Int=0;
 loop over(code->records->pages->append(code->records->tail) as page:List<Record>){loop over(page as item:Record){
  branch when{item->kind==1&&item->target<256=>{owner=item->target;},else=>unit};
  var message:String="";var replacement:Record=item;var all:Bool=false;
  branch when{
   owner==75&&item->kind==3&&item->value==1624=>{message="publication frame and callee saves";replacement=Record{kind:item->kind,bytes:item->bytes,value:1616,target:item->target};},
   owner==75&&item->kind==4&&item->value==316=>{message="publication syscall sequence";replacement=Record{kind:item->kind,bytes:item->bytes,value:82,target:item->target};},
   owner==75&&item->kind==4&&item->value==1&&item->bytes->length()==2&&(try atList<Int>(item->bytes,0))==73&&(try atList<Int>(item->bytes,1))==184=>{message="publication same-parent no-replace ABI";replacement=Record{kind:item->kind,bytes:item->bytes,value:0,target:item->target};},
   owner==75&&item->kind==3&&item->value== -304=>{let following:Record=try lookup<Record>(code->records,ordinal+1);branch when{following->kind==3&&following->value== -448=>{message="publication same-parent no-replace ABI";replacement=Record{kind:item->kind,bytes:item->bytes,value: -296,target:item->target};},else=>unit};},
   owner==75&&item->kind==2&&item->target==80=>{message="publication releases uncleaned resources";replacement=Record{kind:item->kind,bytes:item->bytes,value:item->value,target:81};},
   owner==75&&item->kind==3&&item->value== -320=>{let following:Record=try lookup<Record>(code->records,ordinal+1);branch when{following->kind==3&&following->value==168=>{message="publication forged resource link";replacement=Record{kind:item->kind,bytes:item->bytes,value: -312,target:item->target};},else=>unit};},
   owner==75&&item->kind==3&&item->value== -88=>{let following:Record=try lookup<Record>(code->records,ordinal-1);branch when{following->kind==3&&following->value== -144=>{message="publication cleanup ownership";replacement=Record{kind:item->kind,bytes:item->bytes,value: -80,target:item->target};},else=>unit};},
   owner==80&&item->kind==4&&item->value==263=>{message="publication syscall sequence";replacement=Record{kind:item->kind,bytes:item->bytes,value:262,target:item->target};},
   owner==80&&item->kind==2&&item->target>=256=>{branch when{seen<12=>{message="publication cleanup allocates or recurses";replacement=Record{kind:item->kind,bytes:List<Int>[232],value:0,target:10};},else=>unit};},
   owner==81&&item->kind==4&&item->value==332=>{message="publication syscall sequence";replacement=Record{kind:item->kind,bytes:item->bytes,value:333,target:item->target};},
   owner==61&&item->kind==2&&item->target==80=>{message="publication cleanup dispatch count";replacement=Record{kind:item->kind,bytes:item->bytes,value:item->value,target:61};},
   owner==171&&item->kind==4&&item->value==127=>{message="publication helper bitmap";replacement=Record{kind:item->kind,bytes:item->bytes,value:63,target:item->target};all=true;},else=>unit};
  branch when{message!=""=>{let mutated:Code=try changed(code,ordinal,replacement);try reject(branch when{all=>machine(plan,mutated),else=>publication(plan,mutated)},message);seen=seen+1;},else=>unit};ordinal=ordinal+1;
 };};try require(seen>=12,span,"publication mutation count");
 Result<Unit,Diagnostic>::Ok(unit)
};
let main:Function(List<String>):Int=function(args:List<String>):Int{branch on test(){Result<Unit,Diagnostic>::Ok(value:Unit)=>{discard writeStdout("V170_PUBLICATION_IR_OK valid=1\n");0},Result<Unit,Diagnostic>::Err(error:Diagnostic)=>{discard writeStdout(error->phase+": "+error->message+"\n");1}}};
