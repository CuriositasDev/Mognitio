 Slot{lhs:47,rule:113,dot:0,next:46},
 Slot{lhs:47,rule:113,dot:1,next:-46},
 Slot{lhs:47,rule:113,dot:2,next:-3},
 Slot{lhs:47,rule:113,dot:3,next:22},
