namespace Mgnc\Buckets;
// Finite chart hash buckets; callers pass a nonnegative key modulo 16.
public type Buckets=product{b0:List<Int>;b1:List<Int>;b2:List<Int>;b3:List<Int>;b4:List<Int>;b5:List<Int>;b6:List<Int>;b7:List<Int>;b8:List<Int>;b9:List<Int>;b10:List<Int>;b11:List<Int>;b12:List<Int>;b13:List<Int>;b14:List<Int>;b15:List<Int>;};
public let blank:Function():Buckets=function():Buckets{Buckets{b0:List<Int>[],b1:List<Int>[],b2:List<Int>[],b3:List<Int>[],b4:List<Int>[],b5:List<Int>[],b6:List<Int>[],b7:List<Int>[],b8:List<Int>[],b9:List<Int>[],b10:List<Int>[],b11:List<Int>[],b12:List<Int>[],b13:List<Int>[],b14:List<Int>[],b15:List<Int>[]}};
public let bucket:Function(Buckets,Int):List<Int>=function(table:Buckets,index:Int):List<Int>{branch when{index==0=>table->b0,index==1=>table->b1,index==2=>table->b2,index==3=>table->b3,index==4=>table->b4,index==5=>table->b5,index==6=>table->b6,index==7=>table->b7,index==8=>table->b8,index==9=>table->b9,index==10=>table->b10,index==11=>table->b11,index==12=>table->b12,index==13=>table->b13,index==14=>table->b14,else=>table->b15}};
public let putBucket:Function(Buckets,Int,List<Int>):Buckets=function(table:Buckets,index:Int,value:List<Int>):Buckets{Buckets{b0:branch when{index==0=>value,else=>table->b0},b1:branch when{index==1=>value,else=>table->b1},b2:branch when{index==2=>value,else=>table->b2},b3:branch when{index==3=>value,else=>table->b3},b4:branch when{index==4=>value,else=>table->b4},b5:branch when{index==5=>value,else=>table->b5},b6:branch when{index==6=>value,else=>table->b6},b7:branch when{index==7=>value,else=>table->b7},b8:branch when{index==8=>value,else=>table->b8},b9:branch when{index==9=>value,else=>table->b9},b10:branch when{index==10=>value,else=>table->b10},b11:branch when{index==11=>value,else=>table->b11},b12:branch when{index==12=>value,else=>table->b12},b13:branch when{index==13=>value,else=>table->b13},b14:branch when{index==14=>value,else=>table->b14},b15:branch when{index==15=>value,else=>table->b15}}};
