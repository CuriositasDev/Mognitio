namespace Mgnc\Source;
use Mgnc\SourceData\{Site as StoredSite,Lexeme as StoredLexeme};
use Mgnc\TokenStorage\{TokenStore};
use Mgnc\Data\{Span,Paged,Diagnostic,problem};
public alias Site=StoredSite;
public alias Lexeme=StoredLexeme;
// Original scalar ranges retain huge literals without decoding or copying them.
public let location:Function(Lexeme):Span=function(token:Lexeme):Span{Span{start:token->start,end:token->end,line:token->line,column:token->column}};
public type Snapshot=product{text:String;tokens:TokenStore;end:Site;};
public let spelling:Function(Snapshot,Lexeme):Result<String,Diagnostic>=function(source:Snapshot,token:Lexeme):Result<String,Diagnostic>{
 branch on source->text->slice(token->scalarStart,token->scalarEnd){
  Result<String,SliceError>::Ok(value:String)=>Result<String,Diagnostic>::Ok(value),
  Result<String,SliceError>::Err(error:SliceError)=>Result<String,Diagnostic>::Err(problem("internal",location(token),"invalid source range")),
 }
};
