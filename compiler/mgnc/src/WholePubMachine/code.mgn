namespace Mgnc\WholePubMachine;
use Mgnc\Data\{Paged,Diagnostic,Span,empty,push,lookup};
use Mgnc\Machine\{Code,Record,flush};
use Mgnc\WholeNativeData\{Native,Global};
use Mgnc\WholeChecks\{require};
use Mgnc\Tables\{atList};
use Mgnc\IntMap\{Map,create,get,put};
type Region=product{start:Int;end:Int;bytes:List<Int>;};
let append:Function(List<Int>,List<Int>):List<Int>=function(left:List<Int>,right:List<Int>):List<Int>{var changed:List<Int>=left;loop over(right as value:Int){changed=changed->append(value);};changed};
let bytes:Function(Int,Int):List<Int>=function(value:Int,count:Int):List<Int>{var remaining:Int=value;var result:List<Int>=List<Int>[];var index:Int=0;loop while(index<count){let rem:Int=remaining%256;result=result->append(branch when{rem<0=>rem+256,else=>rem});remaining=remaining/256-branch when{rem<0=>1,else=>0};index=index+1;};result};
let same:Function(List<Int>,List<Int>):Bool=function(left:List<Int>,right:List<Int>):Bool{branch when{left->length()!=right->length()=>{return false;},else=>unit};var i:Int=0;loop over(left as value:Int){branch on right->at(i){Result<Int,IndexError>::Ok(other:Int)=>{branch when{value!=other=>{return false;},else=>unit};},Result<Int,IndexError>::Err(error:IndexError)=>{return false;}};i=i+1;};true};
let tail:Function(List<Int>,List<Int>):Bool=function(data:List<Int>,suffix:List<Int>):Bool{var candidate:List<Int>=List<Int>[];var index:Int=0;loop over(data as value:Int){branch when{index>=data->length()-suffix->length()=>{candidate=candidate->append(value);},else=>unit};index=index+1;};same(candidate,suffix)};
let occurrences:Function(List<Int>,List<Int>):Int=function(data:List<Int>,pattern:List<Int>):Int{var window:List<Int>=List<Int>[];var count:Int=0;loop over(data as value:Int){window=window->append(value);branch when{window->length()>pattern->length()=>{var changed:List<Int>=List<Int>[];var index:Int=0;loop over(window as octet:Int){branch when{index>0=>{changed=changed->append(octet);},else=>unit};index=index+1;};window=changed;},else=>unit};branch when{same(window,pattern)=>{count=count+1;},else=>unit};};count};
let region:Function(Code,Map,Int,Span):Result<Region,Diagnostic>=function(code:Code,labels:Map,id:Int,span:Span):Result<Region,Diagnostic>{let start:Int=try get(labels,id);try require(start>=0,span,"publication runtime entry");var cursor:Int=start+1;var data:List<Int>=List<Int>[];loop while(cursor<code->records->count){let record:Record=try lookup<Record>(code->records,cursor);branch when{record->kind==1&&record->target<256=>{break;},else=>unit};data=append(data,record->bytes);branch when{record->kind==2||record->kind==3=>{data=append(data,bytes(branch when{record->kind==3=>record->value,else=>0},4));},record->kind==4||record->kind==5=>{data=append(data,bytes(branch when{record->kind==4=>record->value,else=>0},8));},else=>unit};cursor=cursor+1;};Result<Region,Diagnostic>::Ok(Region{start:start+1,end:cursor,bytes:data})};
let syscalls:Function(Code,Region,List<Int>,Span):Result<Unit,Diagnostic>=function(code:Code,part:Region,expected:List<Int>,span:Span):Result<Unit,Diagnostic>{var found:List<Int>=List<Int>[];var cursor:Int=part->start;loop while(cursor<part->end){let record:Record=try lookup<Record>(code->records,cursor);branch when{record->kind==4&&same(record->bytes,List<Int>[72,184])=>{let next:Record=try lookup<Record>(code->records,cursor+1);branch when{next->bytes->length()>=2&&(try atList<Int>(next->bytes,0))==15&&(try atList<Int>(next->bytes,1))==5=>{found=found->append(record->value);},else=>unit};},else=>unit};cursor=cursor+1;};try require(same(found,expected),span,"publication syscall sequence");Result<Unit,Diagnostic>::Ok(unit)};
type State=product{pc:Int;ownership:Int;privateName:Int;};
let ownership:Function(Code,Map,Region,Span):Result<Unit,Diagnostic>=function(code:Code,labels:Map,part:Region,span:Span):Result<Unit,Diagnostic>{
 var queue:Paged<State>=push<State>(empty<State>(),State{pc:part->start,ownership:0,privateName:0});var cursor:Int=0;var seen:Map=create();
 loop while(cursor<queue->count){let state:State=try lookup<State>(queue,cursor);cursor=cursor+1;try require(state->pc>=part->start&&state->pc<part->end,span,"publication control escapes helper");let key:Int=(state->pc-part->start)*32+state->ownership*4+state->privateName;branch when{(try get(seen,key))>=0=>{continue;},else=>unit};seen=try put(seen,key,1);let record:Record=try lookup<Record>(code->records,state->pc);var owned:Int=state->ownership;var name:Int=state->privateName;
  branch when{record->kind==3&&record->value==168&&tail(record->bytes,List<Int>[73,137,135])=>{let previous:Record=try lookup<Record>(code->records,state->pc-1);branch when{previous->kind==3&&previous->value== -320&&tail(previous->bytes,List<Int>[72,141,133])=>{try require(owned==0,span,"publication duplicate ownership record");owned=1;},previous->kind==3&&previous->value== -320&&tail(previous->bytes,List<Int>[72,139,133])=>{try require(owned==2,span,"publication releases uncleaned resources");owned=3;},else=>{try require(false,span,"publication forged resource link");}};},record->kind==3&&record->value== -88&&tail(record->bytes,List<Int>[72,137,149])=>{try require(name==1,span,"publication private leaf handoff");name=2;},else=>unit};
  branch when{record->kind==2&&tail(record->bytes,List<Int>[232])=>{
   branch when{record->target==80=>{try require(owned==1&&name!=1,span,"publication cleanup ownership");owned=2;},record->target==10=>{branch when{owned==1=>{try require(name==0,span,"publication duplicate private allocation");let descriptor:Record=try lookup<Record>(code->records,state->pc-1);try require(descriptor->kind==4&&same(descriptor->bytes,List<Int>[72,190]),span,"publication private descriptor instruction");name=1;},else=>{try require(owned==3,span,"publication Result allocation before cleanup");}};},else=>{try require(record->target==60||record->target==81||record->target==82,span,"publication runtime call");}};
  },else=>unit};
  let returned:Bool=record->kind==0&&tail(record->bytes,List<Int>[65,95,65,94,65,93,65,92,91,93,195]);branch when{returned=>{try require(owned==3&&name!=1,span,"publication return retains resources");let restored:Record=try lookup<Record>(code->records,state->pc-1);try require(restored->kind==3&&restored->value==1624&&tail(restored->bytes,List<Int>[72,129,196]),span,"publication frame and callee saves");continue;},else=>unit};
  var fallthrough:Bool=true;branch when{record->kind==2&&!tail(record->bytes,List<Int>[232])=>{let unconditional:Bool=tail(record->bytes,List<Int>[233]);let condition:Bool=record->bytes->length()>=2&&(try atList<Int>(record->bytes,record->bytes->length()-2))==15;try require(unconditional||condition,span,"publication branch opcode");branch when{record->target<128=>{try require(record->target==1||record->target==2,span,"publication terminal target");},else=>{let target:Int=try get(labels,record->target);queue=push<State>(queue,State{pc:target,ownership:owned,privateName:name});}};fallthrough=!unconditional;},else=>unit};branch when{fallthrough=>{queue=push<State>(queue,State{pc:state->pc+1,ownership:owned,privateName:name});},else=>unit};
 };Result<Unit,Diagnostic>::Ok(unit)
};
// Decode result guards and their invariant-flag destinations independently.
let cleanupResults:Function(Code,Map,Region,Span):Result<Unit,Diagnostic>=function(code:Code,labels:Map,part:Region,span:Span):Result<Unit,Diagnostic>{
 var index:Int=part->start;var count:Int=0;loop while(index<part->end){let item:Record=try lookup<Record>(code->records,index);branch when{item->kind==4&&same(item->bytes,List<Int>[72,184])=>{let zero:Record=try lookup<Record>(code->records,index+1);branch when{zero->bytes->length()>=2&&(try atList<Int>(zero->bytes,0))==15&&(try atList<Int>(zero->bytes,1))==5=>{
  try require(index+13<part->end,span,"publication cleanup result extent");let negative:Record=try lookup<Record>(code->records,index+2);let invalid:Record=try lookup<Record>(code->records,index+3);let negativeLabel:Record=try lookup<Record>(code->records,index+4);let checkedLabel:Record=try lookup<Record>(code->records,index+13);
  try require(zero->kind==2&&same(zero->bytes,List<Int>[15,5,72,133,192,15,132])&&negative->kind==2&&same(negative->bytes,List<Int>[15,136])&&invalid->kind==2&&same(invalid->bytes,List<Int>[233])&&negativeLabel->kind==1&&negativeLabel->target==negative->target&&checkedLabel->kind==1&&checkedLabel->target==zero->target,span,"publication cleanup result branch");
  let bad:Int=invalid->target;var offset:Int=5;loop over(List<Int>[-4095,-9,-14,-22] as expected:Int){let compare:Record=try lookup<Record>(code->records,index+offset);let jump:Record=try lookup<Record>(code->records,index+offset+1);try require(compare->kind==3&&same(compare->bytes,List<Int>[72,129,248])&&compare->value==expected&&jump->kind==2&&jump->target==bad&&same(jump->bytes,branch when{offset==5=>List<Int>[15,140],else=>List<Int>[15,132]}),span,"publication cleanup errno domain");offset=offset+2;};
  let destination:Int=try get(labels,bad);try require(destination>part->start&&destination+2<part->end,span,"publication cleanup invariant destination");let flag:Record=try lookup<Record>(code->records,destination+1);let store:Record=try lookup<Record>(code->records,destination+2);try require(flag->kind==4&&flag->value==1&&store->kind==3&&store->value== -88&&((same(flag->bytes,List<Int>[72,184])&&same(store->bytes,List<Int>[72,137,133]))||(same(flag->bytes,List<Int>[72,185])&&same(store->bytes,List<Int>[72,137,141]))),span,"publication cleanup invariant flag");count=count+1;
 },else=>unit};},else=>unit};index=index+1;};try require(count==7,span,"publication cleanup result coverage");Result<Unit,Diagnostic>::Ok(unit)
};
public let verify:Function(Native,Code):Result<Unit,Diagnostic>=function(plan:Native,initial:Code):Result<Unit,Diagnostic>{
 let code:Code=flush(initial);let span:Span=Span{start:0,end:0,line:1,column:1};// Collect every actual relocation queried by these helper regions, including
 // a forged target outside its region, so rejection priority remains unchanged.
 var queriedLabels:Map=create();var indexingRegion:Bool=false;
 loop over(code->records->pages->append(code->records->tail) as records:List<Record>){loop over(records as record:Record){branch when{record->kind==1&&record->target<256=>{indexingRegion=record->target==61||record->target==75||record->target==80||record->target==81;},else=>unit};branch when{indexingRegion&&(record->kind==2||record->kind==5)&&record->target>=256=>{queriedLabels=try put(queriedLabels,record->target,1);},else=>unit};};};
 var labels:Map=create();var ordinal:Int=0;loop over(code->records->pages->append(code->records->tail) as page:List<Record>){loop over(page as record:Record){branch when{record->kind==1&&(record->target<256||(try get(queriedLabels,record->target))>=0)=>{labels=try put(labels,record->target,ordinal);},else=>unit};ordinal=ordinal+1;};};let cleanup:Region=try region(code,labels,80,span);try syscalls(code,cleanup,List<Int>[5,3,3,262,263,11,3],span);var index:Int=cleanup->start;loop while(index<cleanup->end){let record:Record=try lookup<Record>(code->records,index);branch when{record->kind==2=>{try require(!tail(record->bytes,List<Int>[232])&&record->target>=256,span,"publication cleanup allocates or recurses");},else=>unit};index=index+1;};
 try cleanupResults(code,labels,cleanup,span);
 let generic:Region=try region(code,labels,61,span);var tagged:Int=0;index=generic->start;loop while(index<generic->end){let record:Record=try lookup<Record>(code->records,index);branch when{record->kind==2&&record->target==80=>{let previous:Record=try lookup<Record>(code->records,index-1);try require(tail(record->bytes,List<Int>[15,132])&&previous->kind==3&&previous->value== -2&&same(previous->bytes,List<Int>[72,129,248]),span,"publication cleanup tag dispatch");tagged=tagged+1;},else=>unit};index=index+1;};try require(tagged==1,span,"publication cleanup dispatch count");
 var selected:Bool=false;loop over(plan->globals->pages->append(plan->globals->tail) as page:List<Global>){loop over(page as value:Global){branch when{value->standard=="publishFile"=>{selected=true;},else=>unit};};};branch when{!selected=>{return Result<Unit,Diagnostic>::Ok(unit);},else=>unit};
 let body:Region=try region(code,labels,75,span);try syscalls(code,body,List<Int>[257,262,11,318,257,5,91,5,1,3,316],span);let profile:Region=try region(code,labels,81,span);try syscalls(code,profile,List<Int>[138,332,63,257,0,3],span);
 var commit:List<Int>=append(List<Int>[72,139,189],bytes(-304,4));commit=append(commit,append(List<Int>[72,141,181],bytes(-448,4)));commit=append(commit,List<Int>[72,137,250]);commit=append(commit,append(List<Int>[76,139,149],bytes(-176,4)));commit=append(commit,append(List<Int>[73,184],bytes(1,8)));commit=append(commit,append(List<Int>[72,184],bytes(316,8)));commit=append(commit,List<Int>[15,5]);try require(occurrences(body->bytes,commit)==1,span,"publication same-parent no-replace ABI");
 let first:Record=try lookup<Record>(code->records,body->start);try require(first->kind==3&&first->value==1624&&same(first->bytes,List<Int>[85,72,137,229,83,65,84,65,85,65,86,65,87,72,129,236]),span,"publication frame and callee saves");try ownership(code,labels,body,span);Result<Unit,Diagnostic>::Ok(unit)
};
