public let ruleOnArmsMore:Int=154;
public let ruleOnArm:Int=155;
public let rulePatternEmpty:Int=156;
public let rulePatternPayload:Int=157;
public let ruleStatementAssert:Int=158;
public let ruleAttributedTop:Int=159;
public let ruleAttributesEnd:Int=160;
public let ruleAttributesMore:Int=161;
public let ruleAttributedCompile:Int=162;
public let ruleAttributedLet:Int=163;
public let ruleAttributedVar:Int=164;
public let ruleAttributedPublicCompile:Int=165;
public let ruleAttributedPublicLet:Int=166;
public let ruleAttributedPublicVar:Int=167;
public let ruleAttributedLocalLet:Int=168;
public let ruleAttributedLocalVar:Int=169;
public let closeTerminal:Int=-18;
public type Lookahead=product{ordinary:Int;extra:Int;high:Int;};
public let lookahead:Function(Lexeme,Lexeme):Lookahead=function(token:Lexeme,close:Lexeme):Lookahead{
 let ordinary:Int=branch when{
 token->kind==1=>4,
 token->kind==2=>8388608,
 token->kind==5=>70368744177664,
 token->text=="namespace"=>1,
 token->text==";"=>2,
 token->text=="\\"=>8,
 token->text=="use"=>16,
 token->text=="{"=>32,
 token->text=="}"=>64,
 token->text==","=>128,
 token->text=="as"=>256,
 token->text=="public"=>512,
 token->text=="type"=>1024,
 token->text=="="=>2048,
 token->text=="product"=>4096,
 token->text=="sum"=>8192,
 token->text=="alias"=>16384,
 token->text=="template"=>32768,
 token->text=="<"=>65536,
 token->text==":"=>262144,
 token->text=="("=>524288,
 token->text==")"=>1048576,
 token->text=="-"=>16777216,
 token->text=="let"=>33554432,
 token->text=="var"=>67108864,
 token->text=="function"=>134217728,
 token->text=="return"=>268435456,
 token->text=="discard"=>536870912,
 token->text=="break"=>1073741824,
 token->text=="continue"=>2147483648,
 token->text=="||"=>4294967296,
 token->text=="&&"=>8589934592,
 token->text=="<="=>17179869184,
 token->text==">"=>34359738368,
 token->text==">="=>68719476736,
 token->text=="=="=>137438953472,
 token->text=="!="=>274877906944,
 token->text=="+"=>549755813888,
 token->text=="*"=>1099511627776,
 token->text=="/"=>2199023255552,
 token->text=="%"=>4398046511104,
 token->text=="!"=>8796093022208,
 token->text=="try"=>17592186044416,
 token->text=="->"=>35184372088832,
 token->text=="true"=>140737488355328,
 token->text=="false"=>281474976710656,
 token->text=="unit"=>562949953421312,
 token->text=="loop"=>1125899906842624,
 token->text=="while"=>2251799813685248,
 token->text=="over"=>4503599627370496,
 token->text=="branch"=>9007199254740992,
 token->text=="when"=>18014398509481984,
 token->text=="else"=>36028797018963968,
 token->text=="=>"=>72057594037927936,
 token->text=="on"=>144115188075855872,
 token->text=="panic"=>288230376151711744,
 token->text=="["=>576460752303423488,
 token->text=="]"=>1152921504606846976,
 token->text=="::"=>2305843009213693952,
 else=>0,
 };
 let high:Int=branch when{
 token->text=="assert"=>1,
 token->text=="@"=>2,
 else=>0,
 };
 let extra:Int=branch when{token->kind==1=>branch when{token->text=="Function"=>4194304,else=>2097152},close->text==">"=>131072,else=>0};
 Lookahead{ordinary:ordinary,extra:extra,high:high}
};
public let possible:Function(Prediction,Lookahead):Bool=function(prediction:Prediction,ahead:Lookahead):Bool{
 prediction->nullable||(ahead->ordinary>0&&(prediction->first/ahead->ordinary)%2==1)||(ahead->extra>0&&(prediction->first/ahead->extra)%2==1)||(ahead->high>0&&(prediction->second/ahead->high)%2==1)
};
public let matches:Function(Int,Lexeme):Bool=function(symbol:Int,token:Lexeme):Bool{
 branch when{
  symbol==-1=>token->text=="namespace",
  symbol==-2=>token->text==";",
  symbol==-3=>token->kind==1,
  symbol==-4=>token->text=="\\",
  symbol==-5=>token->text=="use",
  symbol==-6=>token->text=="{",
  symbol==-7=>token->text=="}",
  symbol==-8=>token->text==",",
  symbol==-9=>token->text=="as",
  symbol==-10=>token->text=="public",
  symbol==-11=>token->text=="type",
  symbol==-12=>token->text=="=",
  symbol==-13=>token->text=="product",
  symbol==-14=>token->text=="sum",
  symbol==-15=>token->text=="alias",
  symbol==-16=>token->text=="template",
  symbol==-17=>token->text=="<",
  symbol==-18=>token->text==">",
  symbol==-19=>token->text==":",
  symbol==-20=>token->text=="(",
  symbol==-21=>token->text==")",
  symbol==-22=>token->kind==1&&token->text!="Function",
  symbol==-23=>token->kind==1&&token->text=="Function",
  symbol==-24=>token->kind==2,
  symbol==-25=>token->text=="-",
  symbol==-26=>token->text=="let",
  symbol==-27=>token->text=="var",
  symbol==-28=>token->text=="function",
  symbol==-29=>token->text=="return",
  symbol==-30=>token->text=="discard",
  symbol==-31=>token->text=="break",
  symbol==-32=>token->text=="continue",
  symbol==-33=>token->text=="||",
  symbol==-34=>token->text=="&&",
  symbol==-35=>token->text=="<=",
  symbol==-36=>token->text==">",
  symbol==-37=>token->text==">=",
  symbol==-38=>token->text=="==",
  symbol==-39=>token->text=="!=",
  symbol==-40=>token->text=="+",
  symbol==-41=>token->text=="*",
  symbol==-42=>token->text=="/",
  symbol==-43=>token->text=="%",
  symbol==-44=>token->text=="!",
  symbol==-45=>token->text=="try",
  symbol==-46=>token->text=="->",
  symbol==-47=>token->kind==5,
  symbol==-48=>token->text=="true",
  symbol==-49=>token->text=="false",
  symbol==-50=>token->text=="unit",
  symbol==-51=>token->text=="loop",
  symbol==-52=>token->text=="while",
  symbol==-53=>token->text=="over",
  symbol==-54=>token->text=="branch",
  symbol==-55=>token->text=="when",
  symbol==-56=>token->text=="else",
  symbol==-57=>token->text=="=>",
  symbol==-58=>token->text=="on",
  symbol==-59=>token->text=="panic",
  symbol==-60=>token->text=="[",
  symbol==-61=>token->text=="]",
  symbol==-62=>token->text=="::",
  symbol==-63=>token->text=="assert",
  symbol==-64=>token->text=="@",
  else=>false,
 }
};
