namespace Mgnc\TestTypePermutation;
use Mgnc\Data\{Paged,Diagnostic,Span,empty,push,lookup};
use Mgnc\Syntax\{Parent};
use Mgnc\TypeData\{Store,Type,Member,Argument,ValueTerm,Formed};
use Mgnc\TypeOps\{intern};
use Mgnc\WholeConcrete\{Plan,Instance,Key,Target};
use Mgnc\WholeDispatchData\{Pair};
use Mgnc\SemanticData\{Headers,Declaration,Evidence};
use Mgnc\WholeIR\{Body,Slot,Block,Operation,Terminator,TrySite};
use Mgnc\WholeSubstitution\{Binding};
use Mgnc\WholeChecks\{require};
use Mgnc\Tables\{replaceItem};
// The six primitive ABI identities are fixed; all allocated identities move.
public let mapped:Function(Int,Int):Int=function(id:Int,count:Int):Int{branch when{id<6=>id,else=>count+5-id}};
public let parent:Function(Parent,Int):Parent=function(value:Parent,count:Int):Parent{branch on value{Parent::None=>Parent::None,Parent::Some(id:Int)=>Parent::Some(mapped(id,count))}};
public let arguments:Function(List<Argument>,Int):List<Argument>=function(values:List<Argument>,count:Int):List<Argument>{var out:List<Argument>=List<Argument>[];loop over(values as value:Argument){out=out->append(branch on value{Argument::Type(id:Int)=>Argument::Type(mapped(id,count)),Argument::Value(term:ValueTerm)=>Argument::Value(term)});};out};
public let body:Function(Body,Int):Body=function(original:Body,count:Int):Body{var slots:Paged<Slot>=empty<Slot>();loop over(original->slots->pages->append(original->slots->tail) as page:List<Slot>){loop over(page as slot:Slot){slots=push<Slot>(slots,Slot{valueType:mapped(slot->valueType,count),kind:slot->kind,symbol:slot->symbol});};};var blocks:Paged<Block>=empty<Block>();loop over(original->blocks->pages->append(original->blocks->tail) as page:List<Block>){loop over(page as block:Block){var operations:List<Operation>=List<Operation>[];loop over(block->operations as op:Operation){let target:Parent=branch when{op->code=="dispatch"||op->code=="payload-box"||op->code=="sum-payload"||op->code=="iterator-init"||op->code=="variant"=>parent(op->target,count),else=>op->target};operations=operations->append(Operation{code:op->code,output:op->output,inputs:op->inputs,unavailable:op->unavailable,symbol:op->symbol,target:target,arguments:arguments(op->arguments,count),mapping:op->mapping,integer:op->integer,minimum:op->minimum,wide:op->wide,text:op->text,origin:op->origin});};let term:Terminator=block->terminator;blocks=push<Block>(blocks,Block{operations:operations,terminator:Terminator{code:term->code,inputs:term->inputs,targets:term->targets,variants:term->variants,sumType:parent(term->sumType,count),origin:term->origin}});};};var tries:List<TrySite>=List<TrySite>[];loop over(original->tries as site:TrySite){tries=tries->append(TrySite{node:site->node,owner:site->owner,operandType:mapped(site->operandType,count),returnType:mapped(site->returnType,count),errorType:mapped(site->errorType,count),dispatch:site->dispatch,ok:site->ok,err:site->err,payload:site->payload,returned:site->returned});};Body{declaration:original->declaration,functionOwner:original->functionOwner,root:original->root,resultType:mapped(original->resultType,count),slots:slots,blocks:blocks,parameters:original->parameters,captures:original->captures,entry:original->entry,occurrences:original->occurrences,tries:tries}};
let typeHash:Function(Type):Int=function(shape:Type):Int{
 var value:Int=shape->kind;value=(value*131+branch on shape->owner{Parent::None=>0,Parent::Some(owner:Int)=>owner%4093+1})%4093;
 loop over(shape->arguments as argument:Argument){
  branch on argument{
   Argument::Type(id:Int)=>{value=(value*131+id%4093+1)%4093;},
   Argument::Value(term:ValueTerm)=>{
    value=(value*131+7)%4093;
    branch on term->parameter{Parent::None=>{let reduced:Int=term->value%4093;value=(value*131+reduced+4093)%4093;},
     Parent::Some(ordinal:Int)=>{value=(value*131+term->owner%4093+1)%4093;value=(value*131+ordinal%4093+1)%4093;}};
   }
  };
 };value
};

public let permute:Function(Plan):Result<Plan,Diagnostic>=function(original:Plan):Result<Plan,Diagnostic>{let span:Span=Span{start:0,end:0,line:1,column:1};let store:Store=original->types;let count:Int=store->types->count;var types:Paged<Type>=empty<Type>();var newId:Int=0;loop while(newId<count){let value:Type=try lookup<Type>(store->types,mapped(newId,count));var members:List<Member>=List<Member>[];loop over(value->members as member:Member){members=members->append(Member{name:member->name,value:parent(member->value,count),span:member->span});};types=push<Type>(types,Type{kind:value->kind,owner:value->owner,arguments:arguments(value->arguments,count),members:members});newId=newId+1;};var declarations:Paged<Parent>=empty<Parent>();loop over(store->declarations->pages->append(store->declarations->tail) as page:List<Parent>){loop over(page as value:Parent){declarations=push<Parent>(declarations,parent(value,count));};};var buckets:Paged<List<Int>>=empty<List<Int>>();newId=0;loop while(newId<4093){buckets=push<List<Int>>(buckets,List<Int>[]);newId=newId+1;};newId=0;loop over(types->pages->append(types->tail) as page:List<Type>){loop over(page as value:Type){let key:Int=typeHash(value);let bucket:List<Int>=try lookup<List<Int>>(buckets,key);buckets=try replaceItem<List<Int>>(buckets,key,bucket->append(newId));newId=newId+1;};};var headerDeclarations:Paged<Declaration>=empty<Declaration>();loop over(store->headers->declarations->pages->append(store->headers->declarations->tail) as page:List<Declaration>){loop over(page as declaration:Declaration){var evidence:List<Evidence>=List<Evidence>[];loop over(declaration->evidence as proof:Evidence){evidence=evidence->append(Evidence{declaration:proof->declaration,concreteType:mapped(proof->concreteType,count),contractType:mapped(proof->contractType,count),methods:proof->methods});};headerDeclarations=push<Declaration>(headerDeclarations,Declaration{file:declaration->file,ordinal:declaration->ordinal,kind:declaration->kind,name:declaration->name,exported:declaration->exported,node:declaration->node,annotation:declaration->annotation,body:declaration->body,parameters:declaration->parameters,attributes:declaration->attributes,evidence:evidence,span:declaration->span});};};let headers:Headers=Headers{input:store->headers->input,modules:store->headers->modules,declarations:headerDeclarations,names:store->headers->names,fileNames:store->headers->fileNames,nameBuckets:store->headers->nameBuckets,order:store->headers->order};let changed:Store=Store{headers:headers,types:types,buckets:buckets,declarations:declarations,constraints:store->constraints};newId=0;loop over(types->pages->append(types->tail) as page:List<Type>){loop over(page as value:Type){let found:Formed=try intern(changed,value);try require(found->store->types->count==count&&found->value==newId,span,"permuted interner bucket coherence");newId=newId+1;};};var instances:Paged<Instance>=empty<Instance>();loop over(original->instances->pages->append(original->instances->tail) as page:List<Instance>){loop over(page as instance:Instance){var bindings:List<Binding>=List<Binding>[];loop over(instance->key->bindings as binding:Binding){bindings=bindings->append(Binding{owner:binding->owner,arguments:arguments(binding->arguments,count)});};instances=push<Instance>(instances,Instance{key:Key{body:instance->key->body,bindings:bindings},body:body(instance->body,count),targets:instance->targets});};};var pairs:Paged<Pair>=empty<Pair>();loop over(original->pairs->pages->append(original->pairs->tail) as page:List<Pair>){loop over(page as pair:Pair){var signatures:List<Int>=List<Int>[];loop over(pair->signatures as signature:Int){signatures=signatures->append(mapped(signature,count));};pairs=push<Pair>(pairs,Pair{implementation:pair->implementation,concreteType:mapped(pair->concreteType,count),contractType:mapped(pair->contractType,count),methods:pair->methods,signatures:signatures});};};Result<Plan,Diagnostic>::Ok(Plan{pairs:pairs,types:changed,instances:instances,initializers:original->initializers})};
public let reorder:Function(Plan):Result<Plan,Diagnostic>=function(original:Plan):Result<Plan,Diagnostic>{var instances:Paged<Instance>=empty<Instance>();var cursor:Int=original->instances->count;loop while(cursor>0){cursor=cursor-1;let instance:Instance=try lookup<Instance>(original->instances,cursor);var targets:Paged<Target>=empty<Target>();loop over(instance->targets->pages->append(instance->targets->tail) as page:List<Target>){loop over(page as target:Target){targets=push<Target>(targets,Target{node:target->node,instance:original->instances->count-1-target->instance});};};instances=push<Instance>(instances,Instance{key:instance->key,body:instance->body,targets:targets});};var initializers:List<Int>=List<Int>[];loop over(original->initializers as id:Int){initializers=initializers->append(original->instances->count-1-id);};var pairs:Paged<Pair>=empty<Pair>();cursor=original->pairs->count;loop while(cursor>0){cursor=cursor-1;let pair:Pair=try lookup<Pair>(original->pairs,cursor);var methods:List<Int>=List<Int>[];loop over(pair->methods as method:Int){methods=methods->append(original->instances->count-1-method);};pairs=push<Pair>(pairs,Pair{implementation:pair->implementation,concreteType:pair->concreteType,contractType:pair->contractType,methods:methods,signatures:pair->signatures});};Result<Plan,Diagnostic>::Ok(Plan{pairs:pairs,types:original->types,instances:instances,initializers:initializers})};
