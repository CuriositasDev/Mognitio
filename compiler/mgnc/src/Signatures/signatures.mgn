namespace Mgnc\Signatures;
use Mgnc\Data\{Diagnostic,Span,lookup,problem};
use Mgnc\Syntax\{Parent};
use Mgnc\DeclarationKinds\{runtimeDeclaration,compileDeclaration,typeDeclaration};
use Mgnc\SemanticData\{Module,Declaration};
use Mgnc\TypeData\{Store,Type,Member,Argument,Obligation,Formed,ValueTerm as MgncValueTerm};
use Mgnc\SemanticData\{Evidence};
use Mgnc\WitnessNames\{evidence};
use Mgnc\Grammar\{ruleWitnessMethod,ruleTypeName};
use Mgnc\NodeStorage\{getNode};
use Mgnc\TypeOps\{intern,functionKind,productKind,sumKind,parameterKind,bytesKind,identityKind,bitsKind,signedKind,unsignedKind,contractKind};
use Mgnc\TypeForm\{form};
use Mgnc\TypeDeclarations\{Parameters,parameters};
use Mgnc\Projection\{parts,item,text,site,concrete};
use Mgnc\HeaderRead\{rightList};
use Mgnc\Tables\{replaceItem};
use Mgnc\Forest\{SyntaxForest};
public type Formal=product{name:String;valueType:Int;span:Span;};
public type FunctionType=product{store:Store;value:Int;parameters:List<Formal>;result:Int;body:Int;obligations:List<Obligation>;};
public let functionType:Function(Store,Int,SyntaxForest,Int,Parent,List<Argument>):Result<FunctionType,Diagnostic>=function(initial:Store,file:Int,tree:SyntaxForest,node:Int,owner:Parent,arguments:List<Argument>):Result<FunctionType,Diagnostic>{
 var store:Store=initial;let fields:List<Int>=try parts(tree,node);let method:Bool=(try getNode(tree->nodes,node))->rule==ruleWitnessMethod;
 let params:List<Int>=try rightList(tree,try item(fields,2));var formals:List<Formal>=List<Formal>[];
 var types:List<Argument>=List<Argument>[];var obligations:List<Obligation>=List<Obligation>[];var ordinal:Int=0;
 loop over(params as param:Int){
  let values:List<Int>=try parts(tree,param);let name:Int=try item(values,0);
  let annotation:Int=try concrete(tree,try item(values,2));let self:Bool=method&&ordinal==0&&(try getNode(tree->nodes,annotation))->rule==ruleTypeName&&(try text(tree,annotation))=="Self";
  let formed:Formed=branch when{self=>{
   let id:Int=branch on owner{Parent::Some(value:Int)=>value,Parent::None=>{return Result<FunctionType,Diagnostic>::Err(problem("internal",try site(tree,name),"method receiver owner missing"));}};
   let proof:Evidence=try evidence(store->headers,id);Formed{store:store,value:proof->concreteType,obligations:List<Obligation>[]}
  },else=>try form(store,file,tree,annotation,owner,arguments)};store=formed->store;
  types=types->append(Argument::Type(formed->value));formals=formals->append(Formal{name:try text(tree,name),valueType:formed->value,span:try site(tree,name)});ordinal=ordinal+1;
  loop over(formed->obligations as requirement:Obligation){obligations=obligations->append(requirement);};
 };
 let result:Formed=try form(store,file,tree,try item(fields,5),owner,arguments);store=result->store;
 loop over(result->obligations as requirement:Obligation){obligations=obligations->append(requirement);};
 let formed:Formed=try intern(store,Type{kind:functionKind,owner:Parent::None,arguments:types->append(Argument::Type(result->value)),members:List<Member>[]});
 Result<FunctionType,Diagnostic>::Ok(FunctionType{store:formed->store,value:formed->value,parameters:formals,result:result->value,body:try item(fields,6),obligations:obligations})
};
public let declaration:Function(Store,Int):Result<Store,Diagnostic>=function(initial:Store,id:Int):Result<Store,Diagnostic>{
 let declared:Declaration=try lookup<Declaration>(initial->headers->declarations,id);let module:Module=try lookup<Module>(initial->headers->modules,declared->file);
 var store:Store=initial;var value:Int=0;var obligations:List<Obligation>=List<Obligation>[];
 branch when{declared->kind==3=>{
  let generic:Parameters=try parameters(store,id);store=generic->store;
  let signature:FunctionType=try functionType(store,declared->file,module->tree,declared->body,Parent::Some(id),generic->arguments);
  store=signature->store;value=signature->value;obligations=signature->obligations;
 },runtimeDeclaration(declared->kind)=>{
  let formed:Formed=try form(store,declared->file,module->tree,declared->annotation,Parent::None,List<Argument>[]);
  store=formed->store;value=formed->value;obligations=formed->obligations;
 },declared->kind==7=>{value=0;},else=>{return Result<Store,Diagnostic>::Ok(store);}};
 Result<Store,Diagnostic>::Ok(Store{headers:store->headers,types:store->types,buckets:store->buckets,
 declarations:try replaceItem<Parent>(store->declarations,id,Parent::Some(value)),
 constraints:try replaceItem<List<Obligation>>(store->constraints,id,obligations)})
};
public let publicSignature:Function(Store,Int):Result<Unit,Diagnostic>=function(store:Store,id:Int):Result<Unit,Diagnostic>{
 let declared:Declaration=try lookup<Declaration>(store->headers->declarations,id);
 branch when{!declared->exported=>{return Result<Unit,Diagnostic>::Ok(unit);},else=>unit};
 let root:Int=branch on try lookup<Parent>(store->declarations,id){Parent::Some(value:Int)=>value,Parent::None=>{return Result<Unit,Diagnostic>::Err(problem("internal",declared->span,"public signature is incomplete"));}};
 var work:List<Int>=List<Int>[root];branch when{declared->kind==7=>{let proof:Evidence=try evidence(store->headers,id);work=List<Int>[proof->concreteType,proof->contractType];},else=>unit};var seen:List<Int>=List<Int>[];var index:Int=0;
 loop while(index<work->length()){
  let current:Int=try item(work,index);index=index+1;var visited:Bool=false;loop over(seen as previous:Int){branch when{previous==current=>{visited=true;break;},else=>unit};};
  branch when{visited=>{continue;},else=>unit};seen=seen->append(current);
  let shape:Type=try lookup<Type>(store->types,current);
  branch when{shape->kind==productKind||shape->kind==sumKind||shape->kind==bytesKind||shape->kind==identityKind||shape->kind==bitsKind||shape->kind==signedKind||shape->kind==unsignedKind||shape->kind==contractKind=>{
   branch on shape->owner{Parent::None=>unit,Parent::Some(owner:Int)=>{
    let nominal:Declaration=try lookup<Declaration>(store->headers->declarations,owner);
    branch when{!nominal->exported=>{return Result<Unit,Diagnostic>::Err(problem("semantic",declared->span,"public signature exposes a private nominal type"));},else=>unit};
   }};
  },else=>unit};
  loop over(shape->arguments as argument:Argument){branch on argument{Argument::Type(value:Int)=>{work=work->append(value);},Argument::Value(value:MgncValueTerm)=>unit};};
  loop over(shape->members as member:Member){branch on member->value{Parent::Some(value:Int)=>{work=work->append(value);},Parent::None=>unit};};
 };
 Result<Unit,Diagnostic>::Ok(unit)
};
