namespace Mgnc\SuiteStartup;
use Std\Numeric\{Bits};
use Mgnc\Data\{Diagnostic,empty};
use Mgnc\Machine\{Code,label,jump,fresh,field,raw};
use Mgnc\WholeX64\{immediate,store,load,constant,push,indirect,mov,symbol,alu};
use Mgnc\WholeNativeData\{Native};
use Mgnc\WholeNativeStartup\{entryStack,acquireContext,standardValues,initialize};
use Mgnc\WholeFrameData\{Frame,Point};
use Mgnc\WholeFrame\{begin,select};
use Mgnc\WholeABI\{globalBase};
use Mgnc\SuitePlan\{Suite,Entry};
use Mgnc\SuiteMachine\{offset,selectCase,stage,event,stop};
public let emit:Function(Code,Native,Suite):Result<Code,Diagnostic>=function(initial:Code,plan:Native,suite:Suite):Result<Code,Diagnostic>{
 let base:Int=offset(plan);var code:Code=entryStack(initial,false);
 // The gate and initialization event must precede even the first allocation.
 // Until mmap succeeds, R15 points to four protocol words on the process stack.
 code=constant(code,5,4,32);code=mov(code,15,4);code=immediate(code,0,0);
 loop over(List<Int>[8,16,24] as word:Int){code=store(code,15,word,0);};
 // Protect private writes before the runtime installs its signal dispositions.
 code=immediate(code,0,1);code=store(code,15,0,0);code=immediate(code,0,13);code=immediate(code,7,13);
 code=mov(code,6,15);code=immediate(code,2,0);code=immediate(code,10,8);code=raw(code,List<Int>[15,5]);
 let guarded:Int=code->nextLabel;code=fresh(code,1);code=alu(code,133,0,0);code=jump(code,List<Int>[15,132],guarded);
 code=stop(code,123);code=label(code,guarded);code=selectCase(code,0,suite->entries->count);
 let failed:Int=code->nextLabel;let prepared:Int=failed+1;code=fresh(code,2);
 code=try acquireContext(code,plan,32,failed);
 loop over(List<Int>[0,8,16,24] as word:Int){
  code=load(code,0,4,word);code=store(code,15,base+word,0);
 };
 code=constant(code,0,4,32);code=jump(code,List<Int>[233],prepared);
 code=label(code,failed);code=symbol(code,7,151);code=immediate(code,6,34);
 code=jump(code,List<Int>[232],65);code=event(code,0,3,9);code=stop(code,4);
 code=label(code,prepared);
 code=immediate(code,0,0);code=push(code,0);
 let frame:Frame=Frame{slots:3,outgoing:8,extent:160,entry:List<Bits<64>>[Bits<64>{1}],points:empty<Point>()};
 code=try begin(code,frame,List<Int>[],List<Int>[],131);code=try standardValues(code,plan);
 let done:Int=code->nextLabel;code=fresh(code,1);
 loop over(suite->entries->pages->append(suite->entries->tail) as page:List<Entry>){loop over(page as entry:Entry){
  let next:Int=code->nextLabel;code=fresh(code,1);code=load(code,0,15,base);code=constant(code,7,0,entry->test->ordinal);code=jump(code,List<Int>[15,133],next);
  code=try initialize(code,plan,entry->init->modules,entry->init->initializers);code=stage(code,base,2);
  code=load(code,2,15,globalBase);code=load(code,0,2,entry->cell*8);code=store(code,5,-88,0);code=select(code,133);
  code=load(code,0,5,-88);code=load(code,11,0,24);code=load(code,2,0,32);code=store(code,4,0,2);
  code=immediate(code,0,0);code=store(code,4,8,0);code=indirect(code,11,true);code=jump(code,List<Int>[233],done);code=label(code,next);
 };};code=stop(code,123);code=label(code,done);code=event(code,base,3,0);code=stop(code,0);
 loop over(List<Int>[131,132,133] as bitmap:Int){code=label(code,bitmap);code=field(code,4,3);code=field(code,4,branch when{bitmap==131=>1,bitmap==132=>3,else=>5});};
 Result<Code,Diagnostic>::Ok(code)
};
