namespace App;template make<T>=function(value:T):Function():Function():T{function():Function():T{function():T{value}}};let main:Function(List<String>):Int=function(args:List<String>):Int{let a:Function():Int=make<Int>(7)();let b:Function():String=make<String>("kept"+" text")();let c:Function():Int=make<Int>(9)();var n:Int=0;loop while(n<32){discard "temporary"+" value";n=n+1;};branch when{a()==7&&b()=="kept text"&&c()==9=>0,else=>1}};
