(in-package #:mognitio.native.runtime)

(defun inspection-kind-forms (type slot count prefix target)
  (loop for kind below count append
    (let ((next (intern (format nil "~A-~D" prefix kind) :keyword)))
      (append `((:load-frame :rax ,slot) (:cmp-imm :rax ,kind) (:jnz ,next))
        (allocate-object next (list :descriptor (second type) kind) 2 0 kind)
        `((:store-frame -24 :rdx) (:jmp ,target) (:label ,next))))))

(defun path-inspection-unit (instruction context)
  (let* ((result (mognitio.ir:instruction-type instruction))
         (parts (mognitio.semantic::canonical-result-arguments context result))
         (info (first parts)) (error (second parts))
         (kind (cdar (mognitio.semantic:type-info-fields (mognitio.semantic:context-type context info))))
         (error-kind (cdar (mognitio.semantic:type-info-fields (mognitio.semantic:context-type context error))))
         (fault (option :inspection-stat-fault)) (cleanup-fault (option :inspection-cleanup-fault)))
    (dolist (value (list fault cleanup-fault))
      (when (and value (not (typep value '(integer -4095 -1))))
        (internal-error "Invalid inspection fault option")))
    (when (eql fault -4) (internal-error "A persistent EINTR fault cannot complete"))
    (runtime-unit (second (value-helper-name instruction))
      (append (helper-frame 56) (helper-root-link 4)
        ;; Same ownership record as stream I/O, but no descriptor is acquired.
        '((:load-word :rax :r15 272) (:store-frame -128 :rax)
          (:lea-base :rax :rbp -128) (:store-word :r15 272 :rax)
          (:imm-rax -1) (:store-frame -120 :rax) (:store-frame -64 :rax)
          (:load-frame :rax 16) (:store-frame -8 :rax)
          (:load-word :rcx :rax 16) (:test-rcx) (:jz :invalid-path)
          (:store-frame -72 :rcx) (:lea-base :rsi :rax 32)
          (:label :validate-path) (:load-byte :rax :rsi 0) (:test) (:jz :invalid-path)
          (:add-imm :rsi 1) (:dec-rcx) (:jnz :validate-path)
          (:load-frame :rax -72) (:add-imm :rax 1) (:jo :allocation-failed)
          (:store-frame -72 :rax) (:store-out 0 :rax) (:call (:runtime :io.map)) (:store-frame -80 :rax)
          (:mov-reg :rdi :rax) (:load-frame :rsi -8) (:load-word :rcx :rsi 16) (:add-imm :rsi 32))
        (copy-forms :inspection-path-copy)
        '((:label :strip-slash) (:load-frame :rax -80) (:sub-reg :rdi :rax)
          (:cmp-imm :rdi 1) (:jbe :path-ready) (:add-reg :rdi :rax)
          (:load-byte :rcx :rdi -1) (:cmp-imm :rcx 47) (:jnz :terminate-path)
          (:add-imm :rdi -1) (:jmp :strip-slash)
          (:label :path-ready) (:add-reg :rdi :rax)
          (:label :terminate-path) (:imm-rax 0) (:store-byte :rdi 0 :rax)
          (:label :observe) (:imm-reg :rdi -100) (:load-frame :rsi -80) (:lea-base :rdx :rbp -320)
          (:mov-r10d 256) (:mov-eax 262) (:syscall))
        (when fault `((:imm-rax ,fault)))
        '((:cmp-eintr) (:jz :observe) (:store-frame -56 :rax) (:test) (:js :cleanup)
          (:load-frame :rax -296) (:and-imm :rax 61440) (:imm-rcx 0) (:cmp-imm :rax 32768) (:jz :kind-ready)
          (:imm-rcx 1) (:cmp-imm :rax 16384) (:jz :kind-ready)
          (:imm-rcx 2) (:cmp-imm :rax 40960) (:jz :kind-ready) (:imm-rcx 3)
          (:label :kind-ready) (:store-frame -160 :rcx) (:jmp :cleanup)
          (:label :invalid-path) (:imm-rax 0) (:store-frame -64 :rax)
          (:label :cleanup) (:lea-base :rax :rbp -128) (:store-out 0 :rax) (:call (:runtime :io.cleanup)))
        (when cleanup-fault `((:imm-rax ,cleanup-fault)))
        '((:store-frame -168 :rdx) (:test) (:jz :cleaned)
          (:load-frame :rcx -56) (:test-rcx) (:jnz :cleaned)
          (:load-frame :rcx -64) (:cmp-imm :rcx -1) (:jnz :cleaned) (:store-frame -56 :rax)
          (:label :cleaned) (:load-frame :rax -128) (:store-word :r15 272 :rax)
          (:load-frame :rax -168) (:test) (:jnz (:runtime :directory.internal))
          (:load-frame :rax -64) (:cmp-imm :rax -1) (:jnz :error-kind)
          (:load-frame :rax -56) (:test) (:jz :ok)
          (:cmp-imm :rax -4095) (:jb (:runtime :directory.internal)))
        (loop for errno in '(9 14 22) append `((:cmp-imm :rax ,(- errno)) (:jz (:runtime :directory.internal))))
        (loop for (number . errors) in '((0 36) (2 2) (3 1 13) (4 20 95) (6 12 23 24 28 122))
              append (loop for errno in errors append
                       `((:cmp-imm :rax ,(- errno)) (:jz ,(intern (format nil "ERRNO-~D" number) :keyword)))))
        '((:imm-rax 7) (:jmp :error-kind))
        (loop for number in '(0 2 3 4 6) append
          `((:label ,(intern (format nil "ERRNO-~D" number) :keyword)) (:imm-rax ,number) (:jmp :error-kind)))
        '((:label :error-kind) (:store-frame -64 :rax))
        (inspection-kind-forms error-kind -64 8 :error-kind :error-value)
        '((:jmp (:runtime :directory.internal)) (:label :error-value))
        (allocate-object :error (list :descriptor (second error) 0) 1 2)
        '((:load-frame :rax -24) (:store-word :rdx 32 :rax)
          (:load-frame :rax -8) (:store-word :rdx 40 :rax) (:store-frame -32 :rdx))
        (result-construction :err result 1 -32)
        '((:jmp :done) (:label :ok))
        (allocate-object :identity (layout-name '(:file-identity)) 1 2)
        '((:load-frame :rax -320) (:store-word :rdx 32 :rax)
          (:load-frame :rax -312) (:store-word :rdx 40 :rax) (:store-frame -16 :rdx))
        (inspection-kind-forms kind -160 4 :entry-kind :info-value)
        '((:jmp (:runtime :directory.internal)) (:label :info-value))
        (allocate-object :info (list :descriptor (second info) 0) 1 2)
        '((:load-frame :rax -24) (:store-word :rdx 32 :rax)
          (:load-frame :rax -16) (:store-word :rdx 40 :rax) (:store-frame -32 :rdx))
        (result-construction :ok result 0 -32)
        '((:label :done)) (helper-root-unlink 4) (helper-return)) :helper)))

(defun file-identity-equality-forms (op)
  (append
    '((:load-frame :rsi 16) (:load-frame :rdi 24)
      (:load-word :rax :rsi 32) (:load-word :rcx :rdi 32) (:cmp) (:jnz :different)
      (:load-word :rax :rsi 40) (:load-word :rcx :rdi 40) (:cmp) (:jnz :different))
    `((:imm-rax ,(if (eq op :file-identity.equal) 1 0)) (:jmp :done)
      (:label :different) (:imm-rax ,(if (eq op :file-identity.equal) 0 1)) (:label :done))))
(defun file-identity-equality-unit (instruction)
  (runtime-unit (second (value-helper-name instruction))
    (append (helper-frame 2) (file-identity-equality-forms (mognitio.ir:instruction-op instruction))
            (helper-return)) :helper))
