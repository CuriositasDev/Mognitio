namespace Mgnc\WholeNativeScalar;
use Mgnc\Data\{Diagnostic};
use Mgnc\WholeIR\{Operation};
use Mgnc\Machine\{Code};
use Mgnc\WholeX64\{alu,constant,condition};
use Mgnc\WholeChecks\{require};

// Boolean and Unit values use direct machine words.
public let emit:Function(Code,Operation):Result<Code,Diagnostic>=function(initial:Code,op:Operation):Result<Code,Diagnostic>{
 let name:String=op->code;
 branch when{name=="not"=>{return Result<Code,Diagnostic>::Ok(constant(initial,6,0,1));},else=>unit};
 try require(name=="eq"||name=="ne"||name=="lt"||name=="le"||name=="gt"||name=="ge",op->origin->span,"unknown scalar comparison");
 let comparison:Int=branch when{name=="eq"=>4,name=="ne"=>5,name=="lt"=>12,name=="le"=>14,name=="gt"=>15,else=>13};
 Result<Code,Diagnostic>::Ok(condition(alu(initial,57,0,1),comparison,0))
};
